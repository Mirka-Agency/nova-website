                    <circle cx="24.5" cy="13.3" r=".8" fill="currentColor" stroke="none"/>
                  </svg>
                }
              </span>
              <h3 class="service-card__title">@item.Title</h3>
              <p class="service-card__text">@excerpt</p>
              <a class="service-card__link" asp-controller="Services" asp-action="Details" asp-route-slug="@item.Slug">جزئیات خدمت</a>
            </article>
          </div>
        serviceIndex++;
    }
}
else
