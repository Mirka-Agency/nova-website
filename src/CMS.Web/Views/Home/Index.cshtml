@model HomeIndexViewModel
@using System.Globalization
@using CMS.Application.Settings
@using CMS.Modules.News.Application.Articles
@using CMS.Modules.Services.Application.ServiceItems
@using CMS.Modules.Team.Application.TeamItems
@using CMS.Modules.Voices.Application.VoiceItems
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = "خانه";
    ViewData["NavActive"] = "home";
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var brand = contact.Brand;
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var contactEmail = contact.Email;
    var address = contact.Address;
    var businessHours = contact.BusinessHours;
    var heroLead = "اولین و تنها فلوشیپ جراحی غدد ایران، با بهره‌گیری از جدیدترین تکنولوژی‌های روز دنیا در سال 2026، آماده ارائه خدمات پیشرفته و تخصصی به بیماران می‌باشد. این مرکز با تکیه بر دانش روز پزشکی، تجهیزات پیشرفته و تیمی مجرب از متخصصان، تلاش می‌کند تا بهترین نتایج درمانی را برای بیماران خود فراهم کند. هدف ما ارائه روش‌های نوین جراحی، کاهش عوارض و بهبود کیفیت زندگی بیماران است.";
    var services = Model?.Services ?? Array.Empty<PublicServiceItemSummaryDto>();
    // Dr. Hamedani first (default selected tab); others keep relative order after him.
    var team = (Model?.Team ?? Array.Empty<PublicTeamItemSummaryDto>())
        .OrderBy(m =>
            (m.Slug?.Contains("hamedani", StringComparison.OrdinalIgnoreCase) == true
             || (m.Title?.Contains("همدانی", StringComparison.Ordinal) == true))
                ? 0
                : 1)
        .ToList();
    var articles = Model?.Articles ?? Array.Empty<PublicArticleSummaryDto>();
    var voices = Model?.Voices ?? Array.Empty<PublicVoiceItemDto>();
    var hasCmsServices = services.Count > 0;
    var hasCmsTeam = team.Count > 0;
    var hasCmsArticles = articles.Count > 0;
    var hasCmsVoices = voices.Count > 0;
    var fa = CultureInfo.GetCultureInfo("fa-IR");
    var fallbackDoctorCover = Url.Content("~/template/assets/images/doctors/dr-hamedani-portrait.webp");
    var fallbackArticleCover = Url.Content("~/template/assets/images/articles/scientific-reports.jpg");
}
<!-- Hero -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="container hero-section__inner">
        <div class="hero-grid">
          <div class="hero-panel">
            <p class="hero-brand-name hero-reveal">@brand</p>
            <h1 class="hero-title hero-reveal hero-reveal--delay" id="hero-title">
              اولین کلینیک فلوشیپ جراحی غدد درون‌ریز ایران
            </h1>
            <p class="hero-text hero-reveal hero-reveal--delay-2">
              @heroLead
            </p>

            <div class="hero-actions hero-reveal hero-reveal--delay-2">
              <a class="btn-primary-custom" href="@telHref">
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </span>
                <span class="phone-ltr">@phoneDisplay</span>
              </a>
              <a class="btn-secondary-custom" href="#contact">
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                </span>
                درخواست مشاوره رایگان
              </a>
            </div>

            <p class="hero-note hero-reveal hero-reveal--delay-2">
              <span class="ui-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </span>
              مدیریت نووا کلینیک دکتر کاوه همدانی · نظام پزشکی ۱۱۰۶۱۴
            </p>
          </div>

          <div class="hero-media hero-reveal hero-reveal--delay" data-hero-video>
            <video
              class="hero-media__video"
              poster="~/template/assets/images/home/cover-hero.png"
              preload="metadata"
              playsinline
              controlslist="nodownload noplaybackrate"
              aria-label="ویدیوی معرفی نووا کلینیک"
            >
              <source src="~/template/assets/videos/hero.mp4" type="video/mp4">
            </video>
            <button class="hero-media__play" type="button" aria-label="پخش ویدیو" data-hero-video-play>
              <span class="hero-media__play-ring" aria-hidden="true"></span>
              <span class="hero-media__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">
                  <path d="M9 6.2v11.6L18.8 12 9 6.2z"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="trust-section" aria-label="ویژگی‌های کلینیک">
      <div class="container">
        <ul class="trust-list">
          <li class="trust-item">
            <span class="trust-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="5"/>
                <path d="m8.8 12-1.3 9 4.5-2.7 4.5 2.7-1.3-9"/>
                <path d="m12 5.7.7 1.4 1.6.2-1.2 1.1.3 1.6-1.4-.8-1.4.8.3-1.6-1.2-1.1 1.6-.2.7-1.4z"/>
              </svg>
            </span>
            <div class="trust-item__body">
              <span class="trust-item__label">فلوشیپ جراحی غدد</span>
              <span class="trust-item__hint">اولین مرکز تخصصی در ایران</span>
            </div>
          </li>
          <li class="trust-item">
            <span class="trust-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="7"/>
                <circle cx="12" cy="12" r="2.5"/>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
              </svg>
            </span>
            <div class="trust-item__body">
              <span class="trust-item__label">روش‌های کم‌تهاجمی</span>
              <span class="trust-item__hint">از جمله جراحی بدون جای زخم</span>
            </div>
          </li>
          <li class="trust-item">
            <span class="trust-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 9.4c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10A4.4 4.4 0 0 1 12 8a4.4 4.4 0 0 1 8.8 1.4z"/>
                <path d="M7.2 12h2.3l1.2-2.4 2.2 5 1.2-2.6h2.7"/>
              </svg>
            </span>
            <div class="trust-item__body">
              <span class="trust-item__label">مراقبت پس از درمان</span>
              <span class="trust-item__hint">پیگیری تخصصی و همراهی بیمار</span>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Intro -->
    <section class="intro-section" id="about" aria-labelledby="intro-heading">
      <div class="container">
        <div class="row align-items-center g-4 g-xl-5">
          <div class="col-lg-5 reveal">
            <div class="intro-media">
              <img
                src="~/template/assets/images/doctors/dr-hamedani.webp"
                width="1200"
                height="675"
                alt="تیم تخصصی نووا کلینیک"
                loading="lazy"
              >
            </div>
          </div>
          <div class="col-lg-7 reveal">
            <div class="intro-content">
              <p class="section-kicker">درباره نووا</p>
              <h2 class="section-heading" id="intro-heading"><span class="intro-heading__line">درمان تخصصی بیماری‌های</span> <span class="intro-heading__line">غدد درون‌ریز</span></h2>
              <p>
                غدد درون‌ریز نقش حیاتی در تنظیم عملکرد بدن دارند و اختلال در این سیستم می‌تواند سلامت کلی فرد را تحت تأثیر قرار دهد.
              </p>
              <p>
                در نووا کلینیک، با بهره‌گیری از روش‌های تشخیصی و درمانی روز، به درمان بیماری‌های تیروئید، پاراتیروئید، آدرنال و سایر اختلالات مرتبط می‌پردازیم؛ با هدف درمان دقیق، کاهش عوارض و بهبود کیفیت زندگی بیماران.
              </p>
              <a class="btn-primary-custom" asp-controller="Services" asp-action="Index">
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                    <rect x="9" y="3" width="6" height="4" rx="1"/>
                    <path d="M9 12h6M9 16h4"/>
                  </svg>
                </span>
                مشاهده خدمات
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="services-section" id="services" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-kicker">خدمات</p>
          <h2 class="section-heading" id="services-heading">خدمات تخصصی</h2>
          <p class="section-lead">
            تمرکز ما بر جراحی‌های تخصصی غدد درون‌ریز است؛ با انتخاب روش مناسب بر اساس شرایط هر بیمار.
          </p>
        </div>

        <div class="row g-3 g-lg-4">
@if (hasCmsServices)
{
    var serviceIndex = 0;
