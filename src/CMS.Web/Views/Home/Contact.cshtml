@using CMS.Application.Settings
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = "تماس با ما";
    ViewData["NavActive"] = "contact";
    var contact = SiteContactInfo.From(await SiteSettings.GetAsync());
    var brand = contact.Brand;
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var email = contact.Email;
    var addressShort = contact.Address;
    var addressFull = contact.Address;
    var addressExact = contact.Address;
    var mapQuery = contact.HasAddress ? Uri.EscapeDataString(addressFull!) : null;
    var mapEmbedSrc = mapQuery is null ? null : $"https://maps.google.com/maps?q={mapQuery}&hl=fa&z=16&output=embed";
    var directionsHref = mapQuery is null ? null : $"https://www.google.com/maps/dir/?api=1&destination={mapQuery}";
    var hasContactForm = ViewBag.HasContactForm as bool? == true;
    var asideIntro = contact.HasAddress
        ? $"{brand} در آدرس زیر آماده پذیرش حضوری است."
        : $"{brand} آماده پاسخگویی به درخواست‌های شماست.";
    var businessHours = contact.BusinessHours;
}
<section class="contact-channels" aria-labelledby="contact-channels-heading">
      <div class="container">
        <div class="contact-channels__head reveal">
          <p class="section-kicker">راه‌های ارتباطی</p>
          <h1 class="section-heading" id="contact-channels-heading">چطور با ما تماس بگیرید</h1>
          <p class="contact-channels__lead">از تلفن و ایمیل تا مراجعه حضوری؛ مسیر ارتباط شفاف و سریع.</p>
        </div>

        <ul class="contact-channels__list">
          @if (contact.HasPhone)
          {
          <li class="reveal">
            <a class="contact-channel" href="@telHref">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">تلفن کلینیک</span>
                <span class="contact-channel__value phone-ltr">@phoneDisplay</span>
              </span>
            </a>
          </li>
          }
          @if (contact.HasEmail)
          {
          <li class="reveal">
            <a class="contact-channel" href="mailto:@email">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-10 7L2 7"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">ایمیل</span>
                <span class="contact-channel__value phone-ltr">@email</span>
              </span>
            </a>
          </li>
          }
          @if (contact.HasBusinessHours)
          {
          <li class="reveal">
            <div class="contact-channel contact-channel--static">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 7v5l3 2"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">ساعات پاسخگویی</span>
                <span class="contact-channel__value">@businessHours</span>
              </span>
            </div>
          </li>
          }
          @if (contact.HasAddress)
          {
          <li class="reveal">
            <a class="contact-channel" href="#contact-map">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">آدرس</span>
                <span class="contact-channel__value">@addressShort</span>
              </span>
            </a>
          </li>
          }
        </ul>
      </div>
    </section>

    <section class="contact-form-section" id="contact-form" aria-labelledby="contact-form-heading">
      <div class="container">
        <div class="contact-form-section__grid">
          <div class="contact-form-panel reveal">
            <p class="section-kicker">پیام به کلینیک</p>
            <h2 class="section-heading" id="contact-form-heading">درخواست خود را بنویسید</h2>
            <p class="contact-form-panel__lead">
              برای مشاوره، نوبت یا سوالات اداری پیام بگذارید؛ در اولین فرصت با شما تماس می‌گیریم.
            </p>

            @if (hasContactForm)
            {
              <div class="contact-form">
                @await Component.InvokeAsync("FormEmbed", new { key = "contact" })
                <p class="contact-form__note">
                  یا مستقیم تماس بگیرید:
                  <a class="phone-ltr" href="@telHref">@phoneDisplay</a>
                </p>
              </div>
            }
            else
            {
                <form class="contact-form" data-contact-form novalidate>
                  <div class="contact-form__row">
                    <div class="contact-form__field">
                      <label for="contact-name">نام و نام خانوادگی</label>
                      <input id="contact-name" name="name" type="text" autocomplete="name" required placeholder="مثلاً مریم احمدی">
                      <span class="contact-form__error" data-error-for="name" hidden>لطفاً نام خود را وارد کنید.</span>
                    </div>
                    <div class="contact-form__field">
                      <label for="contact-phone">شماره تماس</label>
                      <input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="۰۹۱۲xxxxxxx" dir="ltr">
                      <span class="contact-form__error" data-error-for="phone" hidden>لطفاً شماره تماس معتبر وارد کنید.</span>
                    </div>
                  </div>

                  <div class="contact-form__field">
                    <label for="contact-email">ایمیل <span>(اختیاری)</span></label>
                    <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="name@example.com" dir="ltr">
                    <span class="contact-form__error" data-error-for="email" hidden>لطفاً ایمیل معتبر وارد کنید.</span>
                  </div>

                  <div class="contact-form__field">
                    <span class="contact-form__label" id="contact-subject-label">موضوع</span>
                    <div class="booking-select" data-ui-select>
                      <input type="hidden" id="contact-subject" name="subject" value="" required>
                      <button
                        class="booking-select__trigger"
                        type="button"
                        id="contact-subject-trigger"
                        aria-haspopup="listbox"
                        aria-expanded="false"
                        aria-labelledby="contact-subject-label contact-subject-value"
                        data-ui-select-trigger
                      >
                        <span class="booking-select__value is-placeholder" id="contact-subject-value" data-ui-select-value>انتخاب موضوع</span>
                        <span class="booking-select__caret" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m6 9 6 6 6-6"/>
                          </svg>
                        </span>
                      </button>
                      <ul class="booking-select__menu" role="listbox" aria-labelledby="contact-subject-label" hidden data-ui-select-menu>
                        <li role="option" tabindex="-1" data-value="appointment" aria-selected="false">رزرو نوبت / مشاوره</li>
                        <li role="option" tabindex="-1" data-value="thyroid" aria-selected="false">سوال درباره تیروئید</li>
                        <li role="option" tabindex="-1" data-value="parathyroid" aria-selected="false">سوال درباره پاراتیروئید</li>
                        <li role="option" tabindex="-1" data-value="adrenal" aria-selected="false">سوال درباره فوق کلیه</li>
                        <li role="option" tabindex="-1" data-value="admin" aria-selected="false">پیگیری اداری</li>
                        <li role="option" tabindex="-1" data-value="other" aria-selected="false">سایر موارد</li>
                      </ul>
                    </div>
                    <span class="contact-form__error" data-error-for="subject" hidden>لطفاً موضوع را انتخاب کنید.</span>
                  </div>

                  <div class="contact-form__field">
                    <label for="contact-message">پیام شما</label>
                    <textarea id="contact-message" name="message" rows="5" required placeholder="پیام خود را بنویسید..."></textarea>
                    <span class="contact-form__error" data-error-for="message" hidden>لطفاً پیام خود را وارد کنید.</span>
                  </div>

                  <button class="btn-primary-custom contact-form__submit" type="submit">
                    <span class="ui-icon btn-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 2 11 13"/>
                        <path d="M22 2 15 22l-4-9-9-4 20-7z"/>
                      </svg>
                    </span>
                    ارسال پیام
                  </button>

                  <p class="contact-form__note" data-contact-form-note>
                    یا مستقیم تماس بگیرید:
                    <a class="phone-ltr" href="@telHref">@phoneDisplay</a>
                  </p>

                  <div class="contact-form__success" data-contact-success hidden>
                    <span class="contact-form__success-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="m8.5 12.5 2.2 2.2 4.8-5"/>
                      </svg>
                    </span>
                    <p class="contact-form__success-title">پیام شما دریافت شد</p>
                    <p class="contact-form__success-text">به‌زودی از طریق شماره تماس ثبت‌شده با شما ارتباط می‌گیریم.</p>
                  </div>
                </form>
            }
          </div>

          <aside class="contact-aside reveal" aria-labelledby="contact-aside-heading">
            <h2 class="contact-aside__heading" id="contact-aside-heading">مراجعه حضوری</h2>
            <p class="contact-aside__text">
              @asideIntro
            </p>

            <dl class="contact-aside__meta">
              @if (contact.HasAddress)
              {
              <div>
                <dt>آدرس دقیق</dt>
                <dd>@addressExact</dd>
              </div>
              }
              @if (contact.HasPhone)
              {
              <div>
                <dt>تلفن</dt>
                <dd><a class="phone-ltr" href="@telHref">@phoneDisplay</a></dd>
              </div>
              }
              @if (contact.HasBusinessHours)
              {
              <div>
                <dt>ساعات کار</dt>
                <dd>@businessHours</dd>
              </div>
              }
            </dl>

            <div class="contact-aside__actions">
              @if (directionsHref is not null)
              {
              <a
                class="contact-aside__directions"
                href="@directionsHref"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="ui-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 11l19-9-9 19-2-8-8-2z"/>
                  </svg>
                </span>
                مسیریابی
              </a>
              }

              <button class="btn-secondary-custom contact-aside__booking" type="button" data-booking-open>
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                </span>
                رزرو نوبت
              </button>
            </div>
          </aside>
        </div>
      </div>
    </section>

@if (contact.HasAddress && mapEmbedSrc is not null)
{
    <section class="contact-map" id="contact-map" aria-labelledby="contact-map-heading">
      <div class="container">
        <div class="contact-map__head reveal">
          <div>
            <p class="section-kicker">موقعیت</p>
            <h2 class="section-heading" id="contact-map-heading">ما را روی نقشه پیدا کنید</h2>
          </div>
        </div>
        <div class="contact-map__frame reveal">
          <iframe
            title="نقشه موقعیت @brand روی گوگل مپ"
            src="@mapEmbedSrc"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
}
