@{
    ViewData["Title"] = "تماس با ما";
    ViewData["NavActive"] = "contact";
}
<section class="contact-channels" aria-labelledby="contact-channels-heading">
      <div class="container">
        <div class="contact-channels__head reveal">
          <p class="section-kicker">راه‌های ارتباطی</p>
          <h1 class="section-heading" id="contact-channels-heading">چطور با ما تماس بگیرید</h1>
          <p class="contact-channels__lead">از تلفن و ایمیل تا مراجعه حضوری؛ مسیر ارتباط شفاف و سریع.</p>
        </div>

        <ul class="contact-channels__list">
          <li class="reveal">
            <a class="contact-channel" href="tel:02191093492">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">تلفن کلینیک</span>
                <span class="contact-channel__value phone-ltr">۰۲۱-۹۱۰۹۳۴۹۲</span>
              </span>
            </a>
          </li>
          <li class="reveal">
            <a class="contact-channel" href="mailto:info@@nova-clinic.org">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-10 7L2 7"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">ایمیل</span>
                <span class="contact-channel__value phone-ltr">info@@nova-clinic.org</span>
              </span>
            </a>
          </li>
          <li class="reveal">
            <div class="contact-channel contact-channel--static">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 7v5l3 2"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">ساعات پاسخگویی</span>
                <span class="contact-channel__value">شنبه تا پنجشنبه · ۹ تا ۲۱</span>
              </span>
            </div>
          </li>
          <li class="reveal">
            <a class="contact-channel" href="#contact-map">
              <span class="contact-channel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <span class="contact-channel__body">
                <span class="contact-channel__label">آدرس</span>
                <span class="contact-channel__value">شریعتی، نبش کوچه ذکایی، ساختمان کسری، طبقه ۴ واحد ۱۵</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="contact-form-section" id="contact-form" aria-labelledby="contact-form-heading">
      <div class="container">
        <div class="contact-form-section__grid">
          <div class="contact-form-panel reveal">
            <p class="section-kicker">پیام به کلینیک</p>
            <h2 class="section-heading" id="contact-form-heading">درخواست خود را بنویسید</h2>
            <p class="contact-form-panel__lead">
              برای مشاوره، نوبت یا سوالات اداری پیام بگذارید؛ در اولین فرصت با شما تماس می‌گیریم.
            </p>

            <div class="contact-form">
              @await Component.InvokeAsync("FormEmbed", new { key = "contact" })
            </div>
          </div>

          <aside class="contact-aside reveal" aria-labelledby="contact-aside-heading">
            <h2 class="contact-aside__heading" id="contact-aside-heading">مراجعه حضوری</h2>
            <p class="contact-aside__text">
              کلینیک در خیابان شریعتی، بالاتر از خواجه عبدالله، نبش کوچه ذکایی (جنب آرش موتورز)، ساختمان کسری قرار دارد.
            </p>

            <dl class="contact-aside__meta">
              <div>
                <dt>آدرس دقیق</dt>
                <dd>شریعتی بالاتر از خواجه عبدالله، نبش کوچه ذکایی، ساختمان کسری، طبقه ۴ واحد ۱۵</dd>
              </div>
              <div>
                <dt>تلفن</dt>
                <dd><a class="phone-ltr" href="tel:02191093492">۰۲۱-۹۱۰۹۳۴۹۲</a></dd>
              </div>
              <div>
                <dt>ساعات کار</dt>
                <dd>شنبه تا پنجشنبه · ۹ تا ۲۱</dd>
              </div>
            </dl>

            <div class="contact-aside__actions">
              <a
                class="contact-aside__directions"
                href="https://www.google.com/maps/dir/?api=1&destination=%D8%B4%D8%B1%DB%8C%D8%B9%D8%AA%DB%8C+%D8%A8%D8%A7%D9%84%D8%A7%D8%AA%D8%B1+%D8%A7%D8%B2+%D8%AE%D9%88%D8%A7%D8%AC%D9%87+%D8%B9%D8%A8%D8%AF%D8%A7%D9%84%D9%84%D9%87+%D9%86%D8%A8%D8%B4+%DA%A9%D9%88%DA%86%D9%87+%D8%B0%DA%A9%D8%A7%DB%8C%DB%8C+%D8%B3%D8%A7%D8%AE%D8%AA%D9%85%D8%A7%D9%86+%DA%A9%D8%B3%D8%B1%DB%8C+%D8%AA%D9%87%D8%B1%D8%A7%D9%86"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="ui-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 11l19-9-9 19-2-8-8-2z"/>
                  </svg>
                </span>
                مسیریابی
              </a>

              <button class="btn-secondary-custom contact-aside__booking" type="button" data-booking-open>
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                </span>
                رزرو نوبت
              </button>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="contact-map" id="contact-map" aria-labelledby="contact-map-heading">
      <div class="container">
        <div class="contact-map__head reveal">
          <div>
            <p class="section-kicker">موقعیت</p>
            <h2 class="section-heading" id="contact-map-heading">ما را روی نقشه پیدا کنید</h2>
          </div>
          <p class="contact-map__lead">شریعتی · ساختمان کسری · طبقه ۴ واحد ۱۵</p>
        </div>
        <div class="contact-map__frame reveal">
          <iframe
            title="نقشه موقعیت نووا کلینیک روی گوگل مپ"
            src="https://maps.google.com/maps?q=%D8%B4%D8%B1%DB%8C%D8%B9%D8%AA%DB%8C+%D8%A8%D8%A7%D9%84%D8%A7%D8%AA%D8%B1+%D8%A7%D8%B2+%D8%AE%D9%88%D8%A7%D8%AC%D9%87+%D8%B9%D8%A8%D8%AF%D8%A7%D9%84%D9%84%D9%87+%D9%86%D8%A8%D8%B4+%DA%A9%D9%88%DA%86%D9%87+%D8%B0%DA%A9%D8%A7%DB%8C%DB%8C+%D8%B3%D8%A7%D8%AE%D8%AA%D9%85%D8%A7%D9%86+%DA%A9%D8%B3%D8%B1%DB%8C+%D8%AA%D9%87%D8%B1%D8%A7%D9%86&hl=fa&z=16&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
