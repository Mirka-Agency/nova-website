@using CMS.Application.Settings
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = "حریم خصوصی";
    ViewData["NavActive"] = "about";
    ViewData["MetaDescription"] = "سیاست حریم خصوصی و نحوهٔ جمع‌آوری، استفاده و محافظت از اطلاعات کاربران در وب‌سایت.";
    var contact = SiteContactInfo.From(await SiteSettings.GetAsync());
    var brand = contact.Brand;
}
<section class="page-hero" aria-labelledby="page-hero-title">
  <div class="container page-hero__inner">
    <nav class="page-breadcrumb reveal" aria-label="مسیر صفحه">
      <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
      <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
      <span aria-current="page">حریم خصوصی</span>
    </nav>
    <h1 class="page-hero__title reveal" id="page-hero-title">حریم خصوصی</h1>
    <p class="page-hero__lead reveal">نحوهٔ جمع‌آوری و محافظت از اطلاعات شما در @brand</p>
  </div>
</section>

<section class="container" style="padding-block: 2rem 4rem;">
@if (contact.HasPrivacyHtml)
{
  <article class="article-prose reveal">
    <div class="article-prose__body admin-rich-content">
      @Html.Raw(contact.PrivacyHtml)
    </div>
  </article>
}
else
{
  <article class="article-prose reveal">
    <div class="article-prose__body">
      <p>
        @brand به حریم خصوصی بازدیدکنندگان و بیماران احترام می‌گذارد.
        این صفحه توضیح می‌دهد چه اطلاعاتی از طریق وب‌سایت جمع‌آوری می‌شود، چگونه استفاده می‌شود و چگونه محافظت می‌گردد.
      </p>

      <h2>۱. دامنهٔ این سیاست</h2>
      <p>
        این سیاست مربوط به استفاده از وب‌سایت و راه‌های ارتباطی آنلاین (مانند فرم تماس و تماس تلفنی/ایمیل از طریق سایت) است.
        اطلاعات پروندهٔ پزشکی و سوابق بالینی که در فرآیند پذیرش و درمان حضوری ثبت می‌شوند، تابع قوانین و مقررات حرفه‌ای و محرمانگی پزشکی هستند و ممکن است جدا از این صفحه مدیریت شوند.
      </p>

      <h2>۲. اطلاعاتی که ممکن است جمع‌آوری شود</h2>
      <p>بسته به نحوهٔ استفاده شما از سایت، ممکن است موارد زیر دریافت شود:</p>
      <ul>
        <li>اطلاعات تماس که خودتان ارسال می‌کنید؛ مانند نام، شماره تلفن، ایمیل و متن پیام در فرم‌ها</li>
        <li>اطلاعات فنی حداقلی برای عملکرد سایت؛ مانند نوع مرورگر، دستگاه، آدرس IP و صفحات بازدیدشده</li>
        <li>داده‌های کوکی و ابزارهای مشابه برای بهبود تجربه کاربری، امنیت و آمار بازدید</li>
      </ul>
      <p>ما از شما نمی‌خواهیم از طریق وب‌سایت اطلاعات حساس پزشکی غیرضروری ارسال کنید؛ برای مشاوره تخصصی، مسیر تماس یا مراجعه حضوری توصیه می‌شود.</p>

      <h2>۳. هدف از استفاده از اطلاعات</h2>
      <p>اطلاعات جمع‌آوری‌شده معمولاً برای این اهداف استفاده می‌شود:</p>
      <ul>
        <li>پاسخ به درخواست‌ها، هماهنگی تماس و پیگیری پیام‌های شما</li>
        <li>بهبود کیفیت محتوا، خدمات و تجربهٔ کاربری وب‌سایت</li>
        <li>تحلیل آماری بازدید و رفع اشکالات فنی</li>
        <li>رعایت الزامات قانونی در صورت وجود درخواست معتبر از مراجع ذی‌صلاح</li>
      </ul>

      <h2>۴. اشتراک‌گذاری اطلاعات</h2>
      <p>
        اطلاعات شخصی شما بدون دلیل موجه در اختیار اشخاص ثالث قرار نمی‌گیرد.
        در موارد زیر ممکن است اطلاعات محدودی به اشتراک گذاشته شود:
      </p>
      <ul>
        <li>ارائه‌دهندگان خدمات فنی/میزبانی که برای ادارهٔ سایت به آن‌ها نیاز است (در حد لازم برای ارائه خدمت)</li>
        <li>مواردی که افشا به‌موجب قانون یا دستور مرجع صالح الزامی باشد</li>
      </ul>

      <h2>۵. نگهداری و امنیت</h2>
      <p>
        تلاش می‌کنیم با اقدامات فنی و سازمانی متعارف، از دسترسی غیرمجاز، افشا، تغییر یا از بین رفتن اطلاعات جلوگیری کنیم.
        با این حال، هیچ انتقال داده‌ای در اینترنت کاملاً بدون ریسک نیست؛ بنابراین توصیه می‌شود اطلاعات حساس را فقط از مسیرهای امن و ضروری ارسال کنید.
      </p>

      <h2>۶. کوکی‌ها</h2>
      <p>
        وب‌سایت ممکن است از کوکی‌ها برای کارکرد صحیح، به‌خاطرسپردن تنظیمات و تحلیل بازدید استفاده کند.
        می‌توانید از تنظیمات مرورگر، کوکی‌ها را محدود یا حذف کنید؛ هرچند بخشی از امکانات سایت ممکن است درست کار نکند.
      </p>

      <h2>۷. حقوق شما</h2>
      <p>در چارچوب قوانین قابل‌اجرا، می‌توانید دربارهٔ اطلاعات تماس ارسال‌شده از طریق سایت درخواست دسترسی، اصلاح یا حذف داشته باشید. برای این کار از راه‌های ارتباطی زیر استفاده کنید.</p>

      <h2>۸. پیوند به سایت‌های دیگر</h2>
      <p>
        ممکن است در سایت به صفحات یا سرویس‌های خارجی (مانند نقشه یا شبکه‌های اجتماعی) لینک داده شود.
        سیاست حریم خصوصی آن سرویس‌ها مستقل است و مسئولیت محتوای آن‌ها با ما نیست.
      </p>

      <h2>۹. تغییرات این صفحه</h2>
      <p>
        در صورت به‌روزرسانی سیاست حریم خصوصی، نسخهٔ جدید در همین صفحه منتشر می‌شود.
        ادامهٔ استفاده از وب‌سایت پس از انتشار تغییرات، به‌منزلهٔ آگاهی از نسخهٔ به‌روز تلقی می‌شود.
      </p>

      <h2>۱۰. تماس با ما</h2>
      <p>برای پرسش دربارهٔ حریم خصوصی می‌توانید از راه‌های زیر با @brand در ارتباط باشید:</p>
      <ul>
        @if (contact.HasPhone)
        {
          <li>تلفن: <a class="phone-ltr" href="@contact.TelHref">@contact.PhoneDisplay</a></li>
        }
        @if (contact.HasEmail)
        {
          <li>ایمیل: <a href="mailto:@contact.Email">@contact.Email</a></li>
        }
        @if (contact.HasAddress)
        {
          <li>آدرس: @contact.Address</li>
        }
        <li>صفحه <a asp-area="" asp-route="contact-us">تماس با ما</a></li>
      </ul>
    </div>
  </article>
}
</section>
