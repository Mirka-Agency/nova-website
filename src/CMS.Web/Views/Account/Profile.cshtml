@model CustomerProfileFormViewModel
@{
    ViewData["Title"] = "پروفایل";
}

<h1>پروفایل</h1>
<form asp-action="Profile" method="post" class="admin-form admin-form-narrow">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>
    <div class="admin-field"><label>موبایل</label><input value="@Model.Phone" readonly /></div>
    <div class="admin-field"><label asp-for="FullName">نام و نام خانوادگی</label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div>
    <div class="admin-field"><label asp-for="Email">ایمیل (اختیاری)</label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
    <button type="submit" class="btn btn-primary">ذخیره</button>
</form>
