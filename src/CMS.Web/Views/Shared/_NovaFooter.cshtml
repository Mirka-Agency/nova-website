@* Nova template footer *@
@using CMS.Application.Common.Features
@using CMS.Application.Settings
@using CMS.Modules.Services.Application.Interfaces
@using CMS.Modules.Services.Application.ServiceItems
@using CMS.Web.Infrastructure
@using Microsoft.FeatureManagement
@inject ISiteSettingsService SiteSettings
@inject IFeatureManager FeatureManager
@inject IPublicServiceItemQuery PublicServices
@{
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var brand = contact.Brand;
    var logoUrl = Url.Content("~/template/assets/images/common/logo-nova-white.png");
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var email = contact.Email;
    var address = contact.Address;
    var footerText = contact.FooterText;
    var year = DateTime.Now.Year;

    IReadOnlyList<PublicServiceItemSummaryDto> navServices = Array.Empty<PublicServiceItemSummaryDto>();
    if (await FeatureManager.IsEnabledAsync(FeatureNames.Services))
        navServices = await PublicServices.ListPublishedAsync();

    var thyroidService = NovaServiceNav.Find(navServices, "thyroid", "تیروئید");
    var parathyroidService = NovaServiceNav.Find(navServices, "parathyroid", "پاراتیروئید");
    var adrenalService = NovaServiceNav.Find(navServices, "adrenal", "آدرنال", "فوق کلیه");
    var pancreasService = NovaServiceNav.Find(navServices, "pancreas", "پانکراس");
    var thyroidHref = NovaServiceNav.Href(Url, thyroidService, "thyroid");
    var parathyroidHref = NovaServiceNav.Href(Url, parathyroidService, "parathyroid");
    var adrenalHref = NovaServiceNav.Href(Url, adrenalService, "adrenal");
    var pancreasHref = NovaServiceNav.Href(Url, pancreasService, "pancreas");
}
<footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a asp-controller="Home" asp-action="Index" class="footer-brand__logo" aria-label="@brand">
            <img src="@logoUrl" width="115" height="72" alt="@brand">
          </a>
          @if (!string.IsNullOrWhiteSpace(footerText))
          {
          <p class="footer-brand__text">
            @footerText
          </p>
          }
          <p class="footer-brand__text">
            نووا کلینیک، اولین و تنها مرکز فلوشیپ جراحی غدد ایران، تحت نظارت دکتر کاوه همدانی (نظام پزشکی: 110614) است. ما با بهره‌گیری از تکنولوژی‌های روز دنیا، در تلاشیم با ارائه روش‌های نوین جراحی، عوارض را کاهش داده و کیفیت زندگی بیماران را بهبود بخشیم.
          </p>
          @if (contact.HasPhone)
          {
          <a class="footer-cta" href="@telHref">
            <span class="ui-icon btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            رزرو مشاوره · <span class="phone-ltr">@phoneDisplay</span>
          </a>
          }
        </div>

        <nav class="footer-nav" aria-label="لینک‌های فوتر">
          <div class="footer-col">
            <h3 class="footer-heading">خدمات</h3>
            <ul class="footer-links">
              <li><a href="@thyroidHref">@(thyroidService?.Title ?? "جراحی تیروئید")</a></li>
              <li><a href="@parathyroidHref">@(parathyroidService?.Title ?? "جراحی پاراتیروئید")</a></li>
              <li><a href="@adrenalHref">@(adrenalService?.Title ?? "جراحی فوق کلیه")</a></li>
              <li><a href="@pancreasHref">@(pancreasService?.Title ?? "جراحی پانکراس")</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">دسترسی</h3>
            <ul class="footer-links">
              <li><a asp-controller="Teams" asp-action="Index">متخصصان کلینیک</a></li>
              <li><a href="#journey">مسیر درمان</a></li>
              <li><a asp-area="" asp-route="education-articles">مقالات</a></li>
              <li><a href="#faq">سوالات متداول</a></li>
            </ul>
          </div>

          <div class="footer-col footer-col--contact">
            <h3 class="footer-heading">ارتباط</h3>
            <ul class="footer-contact">
              @if (contact.HasPhone)
              {
              <li>
                <span class="footer-contact__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </span>
                <span class="footer-contact__body">
                  <span class="footer-contact__label">تلفن</span>
                  <a class="phone-ltr" href="@telHref">@phoneDisplay</a>
                </span>
              </li>
              }
              @if (contact.HasEmail)
              {
              <li>
                <span class="footer-contact__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-10 7L2 7"/>
                  </svg>
                </span>
                <span class="footer-contact__body">
                  <span class="footer-contact__label">ایمیل</span>
                  <a href="mailto:@email">@email</a>
                </span>
              </li>
              }
              @if (contact.HasAddress)
              {
              <li>
                <span class="footer-contact__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </span>
                <span class="footer-contact__body">
                  <span class="footer-contact__label">آدرس</span>
                  <span>@address</span>
                </span>
              </li>
              }
            </ul>
          </div>
        </nav>
      </div>

      <div class="footer-bottom">
        <p class="footer-copy">© @year @brand</p>
        <div class="footer-social">
          @if (!string.IsNullOrWhiteSpace(contact.InstagramUrl))
          {
          <a href="@contact.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="اینستاگرام">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          }
          @if (!string.IsNullOrWhiteSpace(contact.LinkedInUrl))
          {
          <a href="@contact.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="لینکدین">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          }
          @if (!string.IsNullOrWhiteSpace(contact.YouTubeUrl))
          {
          <a href="@contact.YouTubeUrl" target="_blank" rel="noopener noreferrer" aria-label="یوتیوب">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22.5 7.5a3 3 0 0 0-2.1-2.1C18.6 5 12 5 12 5s-6.6 0-8.4.4A3 3 0 0 0 1.5 7.5 31 31 0 0 0 1 12a31 31 0 0 0 .5 4.5 3 3 0 0 0 2.1 2.1C5.4 19 12 19 12 19s6.6 0 8.4-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23 12a31 31 0 0 0-.5-4.5z"/>
              <path d="m10 15 5-3-5-3v6z"/>
            </svg>
          </a>
          }
          @if (!string.IsNullOrWhiteSpace(contact.AparatUrl))
          {
          <a href="@contact.AparatUrl" target="_blank" rel="noopener noreferrer" aria-label="آپارات">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3"/>
              <path d="M8 10.5v3M12 9v6M16 10.5v3"/>
            </svg>
          </a>
          }
        </div>
      </div>

      <p class="footer-credit">
        <a href="https://mirka.agency/" target="_blank" rel="noopener noreferrer">درخشان با میرکا 💎</a>
      </p>
    </div>
  </footer>
