@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<h1 class="text-danger">خطا</h1>
<h2 class="text-danger">هنگام پردازش درخواست شما خطایی رخ داد.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>شناسه درخواست:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>حالت توسعه</h3>
<p>
    با فعال کردن محیط توسعه، جزئیات بیشتری از خطا نمایش داده می‌شود.
</p>
<p>
    <strong>محیط توسعه نباید در محیط عملیاتی فعال باشد.</strong>
    این کار می‌تواند اطلاعات حساس استثناها را در اختیار کاربران قرار دهد.
    برای اشکال‌زدایی محلی، متغیر محیطی محیط اجرا را روی حالت توسعه تنظیم کنید و برنامه را دوباره اجرا کنید.
</p>
