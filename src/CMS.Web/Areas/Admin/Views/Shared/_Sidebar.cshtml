    @if (await FeatureManager.IsEnabledAsync(FeatureNames.Comments)
         && (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.ViewComments)).Succeeded)
    {
        <div class="admin-nav-section @(commentsActive ? "is-open" : null)"
             data-admin-nav-section
             data-admin-nav-section-id="comments">
            <button type="button"
                    class="admin-nav-section-toggle @(commentsActive ? "is-current" : null)"
                    data-admin-nav-section-toggle
                    aria-expanded="@(commentsActive ? "true" : "false")"
                    aria-controls="admin-nav-comments">
                <span class="admin-nav-section-label">
                    <i class="fas fa-comments" aria-hidden="true"></i>
                    <span>@Localizer["Comments"]</span>
                </span>
                <i class="fas fa-chevron-down admin-nav-section-caret" aria-hidden="true"></i>
            </button>
            <div class="admin-nav-subitems" id="admin-nav-comments" data-admin-nav-subitems @(commentsActive ? null : "hidden")>
                <a class="admin-nav-sublink @(IsCtrl("Comments") && string.IsNullOrWhiteSpace(Context.Request.Query["targetType"]) ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Comments" asp-action="Index">
                    <i class="fas fa-list" aria-hidden="true"></i>
                    <span>@Localizer["AllComments"]</span>
                </a>
                <a class="admin-nav-sublink @(Context.Request.Query["targetType"] == "0" ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Comments" asp-action="Index" asp-route-targetType="0">
                    <i class="fas fa-blog" aria-hidden="true"></i>
                    <span>@Localizer["BlogComments"]</span>
                </a>
                <a class="admin-nav-sublink @(Context.Request.Query["targetType"] == "1" ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Comments" asp-action="Index" asp-route-targetType="1">
                    <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                    <span>@Localizer["EventComments"]</span>
                </a>
                <a class="admin-nav-sublink @(Context.Request.Query["targetType"] == "2" ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Comments" asp-action="Index" asp-route-targetType="2">
                    <i class="fas fa-box" aria-hidden="true"></i>
                    <span>@Localizer["ProductComments"]</span>
                </a>
                <a class="admin-nav-sublink @(Context.Request.Query["targetType"] == "3" ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Comments" asp-action="Index" asp-route-targetType="3">
                    <i class="fas fa-sitemap" aria-hidden="true"></i>
                    <span>@Localizer["ProductCategoryComments"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("CommentSettings") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="CommentSettings" asp-action="Index">
                    <i class="fas fa-cog" aria-hidden="true"></i>
                    <span>@Localizer["CommentSettings"]</span>
                </a>
            </div>
        </div>
    }

    @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.ViewMedia)).Succeeded)
    {
        <a class="admin-nav-link @(mediaActive ? "is-active" : null)"
           asp-area="Admin"
           asp-controller="Media"
           asp-action="Index">
            <i class="fas fa-images" aria-hidden="true"></i>
            <span>@Localizer["MediaLibrary"]</span>
        </a>
    }

    @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.AdminOnly)).Succeeded)
    {
        <div class="admin-nav-section @(systemActive ? "is-open" : null)"
             data-admin-nav-section
             data-admin-nav-section-id="system">
            <button type="button"
                    class="admin-nav-section-toggle @(systemActive ? "is-current" : null)"
                    data-admin-nav-section-toggle
                    aria-expanded="@(systemActive ? "true" : "false")"
                    aria-controls="admin-nav-system">
                <span class="admin-nav-section-label">
                    <i class="fas fa-server" aria-hidden="true"></i>
                    <span>@Localizer["System"]</span>
                </span>
                <i class="fas fa-chevron-down admin-nav-section-caret" aria-hidden="true"></i>
            </button>
            <div class="admin-nav-subitems" id="admin-nav-system" data-admin-nav-subitems @(systemActive ? null : "hidden")>
                <a class="admin-nav-sublink @(IsCtrl("Users") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users" aria-hidden="true"></i>
                    <span>@Localizer["Users"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("Features") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Features" asp-action="Index">
                    <i class="fas fa-toggle-on" aria-hidden="true"></i>
                    <span>@Localizer["Features"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("Settings") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Settings" asp-action="Index">
                    <i class="fas fa-sliders-h" aria-hidden="true"></i>
                    <span>@Localizer["SiteSettings"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("SiteScripts") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="SiteScripts" asp-action="Index">
                    <i class="fas fa-code" aria-hidden="true"></i>
                    <span>@Localizer["SiteScripts"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("Audit") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Audit" asp-action="Index">
                    <i class="fas fa-history" aria-hidden="true"></i>
                    <span>@Localizer["AuditLog"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("MessageLogs") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="MessageLogs" asp-action="Index">
                    <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    <span>@Localizer["MessageLogs"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("WhatsApp") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="WhatsApp" asp-action="Index">
                    <i class="fab fa-whatsapp" aria-hidden="true"></i>
                    <span>@Localizer["WhatsApp"]</span>
                </a>
            </div>
        </div>
    }
</nav>
