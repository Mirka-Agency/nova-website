    @if (await FeatureManager.IsEnabledAsync(FeatureNames.Forms)
         && (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.ViewForms)).Succeeded)
    {
        var unreadSubmissions = await SubmissionService.CountUnreadAsync();
        var unreadLabel = unreadSubmissions > 0
            ? Localizer["UnreadFormSubmissions", unreadSubmissions.ToString("N0")].Value
            : null;
        <div class="admin-nav-section @(formsActive ? "is-open" : null)"
             data-admin-nav-section
             data-admin-nav-section-id="forms">
