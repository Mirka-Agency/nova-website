@using CMS.Application.Common.Features
@using CMS.Infrastructure.Auth
@using CMS.Modules.Forms.Application.Interfaces
@using CMS.Modules.Shop.Application.Interfaces
@using CMS.Modules.Shop.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager
@inject IAuthorizationService AuthorizationService
@inject ISubmissionService SubmissionService
@inject IOrderService OrderService
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsCtrl(params string[] names) => names.Any(n => string.Equals(n, controller, StringComparison.OrdinalIgnoreCase));

    var blogActive = IsCtrl("Posts", "Categories");
    var newsActive = IsCtrl("NewsArticles", "NewsCategories");
    var contentActive = IsCtrl("CtaHelper");
    var servicesActive = IsCtrl("ServiceItems", "ServiceCategories");
    var videoActive = IsCtrl("VideoItems", "VideoCategories");
    var teamActive = IsCtrl("TeamItems", "TeamCategories");
    var honorsActive = IsCtrl("HonorItems");
    var voicesActive = IsCtrl("VoiceItems");
    var shopActive = IsCtrl(
        "ShopHome", "Products", "ShopCategories", "ShopSettings",
        "Brands", "Attributes", "CustomerGroups",
        "PriceRules", "Wholesale", "Coupons", "ShippingMethods", "PaymentProviders", "Reviews", "CommerceReports",
        "ProductVariations");
    var ordersActive = IsCtrl("Orders");
    var formsActive = IsCtrl("Forms", "FormSubmissions");
    var commentsActive = IsCtrl("Comments", "CommentSettings");
    var popupActive = IsCtrl("Popups");
    var seoActive = IsCtrl("SeoSettings", "SeoRedirects");
    var mediaActive = IsCtrl("Media");
    var systemActive = IsCtrl("Users", "Features", "Settings", "SiteScripts", "Audit", "MessageLogs", "WhatsApp");
    var orderStatus = Context.Request.Query["status"].ToString();
    bool IsOrderStatus(string value) =>
        string.Equals(orderStatus, value, StringComparison.OrdinalIgnoreCase);
    bool IsAllOrders = ordersActive && string.IsNullOrWhiteSpace(orderStatus);
    var submissionStatus = Context.Request.Query["status"].ToString();
    bool IsSubmissionStatus(string value) =>
        IsCtrl("FormSubmissions")
        && string.Equals(submissionStatus, value, StringComparison.OrdinalIgnoreCase);
    bool IsFormSubmissionsInbox = IsCtrl("FormSubmissions") && !IsSubmissionStatus("Archived");
    bool IsFormSubmissionsArchive = IsSubmissionStatus("Archived");
}

