                    <span>@Localizer["ShopSettings"]</span>
                </a>
            </div>
        </div>
    }

    @if (await FeatureManager.IsEnabledAsync(FeatureNames.Shop)
         && (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.ViewShop)).Succeeded)
    {
        var pendingOrderCount = await OrderService.CountByStatusesAsync([OrderStatus.Pending]);
        var processingOrderCount = await OrderService.CountByStatusesAsync([
            OrderStatus.Reviewing,
            OrderStatus.Approved,
            OrderStatus.Processing,
            OrderStatus.ReadyForShipping
        ]);
        var newOrderCount = pendingOrderCount + processingOrderCount;
        var newOrdersLabel = newOrderCount > 0
            ? Localizer["NewOrders", newOrderCount.ToString("N0")].Value
            : null;
        <div class="admin-nav-section @(ordersActive ? "is-open" : null)"
             data-admin-nav-section
             data-admin-nav-section-id="orders">
            <button type="button"
                    class="admin-nav-section-toggle @(ordersActive ? "is-current" : null)"
                    data-admin-nav-section-toggle
                    aria-expanded="@(ordersActive ? "true" : "false")"
                    aria-controls="admin-nav-orders">
                <span class="admin-nav-section-label">
                    <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                    <span>@Localizer["Orders"]</span>
                </span>
                <span class="admin-nav-section-meta">
                    @if (newOrderCount > 0)
                    {
                        <span class="admin-nav-count" aria-label="@newOrdersLabel">@newOrderCount.ToString("N0")</span>
                    }
                    <i class="fas fa-chevron-down admin-nav-section-caret" aria-hidden="true"></i>
                </span>
            </button>
            <div class="admin-nav-subitems" id="admin-nav-orders" data-admin-nav-subitems @(ordersActive ? null : "hidden")>
                <a class="admin-nav-sublink @(IsAllOrders ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="fas fa-list" aria-hidden="true"></i>
                    <span>@Localizer["AllOrders"]</span>
                </a>
                <a class="admin-nav-sublink @(IsOrderStatus("pending") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="pending">
                    <i class="fas fa-clock" aria-hidden="true"></i>
                    <span>@Localizer["OrdersPending"]</span>
                    @if (pendingOrderCount > 0)
                    {
                        <span class="admin-nav-count" aria-label="@Localizer["NewOrders", pendingOrderCount.ToString("N0")]">@pendingOrderCount.ToString("N0")</span>
                    }
                </a>
                <a class="admin-nav-sublink @(IsOrderStatus("processing") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="processing">
                    <i class="fas fa-cogs" aria-hidden="true"></i>
                    <span>@Localizer["OrdersProcessing"]</span>
                    @if (processingOrderCount > 0)
                    {
                        <span class="admin-nav-count" aria-label="@Localizer["NewOrders", processingOrderCount.ToString("N0")]">@processingOrderCount.ToString("N0")</span>
                    }
                </a>
                <a class="admin-nav-sublink @(IsOrderStatus("shipped") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="shipped">
                    <i class="fas fa-truck" aria-hidden="true"></i>
                    <span>@Localizer["OrdersShipped"]</span>
                </a>
                <a class="admin-nav-sublink @(IsOrderStatus("completed") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="completed">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    <span>@Localizer["OrdersCompleted"]</span>
                </a>
                <a class="admin-nav-sublink @(IsOrderStatus("cancelled") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="cancelled">
                    <i class="fas fa-ban" aria-hidden="true"></i>
                    <span>@Localizer["OrdersCancelled"]</span>
                </a>
            </div>
        </div>
