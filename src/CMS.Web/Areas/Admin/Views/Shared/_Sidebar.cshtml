            </button>
            <div class="admin-nav-subitems" id="admin-nav-shop" data-admin-nav-subitems @(shopActive ? null : "hidden")>
                <a class="admin-nav-sublink @(IsCtrl("ShopHome") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="ShopHome" asp-action="Index">
                    <i class="fas fa-home" aria-hidden="true"></i>
