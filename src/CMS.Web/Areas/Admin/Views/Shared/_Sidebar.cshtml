                <a class="admin-nav-sublink @(IsCtrl("Coupons") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Coupons" asp-action="Index">
                    <i class="fas fa-ticket-alt" aria-hidden="true"></i>
                    <span>@Localizer["Coupons"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("ShippingMethods") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="ShippingMethods" asp-action="Index">
