                    }
                    <i class="fas fa-chevron-down admin-nav-section-caret" aria-hidden="true"></i>
                </span>
            </button>
            <div class="admin-nav-subitems" id="admin-nav-forms" data-admin-nav-subitems @(formsActive ? null : "hidden")>
                <a class="admin-nav-sublink @(IsCtrl("Forms") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="Forms" asp-action="Index">
                    <i class="fas fa-list" aria-hidden="true"></i>
                    <span>@Localizer["Forms"]</span>
                </a>
                <a class="admin-nav-sublink @(IsFormSubmissionsInbox ? "is-active" : null)"
                   asp-area="Admin" asp-controller="FormSubmissions" asp-action="Index"
                   asp-route-status="@(unreadSubmissions > 0 ? "New" : null)">
                    <i class="fas fa-inbox" aria-hidden="true"></i>
                    <span>@Localizer["FormSubmissions"]</span>
                    @if (unreadSubmissions > 0)
                    {
                        <span class="admin-nav-count" aria-label="@unreadLabel">@unreadSubmissions.ToString("N0")</span>
                    }
                </a>
                <a class="admin-nav-sublink @(IsFormSubmissionsArchive ? "is-active" : null)"
                   asp-area="Admin" asp-controller="FormSubmissions" asp-action="Index"
                   asp-route-status="Archived">
                    <i class="fas fa-archive" aria-hidden="true"></i>
                    <span>@Localizer["FormSubmissionsArchive"]</span>
                </a>
            </div>
        </div>
