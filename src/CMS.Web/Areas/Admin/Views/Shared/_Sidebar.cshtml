                    <span>@Localizer["Products"]</span>
                </a>
                <a class="admin-nav-sublink @(IsCtrl("ShopCategories", "Brands") ? "is-active" : null)"
                   asp-area="Admin" asp-controller="ShopCategories" asp-action="Index">
                    <i class="fas fa-sitemap" aria-hidden="true"></i>
                    <span>@Localizer["CategoriesAndBrands"]</span>
