@model CMS.Web.Areas.Admin.ViewModels.AdminSetUserPasswordViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["SetUserPassword"];
}

<p class="admin-lead">@Localizer["SetUserPasswordFor"]: <strong>@Model.Email</strong></p>

<form asp-action="SetPassword" method="post" class="admin-form admin-form-narrow">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-field">
        <label asp-for="NewPassword">@Localizer["NewPassword"]</label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label asp-for="ConfirmPassword">@Localizer["ConfirmPassword"]</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="admin-field-error"></span>
    </div>

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-key" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.UserId"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
    </div>
</form>
