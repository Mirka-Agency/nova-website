@model CMS.Web.Areas.Admin.ViewModels.CreateUserViewModel
@using CMS.Application.Users
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["CreateUser"];
    var gravatarUrl = UserAvatarUrl.Gravatar(Model.Email, 160);
    var previewUrl = UserAvatarUrl.Resolve(Model.AvatarUrl, Model.Email, 160);
}

<form asp-action="Create" method="post" class="admin-form admin-form-narrow">
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-field">
        <label asp-for="Email">@Localizer["Email"]</label>
        <input asp-for="Email" data-avatar-email />
        <span asp-validation-for="Email" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label asp-for="FullName">@Localizer["FullName"]</label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label>@Localizer["Avatar"]</label>
        <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
            <button type="button" class="btn btn-secondary" data-media-picker data-target="#AvatarUrl">
                <i class="fas fa-images" aria-hidden="true"></i>
                <span>@Localizer["SelectImage"]</span>
            </button>
            <button type="button"
                    class="btn btn-ghost"
                    data-avatar-clear
                    data-target="#AvatarUrl"
                    data-gravatar="@gravatarUrl">
                <i class="fas fa-user-circle" aria-hidden="true"></i>
                <span>@Localizer["UseGravatar"]</span>
            </button>
        </div>
        <input asp-for="AvatarUrl" id="AvatarUrl" type="hidden" />
        <p class="admin-hint">@Localizer["AvatarHint"]</p>
        <span asp-validation-for="AvatarUrl" class="admin-field-error"></span>
        <div class="admin-upload-preview admin-avatar-preview" data-media-preview-for="#AvatarUrl" data-avatar-fallback="@gravatarUrl">
            <img src="@previewUrl" alt="" width="96" height="96" />
        </div>
    </div>

    <div class="admin-field">
        <label asp-for="PhoneNumber">@Localizer["PhoneNumber"]</label>
        <input asp-for="PhoneNumber" placeholder="09123456789" inputmode="numeric" autocomplete="tel" />
        <span asp-validation-for="PhoneNumber" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label asp-for="Password">@Localizer["Password"]</label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="admin-field-error"></span>
    </div>

    <fieldset class="admin-field">
        <legend>@Localizer["Roles"]</legend>
        @foreach (var role in Model.AvailableRoles)
        {
            <label class="admin-check">
                <input type="checkbox" name="SelectedRoles" value="@role.Value" checked="@role.Selected" />
                @role.Text
            </label>
        }
    </fieldset>

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
        <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
    </div>
</form>

<partial name="_MediaLibraryPicker" />

@section Scripts {
    <script src="~/admin/js/admin-avatar-field.js" asp-append-version="true"></script>
}
