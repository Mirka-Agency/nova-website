@model CMS.Web.Areas.Admin.ViewModels.CtaHelperPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["CtaHelper"];
    var phone = Model.PhoneDisplay;
    var phoneDigits = Model.PhoneDigits;
    var bookingPopupUrl = Model.BookingPopupUrl;
    var doctorsUrl = Model.DoctorsUrl;
    var servicesUrl = Model.ServicesUrl;
    var doctorImg = Model.DoctorImageUrl;
    var whatsapp = Model.WhatsAppUrl;
    var brand = Model.Brand;
}

<link rel="stylesheet" href="~/admin/css/cta-helper.css" asp-append-version="true" />

@section Scripts {
    <script src="~/admin/js/cta-helper.js" asp-append-version="true"></script>
    @if (Model.IsPopup)
    {
        <script>
            document.body.classList.add('is-cta-helper-popup');
        </script>
    }
}

<div class="cta-helper @(Model.IsPopup ? "cta-helper--popup" : null)" data-cta-helper>
    <div class="admin-page-header">
        <div class="admin-page-header-text">
            <p class="admin-hint">@Localizer["CtaHelperHint"]</p>
        </div>
    </div>

    <div class="cta-helper__intro">
        <h2>@Localizer["CtaHelperHowToTitle"]</h2>
        <p>@Localizer["CtaHelperHowToLead"]</p>
        <ol>
            <li>@Localizer["CtaHelperStep1"]</li>
            <li>@Localizer["CtaHelperStep2"]</li>
            <li>@Localizer["CtaHelperStep3"]</li>
        </ol>
    </div>

    <div class="cta-helper__edit-banner" data-cta-edit-banner hidden>
        <strong>در حال ویرایش CTA انتخاب‌شده</strong>
        <span>همهٔ انواع CTA را ببینید، یکی را انتخاب کنید و بعد ویرایش یا جایگزین کنید.</span>
    </div>

    <div class="cta-helper__picker" data-cta-picker>
        <label class="cta-helper__picker-label" for="cta-helper-select">@Localizer["CtaHelperJumpNav"]</label>
        <div class="cta-helper__grid" data-cta-grid role="listbox" aria-label="@Localizer["CtaHelperJumpNav"]">
            <button type="button" class="cta-helper__chip is-active" data-cta-pick="cta-appointment" role="option" aria-selected="true">
                <span class="cta-helper__chip-num">۱</span>
                <span class="cta-helper__chip-text">رزرو نوبت</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-consultation" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۲</span>
                <span class="cta-helper__chip-text">مشاوره</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-doctor" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۳</span>
                <span class="cta-helper__chip-text">معرفی پزشک</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-surgery" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۴</span>
                <span class="cta-helper__chip-text">جراحی</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-article-end" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۵</span>
                <span class="cta-helper__chip-text">انتهای مقاله</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-contact" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۶</span>
                <span class="cta-helper__chip-text">تماس سریع</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-inline" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۷</span>
                <span class="cta-helper__chip-text">میانه مقاله</span>
            </button>
            <button type="button" class="cta-helper__chip" data-cta-pick="cta-highlight" role="option" aria-selected="false">
                <span class="cta-helper__chip-num">۸</span>
                <span class="cta-helper__chip-text">هایلایت</span>
            </button>
        </div>
        <select id="cta-helper-select" class="cta-helper__select cta-helper__select--sr" data-cta-select aria-hidden="true" tabindex="-1">
            <option value="cta-appointment">۱) Appointment CTA — رزرو نوبت</option>
            <option value="cta-consultation">۲) Consultation CTA — مشاوره</option>
            <option value="cta-doctor">۳) Doctor CTA — معرفی پزشک</option>
            <option value="cta-surgery">۴) Surgery CTA — جراحی</option>
            <option value="cta-article-end">۵) Article End CTA — انتهای مقاله</option>
            <option value="cta-contact">۶) Contact CTA — تماس سریع</option>
            <option value="cta-inline">۷) Inline CTA — میانه مقاله</option>
            <option value="cta-highlight">۸) Highlight CTA — هایلایت</option>
        </select>
    </div>

    <!-- 1. Appointment -->
    <section class="cta-mod is-active" id="cta-appointment" data-module="appointment">
        <div class="cta-mod__head">
            <div class="cta-mod__titles">
                <h2>Appointment CTA</h2>
                <p class="cta-mod__desc">بنر گرادیانی برای دعوت به رزرو نوبت در صفحات خدمات و مقالات.</p>
            </div>
            <span class="cta-mod__badge">gradient · appointment</span>
        </div>
        <p class="cta-mod__label">پیش‌نمایش زنده</p>
        <div class="cta-mod__preview" data-preview></div>
        <p class="cta-mod__label">تنظیمات</p>
        <div class="cta-mod__settings">
            <div>
                <label for="cta1-eyebrow">Eyebrow</label>
                <input id="cta1-eyebrow" data-key="eyebrow" value="رزرو نوبت" />
            </div>
            <div>
                <label for="cta1-title">Title</label>
                <input id="cta1-title" data-key="title" value="همین امروز نوبت مشاوره تخصصی بگیرید" />
            </div>
            <div class="span-2">
                <label for="cta1-description">Description</label>
                <textarea id="cta1-description" data-key="description" rows="2">در @brand مسیر تشخیص و درمان بیماری‌های غدد، با همراهی تیم تخصصی هماهنگ می‌شود.</textarea>
            </div>
            <div class="span-2 cta-mod__buttons-panel">
                <div class="cta-mod__buttons-head">
                    <div>
                        <strong>دکمه‌ها</strong>
                        <p class="admin-hint">تا ۴ دکمه اضافه یا حذف کنید.</p>
                    </div>
                    <button type="button" class="btn btn-secondary" data-cta-add-btn>افزودن دکمه</button>
                </div>
                <div class="cta-mod__buttons" data-cta-buttons data-default-style="outline">
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۱</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="رزرو نوبت" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="@bookingPopupUrl" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary">اصلی</option>
                                    <option value="secondary">ثانویه</option>
                                    <option value="light" selected>روشن (پس‌زمینه تیره)</option>
                                    <option value="outline">حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone">تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۲</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="تماس با کلینیک" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="tel:@phoneDigits" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary">اصلی</option>
                                    <option value="secondary">ثانویه</option>
                                    <option value="light">روشن (پس‌زمینه تیره)</option>
                                    <option value="outline" selected>حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone">تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="cta-mod__actions">
            <button type="button" class="btn btn-primary" data-insert>درج در ادیتور</button>
            <button type="button" class="btn btn-secondary" data-insert-new hidden>درج به‌عنوان CTA جدید</button>
            <button type="button" class="btn btn-secondary" data-copy>کپی HTML</button>
            <span class="cta-mod__feedback" data-feedback>کپی شد</span>
        </div>
        <textarea class="cta-mod__code" data-code readonly aria-label="HTML خروجی Appointment CTA"></textarea>
    </section>

    <!-- 2. Consultation -->
    <section class="cta-mod" id="cta-consultation" data-module="consultation" hidden>
        <div class="cta-mod__head">
            <div class="cta-mod__titles">
                <h2>Consultation CTA</h2>
                <p class="cta-mod__desc">کارت روشن برای درخواست مشاوره همراه با شماره تماس.</p>
            </div>
            <span class="cta-mod__badge">light · consultation</span>
        </div>
        <p class="cta-mod__label">پیش‌نمایش زنده</p>
        <div class="cta-mod__preview" data-preview></div>
        <p class="cta-mod__label">تنظیمات</p>
        <div class="cta-mod__settings">
            <div class="span-2">
                <label for="cta2-title">Title</label>
                <input id="cta2-title" data-key="title" value="نیاز به مشاوره تخصصی دارید؟" />
            </div>
            <div class="span-2">
                <label for="cta2-description">Description</label>
                <textarea id="cta2-description" data-key="description" rows="2">سوالات مربوط به تیروئید، پاراتیروئید و غدد فوق کلیوی را با تیم @brand مطرح کنید.</textarea>
            </div>
            <div class="span-2 cta-mod__buttons-panel">
                <div class="cta-mod__buttons-head">
                    <div>
                        <strong>دکمه‌ها</strong>
                        <p class="admin-hint">تا ۴ دکمه اضافه یا حذف کنید.</p>
                    </div>
                    <button type="button" class="btn btn-secondary" data-cta-add-btn>افزودن دکمه</button>
                </div>
                <div class="cta-mod__buttons" data-cta-buttons data-default-style="phone">
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۱</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="درخواست مشاوره" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="@bookingPopupUrl" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary" selected>اصلی</option>
                                    <option value="secondary">ثانویه</option>
                                    <option value="light">روشن (پس‌زمینه تیره)</option>
                                    <option value="outline">حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone">تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۲</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="مشاوره تلفنی" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="tel:@phoneDigits" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary">اصلی</option>
                                    <option value="secondary">ثانویه</option>
                                    <option value="light">روشن (پس‌زمینه تیره)</option>
                                    <option value="outline">حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone" selected>تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="cta-mod__actions">
            <button type="button" class="btn btn-primary" data-insert>درج در ادیتور</button>
            <button type="button" class="btn btn-secondary" data-insert-new hidden>درج به‌عنوان CTA جدید</button>
            <button type="button" class="btn btn-secondary" data-copy>کپی HTML</button>
            <span class="cta-mod__feedback" data-feedback>کپی شد</span>
        </div>
        <textarea class="cta-mod__code" data-code readonly aria-label="HTML خروجی Consultation CTA"></textarea>
    </section>

    <!-- 3. Doctor -->
    <section class="cta-mod" id="cta-doctor" data-module="doctor" hidden>
        <div class="cta-mod__head">
            <div class="cta-mod__titles">
                <h2>Doctor CTA</h2>
                <p class="cta-mod__desc">معرفی دکتر کاوه همدانی با تصویر، تخصص و دو دکمه اقدام.</p>
            </div>
            <span class="cta-mod__badge">doctor image · split</span>
        </div>
        <p class="cta-mod__label">پیش‌نمایش زنده</p>
        <div class="cta-mod__preview" data-preview></div>
        <p class="cta-mod__label">تنظیمات</p>
        <div class="cta-mod__settings">
            <div class="span-2 cta-mod__media-field">
                <label for="cta3-image">Doctor Image</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#cta3-image">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input id="cta3-image" data-key="image" type="hidden" value="@doctorImg" />
                <p class="admin-hint">@Localizer["SelectImageHint"]</p>
                <div class="admin-upload-preview cta-mod__media-preview" data-media-preview-for="#cta3-image">
                    @if (!string.IsNullOrWhiteSpace(doctorImg))
                    {
                        <img src="@doctorImg" alt="" />
                    }
                </div>
            </div>
            <div>
                <label for="cta3-name">Doctor Name</label>
                <input id="cta3-name" data-key="name" value="دکتر کاوه همدانی" />
            </div>
            <div>
                <label for="cta3-specialty">Specialty</label>
                <input id="cta3-specialty" data-key="specialty" value="فلوشیپ جراحی غدد درون‌ریز" />
            </div>
            <div class="span-2">
                <label for="cta3-description">Description</label>
                <textarea id="cta3-description" data-key="description" rows="2">مدیر @brand؛ تمرکز بر جراحی تیروئید، پاراتیروئید و غدد فوق کلیوی با رویکرد تخصصی و دقیق.</textarea>
            </div>
            <div class="span-2 cta-mod__buttons-panel">
                <div class="cta-mod__buttons-head">
                    <div>
                        <strong>دکمه‌ها</strong>
                        <p class="admin-hint">تا ۴ دکمه اضافه یا حذف کنید.</p>
                    </div>
                    <button type="button" class="btn btn-secondary" data-cta-add-btn>افزودن دکمه</button>
                </div>
                <div class="cta-mod__buttons" data-cta-buttons data-default-style="secondary">
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۱</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="مشاهده پروفایل" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="@doctorsUrl" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary" selected>اصلی</option>
                                    <option value="secondary">ثانویه</option>
                                    <option value="light">روشن (پس‌زمینه تیره)</option>
                                    <option value="outline">حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone">تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cta-mod__btn-row" data-cta-btn-row>
                        <div class="cta-mod__btn-row-head">
                            <span class="cta-mod__btn-row-title">دکمه ۲</span>
                            <button type="button" class="btn btn-ghost cta-mod__btn-remove" data-cta-remove-btn>حذف</button>
                        </div>
                        <div class="cta-mod__btn-fields">
                            <div>
                                <label>متن دکمه</label>
                                <input type="text" data-btn-text value="رزرو نوبت" />
                            </div>
                            <div>
                                <label>لینک <span class="admin-hint">(popup:booking = پاپ‌آپ رزرو)</span></label>
                                <input type="text" data-btn-url dir="ltr" value="@bookingPopupUrl" />
                            </div>
                            <div>
                                <label>سبک</label>
                                <select data-btn-style>
                                    <option value="primary">اصلی</option>
                                    <option value="secondary" selected>ثانویه</option>
                                    <option value="light">روشن (پس‌زمینه تیره)</option>
                                    <option value="outline">حاشیه‌دار (پس‌زمینه تیره)</option>
                                    <option value="compact">فشرده</option>
                                    <option value="phone">تلفن</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="cta-mod__actions">
            <button type="button" class="btn btn-primary" data-insert>درج در ادیتور</button>
            <button type="button" class="btn btn-secondary" data-insert-new hidden>درج به‌عنوان CTA جدید</button>
            <button type="button" class="btn btn-secondary" data-copy>کپی HTML</button>
            <span class="cta-mod__feedback" data-feedback>کپی شد</span>
        </div>
        <textarea class="cta-mod__code" data-code readonly aria-label="HTML خروجی Doctor CTA"></textarea>
    </section>

    <!-- 4. Surgery -->
    <section class="cta-mod" id="cta-surgery" data-module="surgery" hidden>
        <div class="cta-mod__head">
            <div class="cta-mod__titles">
                <h2>Surgery CTA</h2>
                <p class="cta-mod__desc">مناسب صفحات جراحی تیروئید، پاراتیروئید و آدرنال.</p>
            </div>
            <span class="cta-mod__badge">split · surgery</span>
        </div>
        <p class="cta-mod__label">پیش‌نمایش زنده</p>
        <div class="cta-mod__preview" data-preview></div>
        <p class="cta-mod__label">تنظیمات</p>
        <div class="cta-mod__settings">
            <div>
                <label for="cta4-badge">Badge</label>
                <input id="cta4-badge" data-key="badge" value="جراحی تخصصی" />
            </div>
            <div>
                <label for="cta4-serviceName">Service Name</label>
                <input id="cta4-serviceName" data-key="serviceName" value="جراحی تیروئید" />
            </div>
            <div class="span-2">
                <label for="cta4-title">Title</label>
                <input id="cta4-title" data-key="title" value="تصمیم برای جراحی را با ارزیابی تخصصی بگیرید" />
            </div>
