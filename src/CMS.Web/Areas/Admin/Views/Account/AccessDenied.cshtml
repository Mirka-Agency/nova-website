@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["AccessDeniedTitle"];
    Layout = "_AdminAuthLayout";
}

<div class="admin-auth-card">
    <h1 class="admin-auth-title">@Localizer["AccessDeniedTitle"]</h1>
    <p class="admin-lead">@Localizer["AccessDeniedMessage"]</p>
    <a class="btn btn-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["BackToDashboard"]</a>
</div>
