@model CMS.Web.Areas.Admin.ViewModels.ChangePasswordViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["ChangePassword"];
}

<form asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" method="post" class="admin-form admin-form-narrow">
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-field">
        <label asp-for="CurrentPassword">@Localizer["CurrentPassword"]</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label asp-for="NewPassword">@Localizer["NewPassword"]</label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="admin-field-error"></span>
    </div>

    <div class="admin-field">
        <label asp-for="ConfirmPassword">@Localizer["ConfirmPassword"]</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="admin-field-error"></span>
    </div>

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
    </div>
</form>
