@model CMS.Web.Areas.Admin.ViewModels.SiteSettingsFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["SiteSettings"];
}

<form asp-action="Index" method="post" class="admin-form admin-form-wide">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <fieldset class="admin-field">
        <legend>@Localizer["SettingsSectionIdentity"]</legend>
        <div class="admin-field">
            <label asp-for="SiteName">@Localizer["SiteName"]</label>
            <input asp-for="SiteName" />
            <span asp-validation-for="SiteName" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Tagline">@Localizer["Tagline"]</label>
            <input asp-for="Tagline" />
            <span asp-validation-for="Tagline" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label>@Localizer["LogoUrl"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#LogoUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="LogoUrl" id="LogoUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="LogoUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#LogoUrl">
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="" />
                }
            </div>
        </div>
        <div class="admin-field">
            <label>@Localizer["FaviconUrl"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#FaviconUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="FaviconUrl" id="FaviconUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="FaviconUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#FaviconUrl">
                @if (!string.IsNullOrWhiteSpace(Model.FaviconUrl))
                {
                    <img src="@Model.FaviconUrl" alt="" />
                }
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-field">
        <legend>@Localizer["SettingsSectionContact"]</legend>
        <div class="admin-field">
            <label asp-for="ContactEmail">@Localizer["ContactEmail"]</label>
            <input asp-for="ContactEmail" />
            <span asp-validation-for="ContactEmail" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="ContactPhone">@Localizer["ContactPhone"]</label>
            <input asp-for="ContactPhone" />
            <span asp-validation-for="ContactPhone" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Address">@Localizer["Address"]</label>
            <textarea asp-for="Address" rows="3"></textarea>
            <span asp-validation-for="Address" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="BusinessHours">@Localizer["BusinessHours"]</label>
            <input asp-for="BusinessHours" />
            <p class="admin-hint">@Localizer["BusinessHoursHint"]</p>
            <span asp-validation-for="BusinessHours" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="FooterText">@Localizer["FooterText"]</label>
            <input asp-for="FooterText" />
            <span asp-validation-for="FooterText" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="PrivacyHtml">@Localizer["PrivacyHtml"]</label>
            <textarea asp-for="PrivacyHtml"
                      rows="10"
                      class="admin-ckeditor-source"></textarea>
            <p class="admin-hint">@Localizer["PrivacyHtmlHint"]</p>
            <span asp-validation-for="PrivacyHtml" class="admin-field-error"></span>
        </div>
    </fieldset>

    <fieldset class="admin-field">
        <legend>@Localizer["SettingsSectionSeo"]</legend>
        <div class="admin-field">
            <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
            <input asp-for="MetaTitle" />
            <span class="admin-help">@Localizer["MetaTitleHelp"]</span>
            <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
            <textarea asp-for="MetaDescription" rows="3"></textarea>
            <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="DefaultOgImageUrl">@Localizer["DefaultOgImageUrl"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#DefaultOgImageUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="DefaultOgImageUrl" id="DefaultOgImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="DefaultOgImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#DefaultOgImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.DefaultOgImageUrl))
                {
                    <img src="@Model.DefaultOgImageUrl" alt="" />
                }
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-field">
        <legend>@Localizer["SettingsSectionSocial"]</legend>
        <div class="admin-field">
            <label asp-for="InstagramUrl">@Localizer["InstagramUrl"]</label>
            <input asp-for="InstagramUrl" class="admin-input-ltr" dir="ltr" placeholder="https://instagram.com/..." />
            <span asp-validation-for="InstagramUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="TelegramUrl">@Localizer["TelegramUrl"]</label>
            <input asp-for="TelegramUrl" class="admin-input-ltr" dir="ltr" placeholder="https://t.me/..." />
            <span asp-validation-for="TelegramUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="TwitterUrl">@Localizer["TwitterUrl"]</label>
            <input asp-for="TwitterUrl" class="admin-input-ltr" dir="ltr" placeholder="https://x.com/..." />
            <span asp-validation-for="TwitterUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="LinkedInUrl">@Localizer["LinkedInUrl"]</label>
            <input asp-for="LinkedInUrl" class="admin-input-ltr" dir="ltr" placeholder="https://linkedin.com/..." />
            <span asp-validation-for="LinkedInUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="AparatUrl">@Localizer["AparatUrl"]</label>
            <input asp-for="AparatUrl" class="admin-input-ltr" dir="ltr" placeholder="https://www.aparat.com/..." />
            <span asp-validation-for="AparatUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="FacebookUrl">@Localizer["FacebookUrl"]</label>
            <input asp-for="FacebookUrl" class="admin-input-ltr" dir="ltr" placeholder="https://facebook.com/..." />
            <span asp-validation-for="FacebookUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="YouTubeUrl">@Localizer["YouTubeUrl"]</label>
            <input asp-for="YouTubeUrl" class="admin-input-ltr" dir="ltr" placeholder="https://youtube.com/..." />
            <span asp-validation-for="YouTubeUrl" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="WhatsAppUrl">@Localizer["WhatsAppUrl"]</label>
            <input asp-for="WhatsAppUrl" class="admin-input-ltr" dir="ltr" placeholder="https://wa.me/98..." />
            <span asp-validation-for="WhatsAppUrl" class="admin-field-error"></span>
        </div>
    </fieldset>

    <fieldset class="admin-field">
        <legend>@Localizer["SettingsSectionAdvanced"]</legend>
        <div class="admin-field admin-check">
            <label>
                <input asp-for="MaintenanceMode" />
                @Localizer["MaintenanceMode"]
            </label>
            <span class="admin-help">@Localizer["MaintenanceModeHelp"]</span>
        </div>
        <div class="admin-field">
            <label asp-for="MaintenanceMessage">@Localizer["MaintenanceMessage"]</label>
            <textarea asp-for="MaintenanceMessage" rows="2"></textarea>
            <span asp-validation-for="MaintenanceMessage" class="admin-field-error"></span>
        </div>
    </fieldset>

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
    </div>
</form>

<partial name="_MediaLibraryPicker" />