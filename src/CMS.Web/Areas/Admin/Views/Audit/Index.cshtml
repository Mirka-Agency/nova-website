@model IReadOnlyList<CMS.Application.Audit.AuditEntryDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<CMS.Web.AdminShared> Localizer
@{
    ViewData["Title"] = Localizer["AuditLog"];
}

@if (Model.Count == 0)
{
    var empty = new CMS.Web.Areas.Admin.ViewModels.EmptyStateViewModel(Localizer["AuditEmpty"].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>@Localizer["Time"]</th>
                <th>@Localizer["User"]</th>
                <th>@Localizer["Action"]</th>
                <th>@Localizer["Entity"]</th>
                <th>@Localizer["Details"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@CMS.Application.Common.Time.IranTime.Format(entry.CreatedAtUtc)</td>
                <td>@(entry.UserEmail ?? "—")</td>
                <td>@entry.Action</td>
                <td>@entry.EntityType @(entry.EntityId is not null ? $"({entry.EntityId})" : "")</td>
                <td>@(entry.Details ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" />
}
