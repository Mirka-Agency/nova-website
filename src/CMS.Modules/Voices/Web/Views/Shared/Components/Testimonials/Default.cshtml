@model CMS.Modules.Voices.Web.ViewModels.TestimonialsSectionViewModel
@using System.Globalization
@{
    var brand = Model.Brand;
    var voices = Model.Voices;
    var hasCmsVoices = Model.HasCmsVoices;
}
<section class="testimonials-section" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <p class="section-kicker">بازخورد</p>
      <h2 class="section-heading" id="testimonials-heading">نظرات مراجعین</h2>
      <p class="section-lead">متن و صدای تجربه بیماران از روند درمان در نووا کلینیک.</p>
    </div>

    <div class="testimonials-slider reveal" data-testimonials-slider>
      <div class="testimonials-slider__viewport" tabindex="0" aria-label="نظرات مراجعین">
        <div class="testimonials-slider__track">
@if (hasCmsVoices)
{
    foreach (var voice in voices)
    {
        var role = string.IsNullOrWhiteSpace(voice.Subtitle) ? "مراجع نووا کلینیک" : voice.Subtitle!;
        var quote = string.IsNullOrWhiteSpace(voice.Description)
            ? $"تجربه {voice.CustomerName} از روند درمان در {brand}."
            : voice.Description!;
          <div class="testimonial-slide">
            <article class="testimonial-card" data-voice-card data-audio-src="@voice.AudioUrl">
              <header class="testimonial-card__header">
                <span class="testimonial-card__avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
                  </svg>
                </span>
                <div class="testimonial-card__identity">
                  <p class="testimonial-card__author">@voice.CustomerName</p>
                  <p class="testimonial-card__role">@role</p>
                </div>
              </header>
              <p class="testimonial-card__quote">@quote</p>
              <div class="testimonial-voice">
                <button class="testimonial-voice__play" type="button" aria-label="پخش ویس @voice.CustomerName" data-voice-play>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.14v13.72L19 12 8 5.14z"/>
                  </svg>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 5h3.5v14H7V5zm6.5 0H17v14h-3.5V5z"/>
                  </svg>
                </button>
                <div class="testimonial-voice__body">
                  <div class="testimonial-voice__progress" aria-hidden="true">
                    <span class="testimonial-voice__progress-bar" data-voice-progress></span>
                  </div>
                </div>
                <span class="testimonial-voice__time" data-voice-current>۰:۰۰</span>
                <span class="visually-hidden" data-voice-total>۰:۰۰</span>
              </div>
            </article>
          </div>
    }
}
else
{
          <div class="testimonial-slide">
            <article class="testimonial-card" data-voice-card data-duration="42">
              <header class="testimonial-card__header">
                <span class="testimonial-card__avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
                  </svg>
                </span>
                <div class="testimonial-card__identity">
                  <p class="testimonial-card__author">مریم احمدی</p>
                  <p class="testimonial-card__role">مراجع نووا کلینیک</p>
                </div>
              </header>
              <p class="testimonial-card__quote">
                من آدم خیلی حساسی‌ام و همیشه از درمان‌های پزشکی می‌ترسیدم، ولی تجربه‌ای که اینجا داشتم فراتر از انتظارم بود. برخورد پرسنل گرم بود و دکتر همه چیز را واضح توضیح داد.
              </p>
              <div class="testimonial-voice">
                <button class="testimonial-voice__play" type="button" aria-label="پخش ویس مریم احمدی" data-voice-play>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.14v13.72L19 12 8 5.14z"/>
                  </svg>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 5h3.5v14H7V5zm6.5 0H17v14h-3.5V5z"/>
                  </svg>
                </button>
                <div class="testimonial-voice__body">
                  <div class="testimonial-voice__progress" aria-hidden="true">
                    <span class="testimonial-voice__progress-bar" data-voice-progress></span>
                  </div>
                </div>
                <span class="testimonial-voice__time" data-voice-current>۰:۴۲</span>
                <span class="visually-hidden" data-voice-total>۰:۴۲</span>
              </div>
            </article>
          </div>

          <div class="testimonial-slide">
            <article class="testimonial-card" data-voice-card data-duration="68">
              <header class="testimonial-card__header">
                <span class="testimonial-card__avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
                  </svg>
                </span>
                <div class="testimonial-card__identity">
                  <p class="testimonial-card__author">حسین مرادی</p>
                  <p class="testimonial-card__role">مراجع نووا کلینیک</p>
                </div>
              </header>
              <p class="testimonial-card__quote">
                چند جا برای مشکلم مراجعه کرده بودم ولی راهنمایی درستی نگرفتم. اینجا دکتر با حوصله توضیح داد مشکلم چیست و چه درمانی لازم دارم. حس می‌کنم جای مطمئنی پیدا کردم.
              </p>
              <div class="testimonial-voice">
                <button class="testimonial-voice__play" type="button" aria-label="پخش ویس حسین مرادی" data-voice-play>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.14v13.72L19 12 8 5.14z"/>
                  </svg>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 5h3.5v14H7V5zm6.5 0H17v14h-3.5V5z"/>
                  </svg>
                </button>
                <div class="testimonial-voice__body">
                  <div class="testimonial-voice__progress" aria-hidden="true">
                    <span class="testimonial-voice__progress-bar" data-voice-progress></span>
                  </div>
                </div>
                <span class="testimonial-voice__time" data-voice-current>۱:۰۸</span>
                <span class="visually-hidden" data-voice-total>۱:۰۸</span>
              </div>
            </article>
          </div>

          <div class="testimonial-slide">
            <article class="testimonial-card" data-voice-card data-duration="55">
              <header class="testimonial-card__header">
                <span class="testimonial-card__avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
                  </svg>
                </span>
                <div class="testimonial-card__identity">
                  <p class="testimonial-card__author">زهرا کیانی</p>
                  <p class="testimonial-card__role">مراجع نووا کلینیک</p>
                </div>
              </header>
              <p class="testimonial-card__quote">
                از لحظه ورود، برخورد پرسنل محترمانه بود. دکترها کاربلد بودند و با حوصله به سوال‌ها جواب دادند. همه‌چیز حرفه‌ای و در عین حال دوستانه بود.
              </p>
              <div class="testimonial-voice">
                <button class="testimonial-voice__play" type="button" aria-label="پخش ویس زهرا کیانی" data-voice-play>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.14v13.72L19 12 8 5.14z"/>
                  </svg>
                  <svg class="testimonial-voice__icon testimonial-voice__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 5h3.5v14H7V5zm6.5 0H17v14h-3.5V5z"/>
                  </svg>
                </button>
                <div class="testimonial-voice__body">
                  <div class="testimonial-voice__progress" aria-hidden="true">
                    <span class="testimonial-voice__progress-bar" data-voice-progress></span>
                  </div>
                </div>
                <span class="testimonial-voice__time" data-voice-current>۰:۵۵</span>
                <span class="visually-hidden" data-voice-total>۰:۵۵</span>
              </div>
            </article>
          </div>
}
        </div>
      </div>
      <div class="testimonials-slider__controls">
        <button class="testimonials-slider__button" type="button" data-testimonials-prev aria-label="نظر قبلی">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
        <span class="testimonials-slider__counter" data-testimonials-counter aria-live="polite">۱ / @(hasCmsVoices ? voices.Count.ToString(CultureInfo.InvariantCulture) : "۳")</span>
        <button class="testimonials-slider__button" type="button" data-testimonials-next aria-label="نظر بعدی">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
