@model VoiceItemFormViewModel

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        <div class="admin-field">
            <label asp-for="CustomerName">@Localizer["CustomerName"]</label>
            <input asp-for="CustomerName" />
            <span asp-validation-for="CustomerName" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Subtitle">@Localizer["Subtitle"]</label>
            <input asp-for="Subtitle" />
            <p class="admin-hint">@Localizer["SubtitleHint"]</p>
            <span asp-validation-for="Subtitle" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Description">@Localizer["Description"]</label>
            <textarea asp-for="Description" rows="5"></textarea>
            <p class="admin-hint">@Localizer["DescriptionHint"]</p>
            <span asp-validation-for="Description" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="SortOrder">@Localizer["SortOrder"]</label>
            <input asp-for="SortOrder" type="number" />
            <p class="admin-hint">@Localizer["SortOrderHint"]</p>
            <span asp-validation-for="SortOrder" class="admin-field-error"></span>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field"
             data-voice-audio
             data-upload-url="@Url.Action("UploadAudio", "VoicesMedia", new { area = "Admin" })">
            <label>@Localizer["Audio"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-voice-upload-btn>
                    <i class="fas fa-upload" aria-hidden="true"></i>
                    <span>@Localizer["UploadAudio"]</span>
                </button>
                <button type="button"
                        class="btn btn-ghost"
                        data-voice-clear-btn
                        @(string.IsNullOrWhiteSpace(Model.AudioUrl) ? "hidden" : null)>
                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                    <span>@Localizer["RemoveAudio"]</span>
                </button>
                <input type="file"
                       accept=".mp3,.m4a,.aac,.ogg,.wav,.webm,audio/mpeg,audio/mp3,audio/mp4,audio/aac,audio/ogg,audio/wav,audio/webm,audio/x-m4a"
                       data-voice-upload-input
                       hidden />
            </div>
            <input asp-for="AudioUrl" id="AudioUrl" type="hidden" data-voice-url />
            <p class="admin-hint">@Localizer["AudioHint"]</p>
            <span asp-validation-for="AudioUrl" class="admin-field-error"></span>
            <p class="admin-field-error" data-voice-upload-error hidden></p>
            <div class="admin-upload-preview" data-voice-preview>
                @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
                {
                    <audio controls preload="metadata" src="@Model.AudioUrl" data-voice-player></audio>
                }
            </div>
        </div>

        <label class="admin-check">
            <input asp-for="IsPublished" />
            @Localizer["Publish"]
        </label>
    </aside>
</div>
