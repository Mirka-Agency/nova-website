@model IReadOnlyList<CMS.Modules.Popup.Application.Popups.PublicPopupDto>
@using System.Text.RegularExpressions
@using CMS.Application.Common.Features
@using CMS.Application.Settings
@using CMS.Modules.Popup.Domain.Enums
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager
@inject ISiteSettingsService SiteSettings
@{
    var formsEnabled = await FeatureManager.IsEnabledAsync(FeatureNames.Forms);
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
}

<link rel="stylesheet" href="~/site/css/popup.css" asp-append-version="true" />

<div id="cms-popup-host" class="cms-popup-host" data-cms-popup-host hidden>
@foreach (var popup in Model)
{
    var frequency = popup.Frequency switch
    {
        PopupFrequency.EveryVisit => "every_visit",
        PopupFrequency.OncePerSession => "once_session",
        PopupFrequency.OncePerBrowser => "once_browser",
        _ => "always"
    };
    var ctaAction = PopupCtaActions.Normalize(popup.CtaAction);
    var hasCta = ctaAction != PopupCtaActions.None && !string.IsNullOrWhiteSpace(popup.CtaText);
    var isBooking = string.Equals(popup.Slug, "booking", StringComparison.OrdinalIgnoreCase);
    var popupClass = isBooking ? "cms-popup cms-popup--booking" : "cms-popup";

    <div class="@popupClass"
         id="cms-popup-@popup.Slug"
         data-cms-popup
         data-popup-id="@popup.Id"
         data-popup-slug="@popup.Slug"
         data-trigger="@popup.TriggerType"
         data-trigger-delay="@(popup.TriggerDelaySeconds ?? 0)"
         data-trigger-scroll="@(popup.TriggerScrollPercent ?? 0)"
         data-trigger-selector="@(popup.TriggerSelector ?? "")"
         data-frequency="@frequency"
         data-show-overlay="@(popup.ShowOverlay ? "true" : "false")"
         data-show-close="@(popup.ShowCloseButton ? "true" : "false")"
         data-close-overlay="@(popup.CloseOnOverlayClick ? "true" : "false")"
         data-close-esc="@(popup.CloseOnEscape ? "true" : "false")"
         data-lock-scroll="@(popup.LockBodyScroll ? "true" : "false")"
         data-content-scroll="@(popup.EnableContentScroll ? "true" : "false")"
         hidden
         role="dialog"
         aria-modal="true"
         aria-labelledby="cms-popup-title-@popup.Slug">
        <div class="cms-popup__backdrop" data-popup-backdrop @(popup.ShowOverlay ? null : "hidden")></div>
        <div class="cms-popup__dialog @(!isBooking && popup.EnableContentScroll ? "cms-popup__dialog--scroll" : null)">
            @if (popup.ShowCloseButton)
            {
                <button type="button" class="cms-popup__close" data-popup-close aria-label="بستن">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
            }
            <div class="cms-popup__body" data-popup-content>
                <h2 class="cms-popup__title" id="cms-popup-title-@popup.Slug">@popup.Title</h2>
                @if (!string.IsNullOrWhiteSpace(popup.ImageUrl))
                {
                    <div class="cms-popup__image">
                        <img src="@popup.ImageUrl" alt="" loading="lazy" />
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(popup.BodyText))
                {
                    <div class="cms-popup__text">@popup.BodyText</div>
                }
                @if (!string.IsNullOrWhiteSpace(popup.ContentHtml))
                {
                    <div class="cms-popup__content">@Html.Raw(popup.ContentHtml)</div>
                }
                @if (hasCta)
                {
                    if (ctaAction == PopupCtaActions.Url && !string.IsNullOrWhiteSpace(popup.CtaUrl))
                    {
                        <a class="cms-popup__cta" href="@popup.CtaUrl">@popup.CtaText</a>
                    }
                    else if (ctaAction == PopupCtaActions.Close)
                    {
                        <button type="button" class="cms-popup__cta" data-popup-close>@popup.CtaText</button>
                    }
                    else if (ctaAction == PopupCtaActions.OpenPopup && !string.IsNullOrWhiteSpace(popup.CtaTargetPopupSlug))
                    {
                        <button type="button"
                                class="cms-popup__cta"
                                data-popup-open="@popup.CtaTargetPopupSlug"
                                data-popup-close-current="true">@popup.CtaText</button>
                    }
                }
                @if (popup.FormId.HasValue && formsEnabled)
                {
                    <div class="cms-popup__form @(isBooking ? "booking-form booking-form--cms" : null)" data-popup-form>
                        @await Component.InvokeAsync("FormEmbed", new { id = popup.FormId.Value })
                        @if (isBooking)
                        {
                            <p class="booking-form__note">
                                یا مستقیم تماس بگیرید:
                                <a class="phone-ltr" href="@telHref">@phoneDisplay</a>
                            </p>
                        }
                    </div>
                }
            </div>
            @if (popup.FormId.HasValue && formsEnabled)
            {
                <div class="booking-success" data-popup-success hidden>
                    <div class="booking-success__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="m8.5 12.5 2.2 2.2 4.8-5"/>
                        </svg>
                    </div>
                    <h3 class="booking-success__title">@(isBooking ? "درخواست شما ثبت شد" : "فرم با موفقیت ثبت شد")</h3>
                    <p class="booking-success__text" data-popup-success-text>@(isBooking ? "به‌زودی برای هماهنگی نوبت با شما تماس می‌گیریم." : "پیام شما دریافت شد. به‌زودی با شما تماس می‌گیریم.")</p>
                    <button class="btn-primary-custom" type="button" data-popup-close>بستن</button>
                </div>
            }
        </div>
    </div>
}
</div>
