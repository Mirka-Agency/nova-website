@model ShippingMethodFormViewModel
@{ ViewData["Title"] = Localizer["EditShippingMethod"]; }
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form admin-form-wide">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_ShippingMethodForm" model="Model" />
    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
        <a class="btn btn-secondary" asp-action="Index">@Localizer["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/iran-location-select.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin-price-input.js" asp-append-version="true"></script>
}
