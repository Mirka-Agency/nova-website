@model OrderIndexViewModel
@using CMS.Modules.Shop.Domain.Enums

<div class="admin-field">
    <label for="order-filter-status">@Localizer["Status"]</label>
    <select id="order-filter-status" name="status">
        <option value="">@Localizer["AllStatuses"]</option>
        <optgroup label="@Localizer["Orders"]">
            @{
                var statusGroups = new (string Value, string Key)[]
                {
                    ("pending", "OrdersPending"),
                    ("processing", "OrdersProcessing"),
                    ("shipped", "OrdersShipped"),
                    ("completed", "OrdersCompleted"),
                    ("cancelled", "OrdersCancelled")
                };
            }
            @foreach (var opt in statusGroups)
            {
                if (string.Equals(Model.Status, opt.Value, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@opt.Value" selected>@Localizer[opt.Key]</option>
                }
                else
                {
                    <option value="@opt.Value">@Localizer[opt.Key]</option>
                }
            }
        </optgroup>
        <optgroup label="@Localizer["Status"]">
            @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                var value = s.ToString();
                var label = s switch
                {
                    OrderStatus.Pending => Localizer["StatusPendingPayment"].Value,
                    OrderStatus.Reviewing => Localizer["StatusReviewing"].Value,
                    OrderStatus.Approved => Localizer["StatusApproved"].Value,
                    OrderStatus.Processing => Localizer["StatusProcessing"].Value,
                    OrderStatus.ReadyForShipping => Localizer["StatusReadyForShipping"].Value,
                    OrderStatus.Shipped => Localizer["StatusShipped"].Value,
                    OrderStatus.Completed => Localizer["StatusCompleted"].Value,
                    OrderStatus.Cancelled => Localizer["StatusCancelled"].Value,
                    _ => value
                };
                if (string.Equals(Model.Status, value, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@value" selected>@label</option>
                }
                else
                {
                    <option value="@value">@label</option>
                }
            }
        </optgroup>
    </select>
</div>

<div class="admin-field">
    <label for="order-filter-payment-status">@Localizer["PaymentStatus"]</label>
    <select id="order-filter-payment-status" name="paymentStatus">
        <option value="">@Localizer["AllPaymentStatuses"]</option>
        @foreach (PaymentStatus s in Enum.GetValues<PaymentStatus>())
        {
            var label = s switch
            {
                PaymentStatus.Unpaid => Localizer["PaymentStatusUnpaid"].Value,
                PaymentStatus.Paid => Localizer["PaymentStatusPaid"].Value,
                PaymentStatus.InvoiceRequested => Localizer["PaymentStatusInvoiceRequested"].Value,
                _ => s.ToString()
            };
            if (Model.PaymentStatus == s)
            {
                <option value="@s" selected>@label</option>
            }
            else
            {
                <option value="@s">@label</option>
            }
        }
    </select>
</div>

<div class="admin-field">
    <label for="order-filter-payment-method">@Localizer["PaymentMethod"]</label>
    <select id="order-filter-payment-method" name="paymentMethod">
        <option value="">@Localizer["AllPaymentMethods"]</option>
        @foreach (PaymentMethod m in Enum.GetValues<PaymentMethod>())
        {
            var label = m switch
            {
                PaymentMethod.Online => Localizer["PaymentMethodOnline"].Value,
                PaymentMethod.BankTransfer => Localizer["PaymentMethodBankTransfer"].Value,
                PaymentMethod.CashOnDelivery => Localizer["PaymentMethodCashOnDelivery"].Value,
                PaymentMethod.Invoice => Localizer["PaymentMethodInvoice"].Value,
                PaymentMethod.PayLater => Localizer["PaymentMethodPayLater"].Value,
                PaymentMethod.SnapPay => Localizer["PaymentMethodSnapPay"].Value,
                _ => m.ToString()
            };
            if (Model.PaymentMethod == m)
            {
                <option value="@m" selected>@label</option>
            }
            else
            {
                <option value="@m">@label</option>
            }
        }
    </select>
</div>

<div class="admin-field">
    <label for="order-filter-wholesale">@Localizer["IsWholesale"]</label>
    <select id="order-filter-wholesale" name="isWholesale">
        <option value="">@Localizer["All"]</option>
        @if (Model.IsWholesale == true)
        {
            <option value="true" selected>@Localizer["Yes"]</option>
        }
        else
        {
            <option value="true">@Localizer["Yes"]</option>
        }
        @if (Model.IsWholesale == false)
        {
            <option value="false" selected>@Localizer["No"]</option>
        }
        else
        {
            <option value="false">@Localizer["No"]</option>
        }
    </select>
</div>

<div class="admin-field">
    <label for="order-filter-from">@Localizer["FromDate"]</label>
    <input id="order-filter-from"
           type="text"
           name="from"
           value="@Model.FromLocal"
           data-jdp
           class="admin-input-ltr"
           autocomplete="off"
           placeholder="1404/05/19"
           inputmode="numeric" />
</div>

<div class="admin-field">
    <label for="order-filter-to">@Localizer["ToDate"]</label>
    <input id="order-filter-to"
           type="text"
           name="to"
           value="@Model.ToLocal"
           data-jdp
           class="admin-input-ltr"
           autocomplete="off"
           placeholder="1404/05/19"
           inputmode="numeric" />
</div>

<div class="admin-field">
    <label for="order-filter-sort">@Localizer["Sort"]</label>
    <select id="order-filter-sort" name="sort">
        @{
            var sortOptions = new (string Value, string Key)[]
            {
                ("", "SortNewest"),
                ("oldest", "SortOldest"),
                ("total", "SortTotal"),
                ("total_desc", "SortTotalDesc"),
                ("status", "SortStatus"),
                ("customer", "SortCustomer")
            };
        }
        @foreach (var opt in sortOptions)
        {
            var selected = string.IsNullOrEmpty(opt.Value)
                ? string.IsNullOrEmpty(Model.Sort)
                : string.Equals(Model.Sort, opt.Value, StringComparison.OrdinalIgnoreCase);
            if (selected)
            {
                <option value="@opt.Value" selected>@Localizer[opt.Key]</option>
            }
            else
            {
                <option value="@opt.Value">@Localizer[opt.Key]</option>
            }
        }
    </select>
</div>
