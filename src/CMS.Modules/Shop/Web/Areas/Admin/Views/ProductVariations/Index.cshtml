@model ProductVariationsPageViewModel
@{
    ViewData["Title"] = Localizer["ProductVariations"];
    var isEditing = Model.IsEditing;
    var formAction = isEditing ? "Edit" : "Create";
    var formTitle = isEditing ? Localizer["EditVariation"] : Localizer["AddVariation"];
    var submitLabel = isEditing ? Localizer["SaveChanges"] : Localizer["AddVariation"];
    var submitIcon = isEditing ? "fa-save" : "fa-plus";
    var openModal = isEditing || !ViewData.ModelState.IsValid;
    string StatusLabel(CMS.Modules.Shop.Domain.Enums.VariationStatus status) => status switch
    {
        CMS.Modules.Shop.Domain.Enums.VariationStatus.Active => Localizer["StatusActive"].Value,
        CMS.Modules.Shop.Domain.Enums.VariationStatus.Hidden => Localizer["StatusHidden"].Value,
        CMS.Modules.Shop.Domain.Enums.VariationStatus.OutOfStock => Localizer["StatusOutOfStock"].Value,
        _ => status.ToString()
    };
}

<div class="admin-page-header">
    <div class="admin-page-header-text">
        <p class="admin-lead admin-lead--flush">@Model.ProductTitle · @Localizer["VariationsCount", Model.Variations.Count]</p>
    </div>
    <div class="admin-page-header-actions">
        <button type="button" class="btn btn-primary" data-variation-modal-open>
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>@Localizer["AddVariation"]</span>
        </button>
        <a class="btn btn-secondary" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId">
            <i class="fas fa-edit" aria-hidden="true"></i>
            <span>@Localizer["EditProduct"]</span>
        </a>
        <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
            <span>@Localizer["BackToProducts"]</span>
        </a>
    </div>
</div>

<section class="admin-panel-section">
    <div class="admin-panel-section-head">
        <h2 class="admin-section-title admin-section-title--flush">@Localizer["VariationsList"]</h2>
    </div>

    @if (Model.Variations.Count == 0)
    {
        <p class="admin-lead">@Localizer["NoVariations"]</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>@Localizer["Sku"]</th>
                    <th>@Localizer["AttributeSummary"]</th>
                    <th class="admin-col-num">@Localizer["Price"]</th>
                    <th class="admin-col-num">@Localizer["SalePrice"]</th>
                    <th class="admin-col-num">@Localizer["StockQuantity"]</th>
                    <th>@Localizer["Status"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Variations)
                {
                    var isCurrent = Model.Form.Id == item.Id;
                    var stockLabel = item.UnlimitedStock
                        ? Localizer["UnlimitedStock"].Value
                        : (item.StockQuantity?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR")) ?? "—");
                    <tr class="@(isCurrent ? "is-selected" : null)">
                        <td>@item.Sku</td>
                        <td>@(item.AttributeSummary ?? "—")</td>
                        <td class="admin-col-num">@item.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))</td>
                        <td class="admin-col-num">@(item.SalePrice?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR")) ?? "—")</td>
                        <td class="admin-col-num">@stockLabel</td>
                        <td>@StatusLabel(item.Status)</td>
                        <td class="admin-row-actions">
                            <a class="btn btn-secondary"
                               asp-action="Index"
                               asp-route-productId="@Model.ProductId"
                               asp-route-editId="@item.Id">
                                <i class="fas fa-edit" aria-hidden="true"></i>
                                <span>@Localizer["Edit"]</span>
                            </a>
                            <form asp-action="Delete" method="post" class="admin-inline-form" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="variationId" value="@item.Id" />
                                <button type="submit" class="btn btn-ghost">
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div id="variation-form-modal"
     class="admin-modal"
     @(openModal ? null : "hidden")
     data-variation-modal
     data-index-url="@Url.Action("Index", new { productId = Model.ProductId })"
     data-create-action="@Url.Action("Create", new { productId = Model.ProductId })"
     data-create-title="@Localizer["AddVariation"]"
     data-is-editing="@(isEditing ? "true" : "false")">
    <div class="admin-modal-backdrop" data-variation-modal-close></div>
    <div class="admin-modal-dialog admin-variation-dialog" role="dialog" aria-modal="true" aria-labelledby="variation-form-title">
        <div class="admin-modal-header">
            <h2 id="variation-form-title">@formTitle</h2>
            @if (isEditing)
            {
                <a class="btn btn-ghost" asp-action="Index" asp-route-productId="@Model.ProductId" aria-label="@Localizer["Cancel"]">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-ghost" data-variation-modal-close aria-label="@Localizer["Cancel"]">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            }
        </div>

        <form asp-action="@formAction"
              asp-route-productId="@Model.ProductId"
              method="post"
              class="admin-form"
              data-variation-form>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.Id" />
            <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

            <div class="admin-field">
                <label asp-for="Form.Sku">@Localizer["Sku"]</label>
                <input asp-for="Form.Sku" />
                <p class="admin-hint">@Localizer["VariationSkuHint"]</p>
                <span asp-validation-for="Form.Sku" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.AttributeSummary">@Localizer["AttributeSummary"]</label>
                <input asp-for="Form.AttributeSummary" />
                <p class="admin-hint">@Localizer["AttributeSummaryHint"]</p>
                <span asp-validation-for="Form.AttributeSummary" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.Price">@Localizer["Price"]</label>
                <input asp-for="Form.Price" type="text" inputmode="numeric" data-price-input />
                <p class="admin-hint">@Localizer["VariationPriceHint"]</p>
                <span asp-validation-for="Form.Price" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.SalePrice">@Localizer["SalePrice"]</label>
                <input asp-for="Form.SalePrice" type="text" inputmode="numeric" data-price-input />
                <p class="admin-hint">@Localizer["SalePriceHint"]</p>
                <span asp-validation-for="Form.SalePrice" class="admin-field-error"></span>
            </div>

            <div class="admin-field" data-stock-quantity-field>
                <label asp-for="Form.StockQuantity">@Localizer["StockQuantity"]</label>
                <input asp-for="Form.StockQuantity" type="number" min="0" />
                <p class="admin-hint">@Localizer["StockQuantityHint"]</p>
                <span asp-validation-for="Form.StockQuantity" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label class="admin-check">
                    <input asp-for="Form.UnlimitedStock" data-unlimited-stock />
                    @Localizer["UnlimitedStock"]
                </label>
                <p class="admin-hint">@Localizer["UnlimitedStockHint"]</p>
            </div>

            <div class="admin-field">
                <label asp-for="Form.Status">@Localizer["Status"]</label>
                <select asp-for="Form.Status" asp-items="Model.Form.StatusOptions"></select>
                <p class="admin-hint">@Localizer["VariationStatusHint"]</p>
                <span asp-validation-for="Form.Status" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>@Localizer["CoverImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#Form_ImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="Form.ImageUrl" id="Form_ImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["SelectImageHint"]</p>
                <span asp-validation-for="Form.ImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#Form_ImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.Form.ImageUrl))
                    {
                        <img src="@Model.Form.ImageUrl" alt="" />
                    }
                </div>
            </div>

            <div class="admin-field">
                <label asp-for="Form.Weight">@Localizer["Weight"]</label>
                <input asp-for="Form.Weight" type="number" step="0.01" min="0" />
                <p class="admin-hint">@Localizer["WeightHint"]</p>
                <span asp-validation-for="Form.Weight" class="admin-field-error"></span>
            </div>

            <div class="admin-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas @submitIcon" aria-hidden="true"></i>
                    <span>@submitLabel</span>
                </button>
                @if (isEditing)
                {
                    <a class="btn btn-secondary" asp-action="Index" asp-route-productId="@Model.ProductId">
                        <span>@Localizer["Cancel"]</span>
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" data-variation-modal-close>
                        <span>@Localizer["Cancel"]</span>
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<partial name="_MediaLibraryPicker" />

@section Scripts {
    <script src="~/admin/js/admin-price-input.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin-variation-modal.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin-product-stock.js" asp-append-version="true"></script>
}
