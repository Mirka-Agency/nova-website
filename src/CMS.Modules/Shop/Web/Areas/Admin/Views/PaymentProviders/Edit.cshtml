@model PaymentProviderFormViewModel
@{ ViewData["Title"] = Localizer["EditPaymentProvider"]; }
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form admin-form-narrow">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProviderType" />
    <partial name="_PaymentProviderForm" model="Model" />
    <div class="admin-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
        <a class="btn btn-secondary" asp-action="Index">@Localizer["Cancel"]</a>
    </div>
</form>
