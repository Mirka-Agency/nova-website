@model IReadOnlyList<CMS.Modules.Shop.Application.Payments.PaymentProviderConfigDto>
@using CMS.Modules.Shop.Domain.Enums
@{ ViewData["Title"] = Localizer["PaymentProviders"]; }

@if (TempData["Success"] is string success)
{
    <p class="admin-flash admin-flash--success">@success</p>
}

<p class="admin-meta">@Localizer["PaymentGatewayHint"]</p>

<table class="admin-table">
    <thead>
    <tr>
        <th>@Localizer["Name"]</th>
        <th>@Localizer["ProviderType"]</th>
        <th class="admin-col-num">@Localizer["SortOrder"]</th>
        <th>@Localizer["IsActive"]</th>
        <th>Sandbox</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><strong>@p.DisplayName</strong></td>
            <td>@p.ProviderType</td>
            <td class="admin-col-num">@p.SortOrder</td>
            <td>@(p.IsEnabled ? Localizer["Yes"] : Localizer["No"])</td>
            <td>@(p.IsSandbox ? Localizer["Yes"] : Localizer["No"])</td>
            <td class="admin-actions-inline">
                <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@p.Id">@Localizer["Edit"]</a>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Count > 0)
{
    <partial name="_Pager" />
}
