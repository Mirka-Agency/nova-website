@model IReadOnlyList<CMS.Modules.Shop.Application.Pricing.PriceRuleDto>
@{ ViewData["Title"] = Localizer["PriceRules"]; }
<div class="admin-toolbar"><a class="btn btn-primary" asp-action="Create">@Localizer["CreatePriceRule"]</a></div>
<table class="admin-table"><thead><tr><th>@Localizer["Name"]</th><th>@Localizer["RuleType"]</th><th>@Localizer["IsActive"]</th><th></th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@r.Name</td><td>@r.RuleType</td><td>@(r.IsActive ? Localizer["Yes"] : Localizer["No"])</td><td><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@r.Id">@Localizer["Edit"]</a></td></tr> }
</tbody></table>
@if (Model.Count > 0)
{
    <partial name="_Pager" />
}
