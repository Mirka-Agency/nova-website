@model AttributeFormViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? Localizer["EditAttribute"] : Localizer["CreateAttribute"]; }
<form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post" class="admin-form admin-form-narrow">
@Html.AntiForgeryToken()
<div class="admin-field"><label asp-for="Name">@Localizer["Name"]</label><input asp-for="Name" /></div>
<div class="admin-field"><label asp-for="Slug">@Localizer["Slug"]</label><input asp-for="Slug" /></div>
<div class="admin-field"><label asp-for="SortOrder">@Localizer["SortOrder"]</label><input asp-for="SortOrder" type="number" /></div>
<div class="admin-actions"><button type="submit" class="btn btn-primary">@Localizer["Save"]</button><a class="btn btn-secondary" asp-action="Index">@Localizer["Cancel"]</a></div>
</form>
