@model IReadOnlyList<CMS.Modules.Shop.Application.Catalog.AttributeListItemDto>
@{ ViewData["Title"] = Localizer["Attributes"]; }
<div class="admin-toolbar"><a class="btn btn-primary" asp-action="Create">@Localizer["CreateAttribute"]</a></div>
@if (Model.Count == 0) { <p class="admin-lead">@Localizer["NoAttributes"]</p> } else {
<table class="admin-table"><thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Slug"]</th><th>@Localizer["Values"]</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Slug</td><td>@item.Values.Count</td><td><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@item.Id">@Localizer["Edit"]</a></td></tr> }
</tbody></table>
<partial name="_Pager" />
}
