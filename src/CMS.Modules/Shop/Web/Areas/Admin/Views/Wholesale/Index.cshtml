@model IReadOnlyList<CMS.Modules.Shop.Application.Wholesale.WholesaleRequestListItemDto>
@{ ViewData["Title"] = Localizer["WholesaleRequests"]; }
@if (Model.Count == 0) { <p class="admin-lead">@Localizer["NoWholesaleRequests"]</p> } else {
<div class="admin-table-wrap">
<table class="admin-table"><thead><tr><th>@Localizer["CompanyName"]</th><th>@Localizer["ContactName"]</th><th>@Localizer["Email"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@r.CompanyName</td><td>@r.ContactName</td><td>@r.Email</td><td>@r.Status</td><td><a class="btn btn-secondary" asp-action="Details" asp-route-id="@r.Id">@Localizer["View"]</a></td></tr> }
</tbody></table>
</div>
<partial name="_Pager" />
}
