@model ArticleFormViewModel
@using CMS.Application.Common.Features
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        <div class="admin-field">
            <label asp-for="Title">@Localizer["Title"]</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Slug">@Localizer["Slug"]</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Excerpt">@Localizer["ShortDescription"]</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <p class="admin-hint">@Localizer["ShortDescriptionHint"]</p>
            <span asp-validation-for="Excerpt" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Body">@Localizer["Body"]</label>
            <textarea asp-for="Body"
                      rows="16"
                      class="admin-ckeditor-source"></textarea>
            <span asp-validation-for="Body" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["MetaSettings"]</legend>
            <div class="admin-field">
                <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
                <input asp-for="MetaTitle" />
                <p class="admin-hint">@Localizer["MetaTitleHint"]</p>
                <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
                <textarea asp-for="MetaDescription" rows="2"></textarea>
                <p class="admin-hint">@Localizer["MetaDescriptionHint"]</p>
                <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["SeoSettings"]</legend>
            <div class="admin-field">
                <label asp-for="SeoKeywords">@Localizer["SeoKeywords"]</label>
                <input asp-for="SeoKeywords" />
                <p class="admin-hint">@Localizer["SeoKeywordsHint"]</p>
                <span asp-validation-for="SeoKeywords" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CanonicalUrl">@Localizer["CanonicalUrl"]</label>
                <input asp-for="CanonicalUrl" />
                <p class="admin-hint">@Localizer["CanonicalUrlHint"]</p>
                <span asp-validation-for="CanonicalUrl" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgTitle">@Localizer["OgTitle"]</label>
                <input asp-for="OgTitle" />
                <span asp-validation-for="OgTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgDescription">@Localizer["OgDescription"]</label>
                <textarea asp-for="OgDescription" rows="2"></textarea>
                <span asp-validation-for="OgDescription" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label>@Localizer["OgImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#OgImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="OgImageUrl" id="OgImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["OgImageHint"]</p>
                <span asp-validation-for="OgImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#OgImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
                    {
                        <img src="@Model.OgImageUrl" alt="" />
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field">
            <label asp-for="Kind">@Localizer["Kind"]</label>
            <select asp-for="Kind" asp-items="Model.Kinds"></select>
            <span asp-validation-for="Kind" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="CategoryId">@Localizer["Category"]</label>
            <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="AuthorUserId">@Localizer["Author"]</label>
            <select asp-for="AuthorUserId" asp-items="Model.Authors"></select>
            <p class="admin-hint">@Localizer["AuthorHint"]</p>
            <span asp-validation-for="AuthorUserId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label>@Localizer["CoverImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#CoverImageUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="CoverImageUrl" id="CoverImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="CoverImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#CoverImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" alt="" />
                }
            </div>
        </div>

        <div class="admin-field"
             data-article-attachment
             data-upload-url="@Url.Action("UploadAttachment", "NewsMedia", new { area = "Admin" })">
            <label>@Localizer["Attachment"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-attachment-upload-btn>
                    <i class="fas fa-upload" aria-hidden="true"></i>
                    <span>@Localizer["UploadAttachment"]</span>
                </button>
                <button type="button"
                        class="btn btn-ghost"
                        data-attachment-clear-btn
                        @(string.IsNullOrWhiteSpace(Model.AttachmentUrl) ? "hidden" : null)>
                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                    <span>@Localizer["RemoveAttachment"]</span>
                </button>
                <input type="file"
                       accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png,.webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/jpeg,image/png,image/webp"
                       data-attachment-upload-input
                       hidden />
            </div>
            <input asp-for="AttachmentUrl" id="AttachmentUrl" type="hidden" data-attachment-url />
            <input asp-for="AttachmentFileName" id="AttachmentFileName" type="hidden" data-attachment-name />
            <p class="admin-hint">@Localizer["AttachmentHint"]</p>
            <span asp-validation-for="AttachmentUrl" class="admin-field-error"></span>
            <p class="admin-field-error" data-attachment-upload-error hidden></p>
            <div class="admin-upload-preview" data-attachment-preview>
                @if (!string.IsNullOrWhiteSpace(Model.AttachmentUrl))
                {
                    <a href="@Model.AttachmentUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-attachment-link>
                        <i class="fas fa-file-alt" aria-hidden="true"></i>
                        <span data-attachment-label>@(string.IsNullOrWhiteSpace(Model.AttachmentFileName) ? Localizer["AttachmentReady"].Value : Model.AttachmentFileName)</span>
                    </a>
                }
            </div>
        </div>

        <div class="admin-field" data-article-gallery>
            <label>@Localizer["ImageGallery"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button"
                        class="btn btn-secondary"
                        data-media-picker
                        data-media-picker-no-clear
                        data-target="#ArticleGalleryStagingUrl">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                    <span>@Localizer["AddGalleryImage"]</span>
                </button>
            </div>
            <input type="hidden" id="ArticleGalleryStagingUrl" data-article-gallery-staging />
            <input type="hidden"
                   name="EventStartAtUtc"
                   value="@(Model.EventStartAtUtc?.ToString("o"))"
                   data-autosave-event-start />
            <input type="hidden"
                   name="EventEndAtUtc"
                   value="@(Model.EventEndAtUtc?.ToString("o"))"
                   data-autosave-event-end />
            <p class="admin-hint">@Localizer["ImageGalleryHint"]</p>
            <ul class="admin-product-gallery-list" data-article-gallery-list>
                @for (var i = 0; i < Model.GalleryImages.Count; i++)
                {
                    <li class="admin-product-gallery-item" data-article-gallery-item>
                        <div class="admin-product-gallery-thumb">
                            <img src="@Model.GalleryImages[i].Url" alt="" />
                        </div>
                        <input type="hidden" name="GalleryImages[@i].Url" value="@Model.GalleryImages[i].Url" data-gallery-url />
                        <div class="admin-product-gallery-meta">
                            <input type="text"
                                   name="GalleryImages[@i].AltText"
                                   value="@Model.GalleryImages[i].AltText"
                                   placeholder="@Localizer["ImageAltText"]"
                                   data-gallery-alt />
                            <div class="admin-product-gallery-actions">
                                <button type="button" class="btn btn-text-danger" data-gallery-remove>
                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                    <span>@Localizer["Remove"]</span>
                                </button>
                            </div>
                        </div>
                    </li>
                }
            </ul>
            <p class="admin-hint" data-article-gallery-empty @(Model.GalleryImages.Count > 0 ? "hidden" : null)>
                @Localizer["ImageGalleryEmpty"]
            </p>
        </div>

        <template id="article-gallery-item-template">
            <li class="admin-product-gallery-item" data-article-gallery-item>
                <div class="admin-product-gallery-thumb">
                    <img src="" alt="" />
                </div>
                <input type="hidden" name="GalleryImages[__INDEX__].Url" value="" data-gallery-url />
                <div class="admin-product-gallery-meta">
                    <input type="text"
                           name="GalleryImages[__INDEX__].AltText"
                           value=""
                           placeholder="@Localizer["ImageAltText"]"
                           data-gallery-alt />
                    <div class="admin-product-gallery-actions">
                        <button type="button" class="btn btn-text-danger" data-gallery-remove>
                            <i class="fas fa-trash" aria-hidden="true"></i>
                            <span>@Localizer["Remove"]</span>
                        </button>
                    </div>
                </div>
            </li>
        </template>

        <label class="admin-check">
            <input asp-for="Publish" />
            @Localizer["Publish"]
        </label>

        <div class="admin-field">
            <label asp-for="PublishedAtLocal">@Localizer["PublishDate"]</label>
            <input asp-for="PublishedAtLocal"
                   type="text"
                   data-jdp
                   class="admin-input-ltr"
                   autocomplete="off"
                   placeholder="1404/05/19 14:30"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["PublishDateHint"]</p>
            <span asp-validation-for="PublishedAtLocal" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["EventStart"] / @Localizer["EventEnd"]</legend>
            <p class="admin-hint">@Localizer["EventFieldsHint"]</p>
            <div class="admin-field">
                <label asp-for="EventStartAtLocal">@Localizer["EventStart"]</label>
                <input asp-for="EventStartAtLocal"
                       type="text"
                       data-jdp
                       class="admin-input-ltr"
                       autocomplete="off"
                       placeholder="1404/05/19 14:30"
                       inputmode="numeric" />
                <span asp-validation-for="EventStartAtLocal" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="EventEndAtLocal">@Localizer["EventEnd"]</label>
                <input asp-for="EventEndAtLocal"
                       type="text"
                       data-jdp
                       class="admin-input-ltr"
                       autocomplete="off"
                       placeholder="1404/05/19 16:00"
                       inputmode="numeric" />
                <span asp-validation-for="EventEndAtLocal" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Location">@Localizer["Location"]</label>
                <input asp-for="Location" />
                <span asp-validation-for="Location" class="admin-field-error"></span>
            </div>

            <div class="admin-field" data-article-event-info>
                <label>@Localizer["EventInfo"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-event-info-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddEventInfoItem"]</span>
                    </button>
                </div>
                <p class="admin-hint">@Localizer["EventInfoHint"]</p>
                <ul class="admin-event-info-list" data-event-info-list>
                    @for (var i = 0; i < Model.EventInfoItems.Count; i++)
                    {
                        <li class="admin-event-info-item" data-event-info-item>
                            <div class="admin-event-info-item__row">
                                <input name="EventInfoItems[@i].Label"
                                       value="@Model.EventInfoItems[i].Label"
                                       maxlength="80"
                                       placeholder="@Localizer["EventInfoLabel"]"
                                       data-event-info-label />
                                <input name="EventInfoItems[@i].Value"
                                       value="@Model.EventInfoItems[i].Value"
                                       maxlength="300"
                                       placeholder="@Localizer["EventInfoValue"]"
                                       data-event-info-value />
                            </div>
                            <button type="button" class="btn btn-text-danger" data-event-info-remove>
                                @Localizer["Remove"]
                            </button>
                        </li>
                    }
                </ul>
                <p class="admin-hint" data-event-info-empty @(Model.EventInfoItems.Count > 0 ? "hidden" : null)>
                    @Localizer["EventInfoEmpty"]
                </p>
                <template id="article-event-info-item-template">
                    <li class="admin-event-info-item" data-event-info-item>
                        <div class="admin-event-info-item__row">
                            <input name="EventInfoItems[__INDEX__].Label"
                                   value=""
                                   maxlength="80"
                                   placeholder="@Localizer["EventInfoLabel"]"
                                   data-event-info-label />
                            <input name="EventInfoItems[__INDEX__].Value"
                                   value=""
                                   maxlength="300"
                                   placeholder="@Localizer["EventInfoValue"]"
                                   data-event-info-value />
                        </div>
                        <button type="button" class="btn btn-text-danger" data-event-info-remove>
                            @Localizer["Remove"]
                        </button>
                    </li>
                </template>
            </div>
        </fieldset>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
        <p class="admin-autosave-status" data-post-autosave-status aria-live="polite" hidden></p>

        @if (await FeatureManager.IsEnabledAsync(FeatureNames.Seo))
        {
            <partial name="_SeoAnalysisPanel" for="Seo" />
        }
    </aside>
</div>
