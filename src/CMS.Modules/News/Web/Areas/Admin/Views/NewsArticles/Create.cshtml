@model ArticleFormViewModel
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager
@{
    ViewData["Title"] = Localizer["CreatePost"];
}

<form asp-action="Create" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <partial name="_ArticleForm" model="Model" />
</form>

<partial name="_MediaLibraryPicker" />

@section Scripts {
    <partial name="_CkEditorScripts" />
    <partial name="_JalaliDatePickerScripts" />
    <script src="~/admin/js/admin-article-gallery.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin-article-event-info.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin-article-attachment.js" asp-append-version="true"></script>
    @if (await FeatureManager.IsEnabledAsync(CMS.Application.Common.Features.FeatureNames.Seo))
    {
        <partial name="_SeoAnalysisScripts" />
    }
}
