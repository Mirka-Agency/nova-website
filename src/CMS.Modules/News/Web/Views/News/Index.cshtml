@model IReadOnlyList<PublicArticleSummaryDto>
@using CMS.Modules.News.Application.Articles
@using CMS.Modules.News.Domain.Enums
@using System.Globalization
@{
    ViewData["Title"] = "مقالات تخصصی";
    ViewData["NavActive"] = "articles";
    var items = (Model ?? Array.Empty<PublicArticleSummaryDto>())
        .Where(x => x.Kind != ArticleKind.Event)
        .ToList();
    var hasCmsArticles = items.Count > 0;
    var categories = (ViewBag.Categories as IReadOnlyList<PublicArticleCategoryDto>)
        ?? Array.Empty<PublicArticleCategoryDto>();

    string ToPersianDigits(string value) =>
        value.Replace('0', '۰').Replace('1', '۱').Replace('2', '۲').Replace('3', '۳').Replace('4', '۴')
            .Replace('5', '۵').Replace('6', '۶').Replace('7', '۷').Replace('8', '۸').Replace('9', '۹');

    string FormatRelativeDate(DateTime utc)
    {
        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        var span = DateTime.Now - local;
        if (span.TotalDays < 0) span = TimeSpan.Zero;

        if (span.TotalDays >= 365)
        {
            var years = Math.Max(1, (int)(span.TotalDays / 365));
            return years == 1
                ? "۱ سال قبل"
                : $"{ToPersianDigits(years.ToString(CultureInfo.InvariantCulture))} سال قبل";
        }

        if (span.TotalDays >= 30)
        {
            var months = Math.Max(1, (int)(span.TotalDays / 30));
            return months == 1
                ? "۱ ماه قبل"
                : $"{ToPersianDigits(months.ToString(CultureInfo.InvariantCulture))} ماه قبل";
        }

        if (span.TotalDays >= 1)
        {
            var days = Math.Max(1, (int)span.TotalDays);
            return days == 1
                ? "۱ روز قبل"
                : $"{ToPersianDigits(days.ToString(CultureInfo.InvariantCulture))} روز قبل";
        }

        return "امروز";
    }
}

<section class="page-hero page-hero--articles" aria-labelledby="page-hero-title">
