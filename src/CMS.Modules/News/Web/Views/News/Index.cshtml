@model IReadOnlyList<PublicArticleSummaryDto>
@using CMS.Modules.News.Domain.Enums
@{
    ViewData["Title"] = Localizer["News"];
}

<section class="blog-page">
    <header class="blog-page-header">
        <h1>@Localizer["News"]</h1>
    </header>

    @if (Model.Count == 0)
    {
        <p class="blog-empty">@Localizer["NoPosts"]</p>
    }
    else
    {
        <div class="blog-list">
            @foreach (var post in Model)
            {
                <article class="blog-card">
                    @if (!string.IsNullOrWhiteSpace(post.CoverImageUrl))
                    {
                        <a class="blog-card-cover" asp-controller="News" asp-action="Details" asp-route-slug="@post.Slug">
                            <img src="@post.CoverImageUrl" alt="@post.Title" />
                        </a>
                    }
                    <div class="blog-card-body">
                        <h2>
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a>
                        </h2>
                        <p class="blog-meta">
                            <span class="blog-kind">@(post.Kind == ArticleKind.Event ? Localizer["EventKind"] : Localizer["NewsKind"])</span>
                            <span>· @Localizer["PublishedOn"]: @post.PublishedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</span>
                            @if (!string.IsNullOrWhiteSpace(post.AuthorDisplayName))
                            {
                                <span>· @Localizer["Author"]: @post.AuthorDisplayName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                            {
                                <span>· @Localizer["Category"]: @post.CategoryName</span>
                            }
                            @if (post.Kind == ArticleKind.Event)
                            {
                                @if (post.EventStartAtUtc.HasValue)
                                {
                                    <span>· @Localizer["EventStart"]: @post.EventStartAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                }
                                @if (post.EventEndAtUtc.HasValue)
                                {
                                    <span>· @Localizer["EventEnd"]: @post.EventEndAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(post.Location))
                                {
                                    <span>· @Localizer["Location"]: @post.Location</span>
                                }
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                        {
                            <p class="blog-excerpt">@post.Excerpt</p>
                        }
                        <a class="blog-read-more" asp-controller="News" asp-action="Details" asp-route-slug="@post.Slug">@Localizer["ReadMore"]</a>
                    </div>
                </article>
            }
        </div>

        @if (ViewBag.TotalPages is int totalPages && totalPages > 1)
        {
            var currentPage = ViewBag.Page as int? ?? 1;
            <nav class="blog-pager" aria-label="صفحه‌بندی" style="margin-top:1.5rem;display:flex;gap:1rem;justify-content:center;">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)">قبلی</a>
                }
                <span>صفحه @currentPage از @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)">بعدی</a>
                }
            </nav>
        }
    }
</section>
