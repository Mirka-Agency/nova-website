<link rel="stylesheet" href="~/admin/vendor/jalalidatepicker/jalalidatepicker.min.css" asp-append-version="true" />
<script src="~/admin/vendor/jalalidatepicker/jalalidatepicker.min.js" asp-append-version="true"></script>
<script>
    (() => {
        if (window.__formsJalaliDatepickerStarted) return;
        window.__formsJalaliDatepickerStarted = true;
        jalaliDatepicker.startWatch({
            time: true,
            hasSecond: false,
            persianDigits: false,
            showTodayBtn: true,
            showEmptyBtn: true,
            showSelectTimeBtnAlways: true,
            zIndex: 10050
        });
    })();
</script>
