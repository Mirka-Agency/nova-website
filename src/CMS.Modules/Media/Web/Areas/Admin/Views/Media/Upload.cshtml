@model MediaUploadViewModel
@{
    ViewData["Title"] = Localizer["UploadMedia"];
}

<form asp-action="Upload"
      method="post"
      enctype="multipart/form-data"
      class="admin-form admin-form-narrow"
      data-media-upload-form
      data-uploading-label="@Localizer["Uploading"]"
      data-upload-label="@Localizer["Upload"]">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-field">
        <label asp-for="File">@Localizer["SelectFile"]</label>
        <input asp-for="File" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
        <p class="admin-hint">@Localizer["UploadHint"]</p>
        <span asp-validation-for="File" class="admin-field-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Title">@Localizer["Title"]</label>
        <input asp-for="Title" maxlength="300" />
    </div>
    <div class="admin-field">
        <label asp-for="AltText">@Localizer["AltText"]</label>
        <input asp-for="AltText" maxlength="500" />
    </div>

    <div class="admin-field-row">
        <div class="admin-field">
            <label asp-for="MaxWidth">@Localizer["MaxWidth"]</label>
            <input asp-for="MaxWidth"
                   type="number"
                   min="16"
                   max="8192"
                   step="1"
                   placeholder="2560"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["MaxWidthHint"]</p>
            <span asp-validation-for="MaxWidth" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Quality">@Localizer["CompressQuality"]</label>
            <input asp-for="Quality"
                   type="number"
                   min="40"
                   max="100"
                   step="1"
                   placeholder="82"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["CompressQualityHint"]</p>
            <span asp-validation-for="Quality" class="admin-field-error"></span>
        </div>
    </div>

    <p class="admin-loading" data-media-upload-status hidden aria-live="polite">
        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
        <span>@Localizer["Uploading"]</span>
    </p>
    <div class="admin-upload-progress" data-media-upload-progress hidden aria-hidden="true">
        <span class="admin-upload-progress-bar"></span>
    </div>

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary" data-media-upload-submit>
            <i class="fas fa-upload" aria-hidden="true" data-upload-icon></i>
            <span data-upload-label>@Localizer["Upload"]</span>
        </button>
        <a class="btn btn-secondary" asp-action="Index" data-media-upload-cancel>
            <i class="fas fa-times" aria-hidden="true"></i>
            <span>@Localizer["Cancel"]</span>
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/admin/js/media-upload.js" asp-append-version="true"></script>
}
