@model TeamItemFormViewModel

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        <div class="admin-field">
            <label asp-for="Title">@Localizer["Title"]</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Subtitle">@Localizer["Subtitle"]</label>
            <input asp-for="Subtitle" />
            <p class="admin-hint">@Localizer["SubtitleHint"]</p>
            <span asp-validation-for="Subtitle" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Slug">@Localizer["Slug"]</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Excerpt">@Localizer["ShortDescription"]</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <p class="admin-hint">@Localizer["ShortDescriptionHint"]</p>
            <span asp-validation-for="Excerpt" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Highlights">@Localizer["Highlights"]</label>
            <textarea asp-for="Highlights" rows="4"></textarea>
            <p class="admin-hint">@Localizer["HighlightsHint"]</p>
            <span asp-validation-for="Highlights" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset" data-team-specialty-path>
            <legend>@Localizer["SpecialtyPath"]</legend>
            <p class="admin-hint">@Localizer["SpecialtyPathHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-specialty-path-list>
                    @for (var i = 0; i < Model.SpecialtyPathItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-specialty-path-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SpecialtyPathItems[i].Title">@Localizer["SpecialtyPathTitle"]</label>
                                <input asp-for="SpecialtyPathItems[i].Title"
                                       placeholder="@Localizer["SpecialtyPathTitlePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="200" />
                                <span asp-validation-for="SpecialtyPathItems[i].Title" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SpecialtyPathItems[i].Text">@Localizer["SpecialtyPathText"]</label>
                                <textarea asp-for="SpecialtyPathItems[i].Text"
                                          rows="3"
                                          placeholder="@Localizer["SpecialtyPathTextPlaceholder"]"
                                          maxlength="1000"></textarea>
                                <span asp-validation-for="SpecialtyPathItems[i].Text" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions">
                                <button type="button" class="btn btn-text-danger" data-specialty-path-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-specialty-path-empty @(Model.SpecialtyPathItems.Count > 0 ? "hidden" : null)>
                    @Localizer["SpecialtyPathEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-specialty-path-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddSpecialtyPathItem"]</span>
                    </button>
                </div>
            </div>

            <template id="team-specialty-path-row-template">
                <div class="admin-faq-row" data-specialty-path-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SpecialtyPathTitle"]</label>
                        <input name="SpecialtyPathItems[__INDEX__].Title"
                               placeholder="@Localizer["SpecialtyPathTitlePlaceholder"]"
                               autocomplete="off"
                               maxlength="200" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SpecialtyPathText"]</label>
                        <textarea name="SpecialtyPathItems[__INDEX__].Text"
                                  rows="3"
                                  placeholder="@Localizer["SpecialtyPathTextPlaceholder"]"
                                  maxlength="1000"></textarea>
                    </div>
                    <div class="admin-faq-row-actions">
                        <button type="button" class="btn btn-text-danger" data-specialty-path-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset" data-team-education-path>
            <legend>@Localizer["EducationPath"]</legend>
            <p class="admin-hint">@Localizer["EducationPathHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-education-path-list>
                    @for (var i = 0; i < Model.EducationPathItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-education-path-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="EducationPathItems[i].Year">@Localizer["EducationPathYear"]</label>
                                <input asp-for="EducationPathItems[i].Year"
                                       placeholder="@Localizer["EducationPathYearPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="32" />
                                <span asp-validation-for="EducationPathItems[i].Year" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="EducationPathItems[i].Title">@Localizer["EducationPathTitle"]</label>
                                <input asp-for="EducationPathItems[i].Title"
                                       placeholder="@Localizer["EducationPathTitlePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="300" />
                                <span asp-validation-for="EducationPathItems[i].Title" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="EducationPathItems[i].Place">@Localizer["EducationPathPlace"]</label>
                                <input asp-for="EducationPathItems[i].Place"
                                       placeholder="@Localizer["EducationPathPlacePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="300" />
                                <span asp-validation-for="EducationPathItems[i].Place" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions">
                                <button type="button" class="btn btn-text-danger" data-education-path-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-education-path-empty @(Model.EducationPathItems.Count > 0 ? "hidden" : null)>
                    @Localizer["EducationPathEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-education-path-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddEducationPathItem"]</span>
                    </button>
                </div>
            </div>

            <template id="team-education-path-row-template">
                <div class="admin-faq-row" data-education-path-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["EducationPathYear"]</label>
                        <input name="EducationPathItems[__INDEX__].Year"
                               placeholder="@Localizer["EducationPathYearPlaceholder"]"
                               autocomplete="off"
                               maxlength="32" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["EducationPathTitle"]</label>
                        <input name="EducationPathItems[__INDEX__].Title"
                               placeholder="@Localizer["EducationPathTitlePlaceholder"]"
                               autocomplete="off"
                               maxlength="300" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["EducationPathPlace"]</label>
                        <input name="EducationPathItems[__INDEX__].Place"
                               placeholder="@Localizer["EducationPathPlacePlaceholder"]"
                               autocomplete="off"
                               maxlength="300" />
                    </div>
                    <div class="admin-faq-row-actions">
                        <button type="button" class="btn btn-text-danger" data-education-path-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <div class="admin-field">
            <label asp-for="Body">@Localizer["Description"]</label>
            <textarea asp-for="Body"
                      rows="16"
                      class="admin-ckeditor-source"></textarea>
            <span asp-validation-for="Body" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["MetaSettings"]</legend>
            <div class="admin-field">
                <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
                <input asp-for="MetaTitle" />
                <p class="admin-hint">@Localizer["MetaTitleHint"]</p>
                <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
                <textarea asp-for="MetaDescription" rows="2"></textarea>
                <p class="admin-hint">@Localizer["MetaDescriptionHint"]</p>
                <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["SeoSettings"]</legend>
            <div class="admin-field">
                <label asp-for="SeoKeywords">@Localizer["SeoKeywords"]</label>
                <input asp-for="SeoKeywords" />
                <p class="admin-hint">@Localizer["SeoKeywordsHint"]</p>
                <span asp-validation-for="SeoKeywords" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CanonicalUrl">@Localizer["CanonicalUrl"]</label>
                <input asp-for="CanonicalUrl" />
                <p class="admin-hint">@Localizer["CanonicalUrlHint"]</p>
                <span asp-validation-for="CanonicalUrl" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgTitle">@Localizer["OgTitle"]</label>
                <input asp-for="OgTitle" />
                <span asp-validation-for="OgTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgDescription">@Localizer["OgDescription"]</label>
                <textarea asp-for="OgDescription" rows="2"></textarea>
                <span asp-validation-for="OgDescription" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label>@Localizer["OgImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#OgImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="OgImageUrl" id="OgImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["OgImageHint"]</p>
                <span asp-validation-for="OgImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#OgImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
                    {
                        <img src="@Model.OgImageUrl" alt="" />
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field">
            <label asp-for="CategoryId">@Localizer["Category"]</label>
            <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="AuthorUserId">@Localizer["Author"]</label>
            <select asp-for="AuthorUserId" asp-items="Model.Authors"></select>
            <p class="admin-hint">@Localizer["AuthorHint"]</p>
            <span asp-validation-for="AuthorUserId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label>@Localizer["CoverImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#CoverImageUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="CoverImageUrl" id="CoverImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="CoverImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#CoverImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" alt="" />
                }
            </div>
        </div>

        <div class="admin-field">
            <label>@Localizer["AvatarImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#AvatarImageUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="AvatarImageUrl" id="AvatarImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["AvatarImageHint"]</p>
            <span asp-validation-for="AvatarImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#AvatarImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarImageUrl))
                {
                    <img src="@Model.AvatarImageUrl" alt="" />
                }
            </div>
        </div>

        <label class="admin-check">
            <input asp-for="Publish" />
            @Localizer["Publish"]
        </label>

        <div class="admin-field">
            <label asp-for="PublishedAtLocal">@Localizer["PublishDate"]</label>
            <input asp-for="PublishedAtLocal"
                   type="text"
                   data-jdp
                   class="admin-input-ltr"
                   autocomplete="off"
                   placeholder="1404/05/19 14:30"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["PublishDateHint"]</p>
            <span asp-validation-for="PublishedAtLocal" class="admin-field-error"></span>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
        <p class="admin-autosave-status" data-post-autosave-status aria-live="polite" hidden></p>
    </aside>
</div>
