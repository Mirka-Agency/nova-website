@model PublicTeamItemDetailDto
@using CMS.Application.Settings
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = Model.Title;
    ViewData["NavActive"] = "doctors";
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var brand = contact.Brand;
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var address = contact.Address;
    var role = string.IsNullOrWhiteSpace(Model.CategoryName) ? "متخصص کلینیک" : Model.CategoryName;
    var specialty = string.IsNullOrWhiteSpace(Model.Subtitle) ? role : Model.Subtitle;
    // Match doctor-single.html quick-info: omit «متخصص جراحی عمومی» from the تخصص row.
    var quickSpecialtyParts = specialty
        .Split(new[] { '|', '·' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(x => !string.Equals(x, "متخصص جراحی عمومی", StringComparison.Ordinal))
        .ToList();
    var quickSpecialty = specialty.Contains("متخصص جراحی عمومی", StringComparison.Ordinal) && quickSpecialtyParts.Count > 0
        ? string.Join(" | ", quickSpecialtyParts)
        : specialty;
    var cover = string.IsNullOrWhiteSpace(Model.CoverImageUrl)
        ? Url.Content("~/template/assets/images/doctors/dr-hamedani.webp")
        : Model.CoverImageUrl;
    CMS.Application.Seo.LcpImageHints.TryRegister(ViewData, cover);
    var lead = string.IsNullOrWhiteSpace(Model.Excerpt)
        ? $"پروفایل تخصصی {Model.Title} در {brand}."
        : Model.Excerpt;
    var hasBody = !string.IsNullOrWhiteSpace(Model.Body);
    var related = (ViewBag.Related as IReadOnlyList<PublicTeamItemSummaryDto>)
        ?? Array.Empty<PublicTeamItemSummaryDto>();
    var fallbackCover = Url.Content("~/template/assets/images/doctors/dr-hamedani-portrait.webp");
    var specialtyPathItems = TeamSpecialtyPathJson.Parse(Model.SpecialtyPathJson);
    var isHamedani = Model.Slug.Contains("hamedani", StringComparison.OrdinalIgnoreCase)
        || Model.Title.Contains("همدانی", StringComparison.Ordinal);
    if (isHamedani)
    {
        bool MatchesTitle(string title, string needle)
        {
            if (!title.Contains(needle, StringComparison.OrdinalIgnoreCase))
                return false;
            // Avoid matching «پاراتیروئید» when looking for «تیروئید».
            if (needle == "تیروئید" && title.Contains("پارا", StringComparison.OrdinalIgnoreCase))
                return false;
            return true;
        }

        string? PickText(params string[] needles)
        {
            foreach (var item in specialtyPathItems)
            {
                foreach (var needle in needles)
                {
                    if (MatchesTitle(item.Title, needle))
                        return item.Text;
                }
            }

            return null;
        }

        string? PickIcon(params string[] needles)
        {
            foreach (var item in specialtyPathItems)
            {
                foreach (var needle in needles)
                {
                    if (MatchesTitle(item.Title, needle) && !string.IsNullOrWhiteSpace(item.IconUrl))
                        return item.IconUrl;
                }
            }

            return null;
        }

        specialtyPathItems =
        [
            new TeamSpecialtyPathItemDto(
                "جراحی تیروئید",
                PickText("تیروئید") ?? "بیماری‌ها و توده‌های تیروئید که نیاز به ارزیابی یا درمان جراحی دارند.",
                PickIcon("تیروئید"),
                Url.Content("~/thyroid-surgery/")),
            new TeamSpecialtyPathItemDto(
                "جراحی پاراتیروئید",
                PickText("پاراتیروئید") ?? "اختلالات پاراتیروئید و مواردی که درمان جراحی برای آن‌ها مطرح است.",
                PickIcon("پاراتیروئید"),
                Url.Content("~/parathyroid-surgery-from-0-to-100/")),
            new TeamSpecialtyPathItemDto(
                "جراحی آدرنال",
                PickText("آدرنال", "فوق") ?? "بررسی و درمان جراحی برخی توده‌ها و بیماری‌های غدد فوق‌کلیوی.",
                PickIcon("آدرنال", "فوق"),
                Url.Content("~/adrenal-surgery-surgical-procedures-and-recovery-period/")),
            new TeamSpecialtyPathItemDto(
                "جراحی پانکراس",
                PickText("پانکراس", "نورواندوکرین") ?? "ارزیابی و درمان جراحی بیماری‌های پانکراس در موارد منتخب.",
                PickIcon("پانکراس", "نورواندوکرین"),
                Url.Content("~/services/pancreatic/")),
            new TeamSpecialtyPathItemDto(
                "روش‌های کم‌تهاجمی جراحی غدد",
                PickText("کم‌تهاجمی", "کم تهاجمی") ?? "انتخاب روش مناسب بر اساس شرایط و تشخیص هر بیمار.",
                PickIcon("کم‌تهاجمی", "کم تهاجمی"),
                Url.Content("~/endoscopic-thyroid-surgery/"))
        ];
    }

    var educationPathItems = TeamEducationPathJson.Parse(Model.EducationPathJson);
    var scientificActivityItems = TeamScientificActivityJson.Parse(Model.ScientificActivityJson);
    var faqItems = TeamFaqJson.Parse(Model.FaqJson);
    // Takyar profile: do not show credential chips in the hero.
    var hideCredentialMeta = Model.Slug.Contains("takyar", StringComparison.OrdinalIgnoreCase)
        || Model.Title.Contains("تکیار", StringComparison.Ordinal);
    var metaChips = hideCredentialMeta
        ? new List<string>()
        : TeamHighlights.Parse(Model.Highlights).ToList();
}

<section class="page-hero page-hero--doctor-single" aria-labelledby="page-hero-title">
  <div class="container doctor-single-hero">
    <div class="doctor-single-hero__copy">
      <nav class="page-breadcrumb reveal" aria-label="مسیر صفحه">
        <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <a asp-controller="Teams" asp-action="Index">متخصصان کلینیک</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">@Model.Title</span>
      </nav>

      <p class="doctor-single-hero__role reveal">@role</p>
      <h1 class="page-hero__title reveal" id="page-hero-title">@Model.Title</h1>
      <p class="doctor-single-hero__specialty reveal">@specialty</p>
      <p class="page-hero__lead reveal">@lead</p>

      @if (metaChips.Count > 0)
      {
      <ul class="doctor-single-meta reveal" aria-label="اعتبار حرفه‌ای">
        @foreach (var chip in metaChips)
        {
          <li>@chip</li>
        }
      </ul>
      }

      <div class="doctor-single-hero__actions reveal">
        <button class="btn-primary-custom" type="button" data-booking-open>
          <span class="ui-icon btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <path d="M16 2v4M8 2v4M3 10h18"/>
            </svg>
          </span>
          رزرو نوبت مشاوره
        </button>
        <a class="btn-secondary-custom" href="@telHref">
          <span class="ui-icon btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="phone-ltr">@phoneDisplay</span>
        </a>
      </div>
    </div>

    <figure class="doctor-single-hero__media">
      <img
        lcp
        src="@cover"
        width="640"
        height="800"
        alt="@(Model.CoverImageAlt ?? Model.Title)" />
    </figure>
  </div>
</section>

<section class="doctor-about" aria-labelledby="doctor-about-heading">
  <div class="container">
    <div class="doctor-about__layout">
      <div class="doctor-about__main reveal">
        <p class="section-kicker">درباره پزشک</p>
        <h2 class="section-heading" id="doctor-about-heading">معرفی @Model.Title</h2>
        <div class="doctor-about__body">
          @if (hasBody)
          {
            @Html.Raw(Model.Body)
          }
          else
          {
            <p>@lead</p>
          }
        </div>
      </div>

      <aside class="doctor-about__aside reveal" aria-label="اطلاعات سریع">
        <h3 class="doctor-about__aside-title">اطلاعات سریع</h3>
        <ul class="doctor-quick-list">
          <li>
            <span class="doctor-quick-list__label">تخصص</span>
            <span class="doctor-quick-list__value">@quickSpecialty</span>
          </li>
          <li>
            <span class="doctor-quick-list__label">ساعات پاسخگویی</span>
            <span class="doctor-quick-list__value">شنبه تا پنجشنبه · ۹ تا ۲۱</span>
          </li>
          <li>
            <span class="doctor-quick-list__label">آدرس</span>
            <span class="doctor-quick-list__value">@address</span>
          </li>
          <li>
            <span class="doctor-quick-list__label">تلفن</span>
            <span class="doctor-quick-list__value"><a class="phone-ltr" href="@telHref">@phoneDisplay</a></span>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

@if (educationPathItems.Count > 0)
{
<section class="doctor-education" aria-labelledby="doctor-education-heading">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-kicker">مسیر تخصصی</p>
      <h2 class="section-heading" id="doctor-education-heading">تحصیلات و تخصص</h2>
    </div>

    <ol class="doctor-timeline">
      @foreach (var item in educationPathItems)
      {
      <li class="doctor-timeline__item reveal">
        <span class="doctor-timeline__year">@item.Year</span>
        <div class="doctor-timeline__body">
          <h3 class="doctor-timeline__title">@item.Title</h3>
          <p class="doctor-timeline__place">@item.Place</p>
        </div>
      </li>
      }
    </ol>
  </div>
</section>
}

@if (specialtyPathItems.Count > 0)
{
<section class="doctor-focus" aria-labelledby="doctor-focus-heading">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-kicker">حوزه فعالیت</p>
      <h2 class="section-heading" id="doctor-focus-heading">زمینه‌های اصلی فعالیت</h2>
      <p class="section-lead">تمرکز بالینی و تخصصی @Model.Title.</p>
    </div>

    <div class="doctor-focus__grid">
      @for (var i = 0; i < specialtyPathItems.Count; i++)
      {
        var item = specialtyPathItems[i];
        var hasIcon = !string.IsNullOrWhiteSpace(item.IconUrl);
        var hasLink = !string.IsNullOrWhiteSpace(item.Url);
        if (hasLink)
        {
          @:<a class="doctor-focus__item reveal" href="@item.Url">
        }
        else
        {
          @:<article class="doctor-focus__item reveal">
        }
        <span class="doctor-focus__icon" aria-hidden="true">
          @if (hasIcon)
          {
            <img src="@item.IconUrl" alt="" loading="lazy" />
          }
          else
          {
            switch (i % 6)
            {
              case 0:
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.1 11.6C11.8 7.4 8.6 5 6.1 6.3c-2.8 1.5-2 7-.4 11.1 1.5 3.9 4.4 7.3 7 5.7 2-1.2.7-5 3.3-5s1.3 3.8 3.3 5c2.6 1.6 5.5-1.8 7-5.7 1.6-4.1 2.4-9.6-.4-11.1-2.5-1.3-5.7 1.1-8 5.3"/>
                  <path d="M14.1 11.6c.5 1.6 3.3 1.6 3.8 0M14.5 15.3h3"/>
                </svg>
                break;
              case 1:
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.1 11.6C11.8 7.4 8.6 5 6.1 6.3c-2.8 1.5-2 7-.4 11.1 1.5 3.9 4.4 7.3 7 5.7 2-1.2.7-5 3.3-5s1.3 3.8 3.3 5c2.6 1.6 5.5-1.8 7-5.7 1.6-4.1 2.4-9.6-.4-11.1-2.5-1.3-5.7 1.1-8 5.3"/>
                  <g fill="currentColor" stroke="none">
                    <circle cx="9.3" cy="10.8" r="1.45"/>
                    <circle cx="10.1" cy="17.6" r="1.45"/>
                    <circle cx="22.7" cy="10.8" r="1.45"/>
                    <circle cx="21.9" cy="17.6" r="1.45"/>
                  </g>
                </svg>
                break;
              case 2:
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12.8 10.8c-1.1-2-3-3.1-5-2.4-3.4 1.2-4.5 6.9-3.1 11.2 1 3.2 3.3 5.2 5.5 4.5 2.3-.7 2.9-3.2 2.6-5.9-.2-2.3-1.6-4.5 0-7.4zM19.2 10.8c1.1-2 3-3.1 5-2.4 3.4 1.2 4.5 6.9 3.1 11.2-1 3.2-3.3 5.2-5.5 4.5-2.3-.7-2.9-3.2-2.6-5.9.2-2.3 1.6-4.5 0-7.4z"/>
                  <path d="M5.7 7.9C6.9 4.4 9.1 3 11.2 4.2c1.2.7 1.8 2.2 1.6 4.1M26.3 7.9C25.1 4.4 22.9 3 20.8 4.2c-1.2.7-1.8 2.2-1.6 4.1"/>
                </svg>
                break;
              case 3:
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path fill="currentColor" fill-opacity=".12" d="M3.8 19.7c2.4-5.4 6.4-7.9 11.2-7.4 3.2.3 4.1-2.7 7.7-2.5 3.2.2 5.8 2.5 5.5 5.5-.4 3.3-4.2 5.1-7.4 5.4-3.9.4-6.6-1.4-10.2-1.1-2.4.2-4.5 1.2-6.2 2.4z"/>
                  <path d="M3.8 19.7c2.4-5.4 6.4-7.9 11.2-7.4 3.2.3 4.1-2.7 7.7-2.5 3.2.2 5.8 2.5 5.5 5.5-.4 3.3-4.2 5.1-7.4 5.4-3.9.4-6.6-1.4-10.2-1.1-2.4.2-4.5 1.2-6.2 2.4"/>
                  <path d="M7.9 17.8c2.3-2.2 5.2-2.8 8.4-2.1 2.7.6 5.3.2 7.5-1.4"/>
                  <circle cx="24.5" cy="13.3" r=".8" fill="currentColor" stroke="none"/>
                </svg>
                break;
              case 4:
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="4" rx="1"/>
                  <path d="M6.5 7v5a6 6 0 0 0 6 6H15"/>
                  <circle cx="18" cy="18" r="3"/>
                  <path d="M18 15v-4M16 11h4"/>
                </svg>
                break;
              default:
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                break;
            }
          }
        </span>
        <h3 class="doctor-focus__title">@item.Title</h3>
        @if (!string.IsNullOrWhiteSpace(item.Text))
        {
          <p class="doctor-focus__text">@item.Text</p>
        }
        if (hasLink)
        {
          @:</a>
        }
        else
        {
          @:</article>
        }
      }
    </div>
  </div>
</section>
}

@if (scientificActivityItems.Count > 0)
{
<section class="doctor-activity" aria-labelledby="doctor-activity-heading">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-kicker">فعالیت علمی</p>
      <h2 class="section-heading" id="doctor-activity-heading">فعالیت‌های علمی و تخصصی</h2>
      <p class="section-lead">حضور در کنگره‌ها و برنامه‌های علمی مرتبط با تخصص @Model.Title.</p>
    </div>

    <ul class="doctor-activity__list">
      @foreach (var item in scientificActivityItems)
      {
      <li class="reveal">@item.Text</li>
      }
    </ul>
  </div>
</section>
}

@if (faqItems.Count > 0)
{
<section class="faq-section doctor-faq" aria-labelledby="doctor-faq-heading">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <p class="section-kicker">راهنما</p>
      <h2 class="section-heading" id="doctor-faq-heading">سوالات متداول</h2>
      <p class="section-lead">پاسخ‌های کوتاه برای هماهنگی مراجعه و مشاوره با @Model.Title.</p>
    </div>

    <div class="faq-list reveal">
      @for (var i = 0; i < faqItems.Count; i++)
      {
        var faq = faqItems[i];
        var isOpen = i == 0;
      <div class="faq-item@(isOpen ? " is-open" : null)">
        <button class="faq-item__question" type="button" aria-expanded="@(isOpen ? "true" : "false")">
          @faq.Question
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">@faq.Answer</div>
      </div>
      }
    </div>
  </div>
</section>
}

@if (related.Count > 0)
{
<section class="doctors-overview" aria-labelledby="doctor-related-heading">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-kicker">متخصصان کلینیک</p>
      <h2 class="section-heading" id="doctor-related-heading">سایر متخصصان</h2>
      <p class="section-lead">با دیگر متخصصان @brand آشنا شوید.</p>
    </div>

    <div class="doctor-jump">
      @foreach (var member in related)
      {
        var memberAvatar = !string.IsNullOrWhiteSpace(member.AvatarImageUrl)
            ? member.AvatarImageUrl
            : (!string.IsNullOrWhiteSpace(member.CoverImageUrl) ? member.CoverImageUrl : fallbackCover);
        var memberRole = string.IsNullOrWhiteSpace(member.CategoryName) ? "متخصص کلینیک" : member.CategoryName;
        var memberSpecialty = string.IsNullOrWhiteSpace(member.Subtitle) ? memberRole : member.Subtitle;
        <a class="doctor-jump__item reveal" asp-controller="Teams" asp-action="Details" asp-route-slug="@member.Slug">
          <span class="doctor-jump__avatar">
            <img src="@memberAvatar" width="72" height="72" alt="" loading="lazy">
          </span>
          <span class="doctor-jump__body">
            <span class="doctor-jump__role">@memberRole</span>
            <span class="doctor-jump__name">@member.Title</span>
            <span class="doctor-jump__title">@memberSpecialty</span>
          </span>
          <span class="doctor-jump__action" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
          </span>
        </a>
      }
    </div>

  </div>
</section>
}

<section class="consult-band" id="contact" aria-labelledby="consult-band-heading">
  <div class="container">
    <div class="consult-band__panel reveal">
      <div class="consult-band__copy">
        <p class="consult-band__kicker">نوبت مشاوره</p>
        <h2 class="consult-band__title" id="consult-band-heading">
          آماده‌اید با @Model.Title مشورت کنید؟
        </h2>
        <p class="consult-band__lead">
          برای هماهنگی مشاوره، نوبت رزرو کنید یا مستقیم با کلینیک تماس بگیرید.
        </p>
        <p class="consult-band__meta">شنبه تا پنجشنبه · ۹ تا ۲۱</p>
      </div>

      <div class="consult-band__actions">
        <button class="btn-primary-custom" type="button" data-booking-open>
          <span class="ui-icon btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <path d="M16 2v4M8 2v4M3 10h18"/>
            </svg>
          </span>
          رزرو نوبت آنلاین
        </button>
        <a class="btn-secondary-custom" href="@telHref">
          <span class="ui-icon btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="phone-ltr">@phoneDisplay</span>
        </a>
      </div>
    </div>
  </div>
</section>
