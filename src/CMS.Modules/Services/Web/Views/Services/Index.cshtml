                  <span class="ui-icon btn-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 12H5M12 5l-7 7 7 7"/>
                    </svg>
                  </span>
                  صفحه کامل خدمت
                </a>
              }
              <button class="btn-primary-custom" type="button" data-booking-open>
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                </span>
                رزرو مشاوره آدرنال
              </button>
            </div>
          </div>
          <aside class="service-detail__aside" aria-label="نکته جراحی آدرنال">
            <span class="service-detail__aside-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 8h.01M11 12h1v4h1"/>
              </svg>
            </span>
            <h3 class="service-detail__aside-title">روش متناسب با شرایط</h3>
            <p>
              انتخاب بین لاپاراسکوپی و جراحی باز بر اساس اندازه توده، احتمال بدخیمی و وضعیت کلی بیمار انجام می‌شود.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="service-detail service-detail--alt" id="pancreas" aria-labelledby="pancreas-heading">
      <div class="container">
        <div class="service-detail__grid reveal">
          <div class="service-detail__content">
            <p class="section-kicker">گروه ۴</p>
            <h2 class="section-heading" id="pancreas-heading">تومورهای پانکراس و نورواندوکرین</h2>
            <p class="service-detail__lead">
              پانکراس می‌تواند دچار تومورهای عملکردی و غیرعملکردی شود که برخی بسیار نادر و پیچیده‌اند و اغلب به رویکرد چندرشته‌ای نیاز دارند.
            </p>
            <ul class="service-detail__list">
              <li>انسولینوما و گاسترینوما</li>
              <li>آدنوکارسینوم پانکراس</li>
              <li>تومورهای نورواندوکرین (NET)</li>
              <li>هماهنگی میان تخصص‌های مرتبط برای بهترین مسیر درمان</li>
            </ul>
            <div class="service-detail__actions">
              @if (pancreasService is not null)
              {
                <a class="btn-secondary-custom" asp-controller="Services" asp-action="Details" asp-route-slug="@pancreasService.Slug">
                  <span class="ui-icon btn-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 12H5M12 5l-7 7 7 7"/>
                    </svg>
                  </span>
                  صفحه کامل خدمت
                </a>
              }
              <button class="btn-primary-custom" type="button" data-booking-open>
                <span class="ui-icon btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                </span>
                رزرو مشاوره پانکراس
              </button>
            </div>
          </div>
          <aside class="service-detail__aside" aria-label="نکته تومورهای پانکراس">
            <span class="service-detail__aside-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <h3 class="service-detail__aside-title">رویکرد چندرشته‌ای</h3>
            <p>
              در موارد پیچیده، ارتباط میان متخصصان مختلف برای برنامه‌ریزی دقیق درمان و کاهش عوارض برقرار می‌شود.
            </p>
          </aside>
        </div>
      </div>
    </section>

@if (items.Count > 0)
{
    <section class="services-overview" aria-labelledby="cms-services-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-kicker">آرشیو</p>
          <h2 class="section-heading" id="cms-services-heading">همه خدمات منتشرشده</h2>
          <p class="section-lead">فهرست خدمات ثبت‌شده در سایت؛ برای جزئیات کامل وارد صفحه هر خدمت شوید.</p>
        </div>
        <div class="service-groups">
          @foreach (var item in items)
          {
            <a class="service-group reveal" asp-controller="Services" asp-action="Details" asp-route-slug="@item.Slug">
              <span class="service-group__icon" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                {
                  <img src="@item.CoverImageUrl" alt="@(item.CoverImageAlt ?? item.Title)" width="32" height="32" style="width:2rem;height:2rem;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/>
                    <circle cx="12" cy="12" r="3.2"/>
                  </svg>
                }
              </span>
              <span class="service-group__body">
                <span class="service-group__title">@item.Title</span>
                <span class="service-group__text">@(string.IsNullOrWhiteSpace(item.Excerpt) ? (item.CategoryName ?? "مشاهده جزئیات خدمت") : item.Excerpt)</span>
              </span>
              <span class="service-group__action" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
              </span>
            </a>
          }
        </div>
      </div>
    </section>
}

    <section class="cta-section" id="contact" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-panel reveal">
          <div class="row align-items-center g-4">
            <div class="col-lg-7">
              <p class="section-kicker section-kicker--light">ارتباط</p>
              <h2 class="section-heading" id="cta-heading">برای انتخاب مسیر درمان مشاوره بگیرید</h2>
              <p class="section-lead">
                تیم نووا کلینیک آماده‌اند تا بر اساس شرایط شما، مناسب‌ترین خدمت و روش درمانی را پیشنهاد دهند.
              </p>
              <div class="hero-actions" style="margin-top: 1rem; margin-bottom: 0;">
                <a class="btn-light-custom" href="@telHref">
                  <span class="ui-icon btn-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  </span>
                  <span class="phone-ltr">@phoneDisplay</span>
                </a>
                <button class="btn-outline-custom" type="button" data-booking-open>
                  <span class="ui-icon btn-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2"/>
                      <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                  </span>
                  رزرو نوبت آنلاین
                </button>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="cta-contact">
                <div class="cta-contact__item">
                  <span class="cta-contact__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 7v5l3 2"/>
                    </svg>
                  </span>
                  <div class="cta-contact__body">
                    <strong>ساعات پاسخگویی</strong>
                    شنبه تا پنجشنبه، ۹ تا ۲۱
                  </div>
                </div>
                <div class="cta-contact__item">
                  <span class="cta-contact__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  </span>
                  <div class="cta-contact__body">
                    <strong>نشانی کلینیک</strong>
                    @address
                  </div>
                </div>
                <div class="cta-contact__item">
                  <span class="cta-contact__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"/>
                      <path d="m22 7-10 7L2 7"/>
                    </svg>
                  </span>
                  <div class="cta-contact__body">
                    <strong>ایمیل</strong>
                    <a href="mailto:@(contactEmail)">@contactEmail</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
