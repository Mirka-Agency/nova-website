@model IReadOnlyList<PublicServiceItemSummaryDto>
@using CMS.Application.Settings
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = "خدمات";
    ViewData["NavActive"] = "services";
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var address = contact.Address;
    var items = Model ?? Array.Empty<PublicServiceItemSummaryDto>();

    PublicServiceItemSummaryDto? FindService(params string[] needles)
    {
        foreach (var item in items)
        {
            var hay = $"{item.Slug} {item.Title} {item.CategoryName} {item.Excerpt}";
            foreach (var needle in needles)
            {
                if (hay.Contains(needle, StringComparison.OrdinalIgnoreCase))
                    return item;
            }
        }

        return null;
    }

    var thyroidService = FindService("thyroid", "تیروئید");
    var parathyroidService = FindService("parathyroid", "پاراتیروئید");
    var adrenalService = FindService("adrenal", "آدرنال", "فوق کلیه");
    var pancreasService = FindService("pancreas", "پانکراس");
}

<section class="page-hero" aria-labelledby="page-hero-title">
      <div class="container page-hero__inner">
        <nav class="page-breadcrumb reveal" aria-label="مسیر صفحه">
          <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
          <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">خدمات</span>
        </nav>
        <h1 class="page-hero__title reveal" id="page-hero-title">خدمات تخصصی نووا کلینیک</h1>
        <p class="page-hero__lead reveal">
          پوشش جامع بیماری‌های غدد درون‌ریز با روش‌های نوین جراحی؛ از تشخیص دقیق تا درمان کم‌تهاجمی و پیگیری پس از عمل.
        </p>
      </div>
    </section>

    <section class="services-overview" aria-label="گروه‌های تخصصی خدمات">
