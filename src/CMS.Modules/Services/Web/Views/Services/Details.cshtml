@model PublicServiceItemDetailDto
@using System.Net
@using System.Text.RegularExpressions
@using CMS.Application.Formatting
@using CMS.Application.Settings
@using CMS.Modules.Services.Application.Common
@using CMS.Modules.Services.Application.ServiceItems
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = Model.Title;
    ViewData["NavActive"] = "services";
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var brand = contact.Brand;
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var category = string.IsNullOrWhiteSpace(Model.CategoryName) ? "خدمت تخصصی" : Model.CategoryName;
    var lead = string.IsNullOrWhiteSpace(Model.Excerpt)
        ? $"راهنمای تخصصی «{Model.Title}» در {brand}."
        : Model.Excerpt;
    var faqItems = ServiceItemFaqJson.Parse(Model.FaqJson);
    var contentGuide = ServiceItemContentGuideJson.Parse(Model.ContentGuideJson);
    var showContentGuide = ServiceItemContentGuideJson.ShouldRender(contentGuide);
    var videoSchemaItems = ServiceItemVideoSchemaJson.Parse(Model.VideoSchemaJson);
    var pageUrl = string.IsNullOrWhiteSpace(Model.CanonicalUrl)
        ? null
        : Model.CanonicalUrl.Trim();
    var videoSchemaJsonLd = ServiceItemVideoSchemaJson.BuildJsonLd(videoSchemaItems, pageUrl);
    var cover = string.IsNullOrWhiteSpace(Model.CoverImageUrl)
        ? Url.Content("~/template/assets/images/blog/thyroid-risks.webp")
        : Model.CoverImageUrl;
    CMS.Application.Seo.LcpImageHints.TryRegister(ViewData, cover);
    var related = (ViewBag.Related as IReadOnlyList<PublicServiceItemSummaryDto>)
        ?? Array.Empty<PublicServiceItemSummaryDto>();
    var updatedLocal = Model.UpdatedAtUtc.Kind == DateTimeKind.Utc
        ? Model.UpdatedAtUtc.ToLocalTime()
        : Model.UpdatedAtUtc;
    var dateAttr = updatedLocal.ToString("yyyy-MM-dd");
    var dateLabel = PersianRelativeDate.Format(Model.UpdatedAtUtc);

    var toc = new List<(string Id, string Text)>();
    var usedIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var headingIndex = 0;
    var idAttrRegex = new Regex(@"\bid\s*=\s*(?:""([^""]*)""|'([^']*)'|([^\s>]+))", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);

    string UniqueHeadingId(string preferred)
    {
        var baseId = string.IsNullOrWhiteSpace(preferred) ? $"h-section-{++headingIndex}" : preferred;
        var candidate = baseId;
        var n = 2;
        while (!usedIds.Add(candidate))
            candidate = $"{baseId}-{n++}";
        return candidate;
    }

    var processedBody = Regex.Replace(
        Model.Body ?? string.Empty,
        @"<h2(\s[^>]*)?>(.*?)</h2>",
        match =>
        {
            var text = WebUtility.HtmlDecode(Regex.Replace(match.Groups[2].Value, "<.*?>", string.Empty)).Trim();
            var attrs = match.Groups[1].Success ? match.Groups[1].Value : string.Empty;
            var existingId = idAttrRegex.Match(attrs);
            // Prefer Yoast-style h-{slug} from heading text (matches nova-clinic.org).
            // Keep an existing id only when it already uses the h- prefix.
            string rawId;
            if (existingId.Success)
            {
                var currentId = existingId.Groups[1].Success ? existingId.Groups[1].Value
                    : existingId.Groups[2].Success ? existingId.Groups[2].Value
                    : existingId.Groups[3].Value;
                rawId = currentId.StartsWith("h-", StringComparison.OrdinalIgnoreCase)
                    ? currentId
                    : SlugGenerator.HeadingIdFromTitle(text);
            }
            else
            {
                rawId = SlugGenerator.HeadingIdFromTitle(text);
            }

            var id = UniqueHeadingId(rawId);

            if (!string.IsNullOrWhiteSpace(text))
                toc.Add((id, text));

            if (existingId.Success)
            {
                var currentId = existingId.Groups[1].Success ? existingId.Groups[1].Value
                    : existingId.Groups[2].Success ? existingId.Groups[2].Value
                    : existingId.Groups[3].Value;
                if (string.Equals(currentId, id, StringComparison.Ordinal))
                    return match.Value;

                attrs = idAttrRegex.Replace(attrs, $" id=\"{id}\"", 1);
                return $"<h2{attrs}>{match.Groups[2].Value}</h2>";
            }

            return $"<h2 id=\"{id}\"{attrs}>{match.Groups[2].Value}</h2>";
        },
        RegexOptions.IgnoreCase | RegexOptions.Singleline);

    var sourceItems = ServiceItemSourcesJson.Parse(Model.SourcesJson);
}

<section class="page-hero page-hero--service-article" aria-labelledby="page-hero-title">
  <div class="container service-article-hero">
    <div class="service-article-hero__copy">
      <nav class="page-breadcrumb reveal" aria-label="مسیر صفحه">
        <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <a asp-controller="Services" asp-action="Index">خدمات</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">@Model.Title</span>
      </nav>

      <h1 class="page-hero__title reveal" id="page-hero-title">@Model.Title</h1>

      <ul class="service-article-meta reveal" aria-label="اطلاعات خدمت">
        <li><time datetime="@dateAttr">@dateLabel</time></li>
        <li>@category</li>
      </ul>

      <p class="page-hero__lead reveal">@lead</p>
    </div>

    <figure class="service-article-hero__media">
      <img
        lcp
        src="@cover"
        width="960"
        height="640"
        alt="@(Model.CoverImageAlt ?? Model.Title)" />
    </figure>
  </div>
</section>

<section class="service-article" aria-label="محتوای @Model.Title">
  <div class="container">
    <div class="service-article__layout@(toc.Count == 0 ? " service-article__layout--no-toc" : null)">
      @if (toc.Count > 0)
      {
        <aside class="service-toc" aria-label="فهرست مطالب" data-service-toc>
          <div class="service-toc__panel">
            <div class="service-toc__header">
              <span class="service-toc__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                </svg>
              </span>
              <div class="service-toc__heading">
                <h2 class="service-toc__title">فهرست مطالب</h2>
              </div>
            </div>
            <nav class="service-toc__nav" aria-label="بخش‌های مطلب">
              <ol class="service-toc__list">
                @foreach (var item in toc)
                {
                  <li><a href="#@item.Id"><span class="service-toc__label">@item.Text</span></a></li>
                }
              </ol>
            </nav>
          </div>
        </aside>
      }

      <div class="service-article__content">
        @if (showContentGuide)
        {
          <aside class="article-content-guide" aria-labelledby="service-content-guide-heading">
            @if (!string.IsNullOrWhiteSpace(contentGuide.Title))
            {
              <header class="article-content-guide__header">
                <h2 class="article-content-guide__title" id="service-content-guide-heading">@contentGuide.Title</h2>
              </header>
            }
            else
            {
              <h2 class="visually-hidden" id="service-content-guide-heading">راهنمای محتوای خدمت</h2>
            }
            <div class="article-content-guide__grid">
              @foreach (var item in contentGuide.Items)
              {
                <div class="article-content-guide__item">
                  <h3 class="article-content-guide__item-title">@item.Title</h3>
                  <p class="article-content-guide__item-desc">@item.Description</p>
                </div>
              }
            </div>
          </aside>
        }

        <article class="service-prose">
          @if (!string.IsNullOrWhiteSpace(processedBody))
          {
            @Html.Raw(processedBody)
          }
          else
          {
            <p>@lead</p>
          }

        </article>

        @if (sourceItems.Count > 0)
        {
          <section class="scientific-sources-section" aria-labelledby="service-sources-heading">
            <div class="scientific-sources reveal" data-scientific-sources-accordion>
              <button class="scientific-sources__toggle"
                      type="button"
                      id="service-sources-heading"
                      aria-expanded="false"
                      aria-controls="service-sources-panel">
                <span class="scientific-sources__title">منابع علمی</span>
                <span class="scientific-sources__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </button>
              <div class="scientific-sources__panel" id="service-sources-panel">
                <div class="scientific-sources__panel-inner">
                  <ol class="scientific-sources__list">
                    @foreach (var source in sourceItems)
                    {
                      <li>
                        <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                      </li>
                    }
                  </ol>
                </div>
              </div>
            </div>
          </section>
        }
      </div>
    </div>
  </div>
</section>

@if (faqItems.Count > 0)
{
<section class="faq-section service-faq" aria-labelledby="service-faq-heading">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <p class="section-kicker">راهنما</p>
      <h2 class="section-heading" id="service-faq-heading">سوالات متداول</h2>
      <p class="section-lead">پاسخ به پرسش‌های پرتکرار پیش از مشاوره و شروع مسیر درمان.</p>
    </div>

    <div class="faq-list reveal">
      @for (var i = 0; i < faqItems.Count; i++)
      {
        var faq = faqItems[i];
        var isOpen = i == 0;
      <div class="faq-item@(isOpen ? " is-open" : null)">
        <button class="faq-item__question" type="button" aria-expanded="@(isOpen ? "true" : "false")">
          @faq.Question
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">@faq.Answer</div>
      </div>
      }
    </div>
  </div>
</section>
}

@if (related.Count > 0)
{
  <section class="service-related" aria-labelledby="service-related-heading">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-kicker">خدمات مرتبط</p>
        <h2 class="section-heading" id="service-related-heading">سایر خدمات تخصصی</h2>
      </div>
      <div class="service-groups">
        @foreach (var item in related)
        {
          var itemCover = string.IsNullOrWhiteSpace(item.CoverImageUrl) ? cover : item.CoverImageUrl;
          var itemText = string.IsNullOrWhiteSpace(item.Excerpt) ? item.Title : item.Excerpt;
          <a class="service-group reveal" asp-controller="Services" asp-action="Details" asp-route-slug="@item.Slug">
            <span class="service-group__body">
              <span class="service-group__title">@item.Title</span>
              <span class="service-group__text">@itemText</span>
            </span>
            <span class="service-group__action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
              </svg>
            </span>
          </a>
        }
      </div>
    </div>
  </section>
}

<section class="consult-band consult-band--service" id="contact" aria-labelledby="consult-band-heading">
  <div class="container">
    <div class="consult-band__panel reveal">
      <div class="consult-band__copy">
        <p class="consult-band__kicker">نوبت مشاوره تخصصی</p>
        <h2 class="consult-band__title" id="consult-band-heading">
          برای بررسی @Model.Title آماده‌اید؟
        </h2>
        <p class="consult-band__lead">
          ارزیابی تخصصی، انتخاب روش مناسب و هماهنگی نوبت — همین حالا رزرو کنید یا با کلینیک تماس بگیرید.
        </p>
        <ul class="consult-band__chips" aria-label="اطلاعات تماس">
          <li>شنبه تا پنجشنبه</li>
          <li>۹ تا ۲۱</li>
          <li>پاسخگویی تلفنی</li>
        </ul>
      </div>

      <div class="consult-band__side">
        <a class="consult-band__phone" href="@telHref">
          <span class="consult-band__phone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="consult-band__phone-text">
            <span class="consult-band__phone-label">تماس مستقیم</span>
            <span class="consult-band__phone-number phone-ltr">@phoneDisplay</span>
          </span>
        </a>
        <div class="consult-band__actions">
          <button class="btn-light-custom" type="button" data-booking-open>
            <span class="ui-icon btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <path d="M16 2v4M8 2v4M3 10h18"/>
              </svg>
            </span>
            رزرو نوبت آنلاین
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

@if (!string.IsNullOrWhiteSpace(videoSchemaJsonLd))
{
  <script type="application/ld+json">
@Html.Raw(videoSchemaJsonLd)
  </script>
}
