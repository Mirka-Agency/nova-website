@model PublicServiceItemDetailDto
@using System.Net
@using System.Text.RegularExpressions
@using CMS.Application.Settings
@inject ISiteSettingsService SiteSettings
@{
    ViewData["Title"] = Model.Title;
    ViewData["NavActive"] = "services";
    var settings = await SiteSettings.GetAsync();
    var contact = SiteContactInfo.From(settings);
    var brand = contact.Brand;
    var phoneDisplay = contact.PhoneDisplay;
    var telHref = contact.TelHref;
    var category = string.IsNullOrWhiteSpace(Model.CategoryName) ? "خدمت تخصصی" : Model.CategoryName;
    var reviewer = string.IsNullOrWhiteSpace(Model.AuthorDisplayName) ? brand : Model.AuthorDisplayName;
    var lead = string.IsNullOrWhiteSpace(Model.Excerpt)
        ? $"راهنمای تخصصی «{Model.Title}» در {brand}."
        : Model.Excerpt;
    var cover = string.IsNullOrWhiteSpace(Model.CoverImageUrl)
        ? Url.Content("~/template/assets/images/blog/thyroid-risks.webp")
        : Model.CoverImageUrl;
    var related = (ViewBag.Related as IReadOnlyList<PublicServiceItemSummaryDto>)
        ?? Array.Empty<PublicServiceItemSummaryDto>();

    var toc = new List<(string Id, string Text)>();
    var headingIndex = 0;
    var processedBody = Regex.Replace(
        Model.Body ?? string.Empty,
        @"<h2(\s[^>]*)?>(.*?)</h2>",
        match =>
        {
            headingIndex++;
            var id = $"section-{headingIndex}";
            var text = WebUtility.HtmlDecode(Regex.Replace(match.Groups[2].Value, "<.*?>", string.Empty)).Trim();
            if (!string.IsNullOrWhiteSpace(text))
                toc.Add((id, text));

            var attrs = match.Groups[1].Success ? match.Groups[1].Value : string.Empty;
            if (attrs.Contains("id=", StringComparison.OrdinalIgnoreCase))
                return match.Value;

            return $"<h2 id=\"{id}\"{attrs}>{match.Groups[2].Value}</h2>";
        },
        RegexOptions.IgnoreCase | RegexOptions.Singleline);

    toc.Add(("service-faq-heading", "سوالات متداول"));
}

<section class="page-hero page-hero--service-article" aria-labelledby="page-hero-title">
  <div class="container service-article-hero">
    <div class="service-article-hero__copy">
      <nav class="page-breadcrumb reveal" aria-label="مسیر صفحه">
        <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <a asp-controller="Services" asp-action="Index">خدمات</a>
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">@Model.Title</span>
      </nav>

      <h1 class="page-hero__title reveal" id="page-hero-title">@Model.Title</h1>

      <ul class="service-article-meta reveal" aria-label="اطلاعات خدمت">
        <li>
          تأیید محتوا:
          <a asp-controller="Teams" asp-action="Index">@reviewer</a>
        </li>
        <li>@category</li>
        <li>@brand</li>
      </ul>

      <p class="page-hero__lead reveal">@lead</p>
    </div>

    <figure class="service-article-hero__media reveal">
      <img
        src="@cover"
        width="960"
        height="640"
        alt="@Model.Title"
        loading="eager"
      >
      <figcaption class="service-article-hero__caption">@Model.Title</figcaption>
    </figure>
  </div>
</section>

<section class="service-article" aria-label="محتوای @Model.Title">
  <div class="container">
    <div class="service-article__layout@(toc.Count <= 1 ? " service-article__layout--no-toc" : null)">
      @if (toc.Count > 1)
      {
        <aside class="service-toc" aria-label="فهرست مطالب" data-service-toc>
          <div class="service-toc__panel">
            <p class="service-toc__title">فهرست مطالب</p>
            <nav class="service-toc__nav" aria-label="بخش‌های مطلب">
              <ol class="service-toc__list">
                @foreach (var item in toc)
                {
                  <li><a href="#@item.Id">@item.Text</a></li>
                }
              </ol>
            </nav>
          </div>
        </aside>
      }

      <div class="service-article__content">
        <article class="service-prose">
          @if (!string.IsNullOrWhiteSpace(processedBody))
          {
            @Html.Raw(processedBody)
          }
          else
          {
            <p>@lead</p>
          }

          <p class="service-prose__cta">
            <button class="btn-primary-custom" type="button" data-booking-open>درخواست مشاوره</button>
            <a class="btn-secondary-custom" href="@telHref">
              <span class="phone-ltr">@phoneDisplay</span>
            </a>
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="faq-section service-faq" aria-labelledby="service-faq-heading">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <p class="section-kicker">راهنما</p>
      <h2 class="section-heading" id="service-faq-heading">سوالات متداول @Model.Title</h2>
      <p class="section-lead">پاسخ به پرسش‌های پرتکرار پیش از مشاوره و شروع مسیر درمان.</p>
    </div>

    <div class="faq-list reveal">
      <div class="faq-item is-open">
        <button class="faq-item__question" type="button" aria-expanded="true">
          این خدمت شامل چه مواردی است؟
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">@lead</div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" type="button" aria-expanded="false">
          چه زمانی باید مراجعه کنم؟
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">
          اگر علائم مرتبط دارید، یافته غیرطبیعی در تصویربرداری/آزمایش‌ها گزارش شده، یا پزشک معالج جراحی را مطرح کرده، ارزیابی تخصصی توصیه می‌شود.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" type="button" aria-expanded="false">
          چگونه نوبت مشاوره بگیریم؟
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">
          از طریق رزرو نوبت آنلاین در همین صفحه یا تماس با شماره
          <a class="phone-ltr" href="@telHref">@phoneDisplay</a>
          می‌توانید اقدام کنید.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" type="button" aria-expanded="false">
          چه کسی محتوای این خدمت را تأیید می‌کند؟
          <span class="faq-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </button>
        <div class="faq-item__answer">محتوای این صفحه با نظارت تخصصی @reviewer در @brand ارائه می‌شود.</div>
      </div>
    </div>
  </div>
</section>

@if (related.Count > 0)
{
  <section class="service-related" aria-labelledby="service-related-heading">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-kicker">خدمات مرتبط</p>
        <h2 class="section-heading" id="service-related-heading">سایر خدمات تخصصی</h2>
      </div>
      <div class="service-groups">
        @foreach (var item in related)
        {
          var itemCover = string.IsNullOrWhiteSpace(item.CoverImageUrl) ? cover : item.CoverImageUrl;
          var itemText = string.IsNullOrWhiteSpace(item.Excerpt) ? item.Title : item.Excerpt;
          <a class="service-group reveal" asp-controller="Services" asp-action="Details" asp-route-slug="@item.Slug">
            <span class="service-group__body">
              <span class="service-group__title">@item.Title</span>
              <span class="service-group__text">@itemText</span>
            </span>
            <span class="service-group__action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
              </svg>
            </span>
          </a>
        }
      </div>
    </div>
  </section>
}

<section class="consult-band consult-band--service" id="contact" aria-labelledby="consult-band-heading">
  <div class="container">
    <div class="consult-band__panel reveal">
      <div class="consult-band__copy">
        <p class="consult-band__kicker">نوبت مشاوره تخصصی</p>
        <h2 class="consult-band__title" id="consult-band-heading">
          برای بررسی @Model.Title آماده‌اید؟
        </h2>
        <p class="consult-band__lead">
          ارزیابی تخصصی، انتخاب روش مناسب و هماهنگی نوبت — همین حالا رزرو کنید یا با کلینیک تماس بگیرید.
        </p>
        <ul class="consult-band__chips" aria-label="اطلاعات تماس">
          <li>شنبه تا پنجشنبه</li>
          <li>۹ تا ۲۱</li>
          <li>پاسخگویی تلفنی</li>
        </ul>
      </div>

      <div class="consult-band__side">
        <a class="consult-band__phone" href="@telHref">
          <span class="consult-band__phone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="consult-band__phone-text">
            <span class="consult-band__phone-label">تماس مستقیم</span>
            <span class="consult-band__phone-number phone-ltr">@phoneDisplay</span>
          </span>
        </a>
        <div class="consult-band__actions">
          <button class="btn-light-custom" type="button" data-booking-open>
            <span class="ui-icon btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <path d="M16 2v4M8 2v4M3 10h18"/>
              </svg>
            </span>
            رزرو نوبت آنلاین
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
