@model ServiceItemFormViewModel
@using CMS.Application.Common.Features
@using CMS.Modules.Seo.Web
@using Microsoft.Extensions.Localization
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager
@inject IStringLocalizer<SeoAdmin> SeoLocalizer
@{
    var seoEnabled = await FeatureManager.IsEnabledAsync(FeatureNames.Seo);
}

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        @if (seoEnabled)
        {
            <nav class="admin-tabs admin-post-editor-tabs" data-post-editor-tabs aria-label="@SeoLocalizer["SeoAnalysis"]">
                <button type="button" class="admin-tab is-active" data-post-editor-tab="content">@SeoLocalizer["TabContent"]</button>
                <button type="button" class="admin-tab" data-post-editor-tab="seo">@SeoLocalizer["SeoAnalysis"]</button>
            </nav>
        }

        <div class="admin-post-editor-panel" data-post-editor-panel="content">
        <div class="admin-field">
            <label asp-for="Title">@Localizer["Title"]</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Slug">@Localizer["Slug"]</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Excerpt">@Localizer["ShortDescription"]</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <p class="admin-hint">@Localizer["ShortDescriptionHint"]</p>
            <span asp-validation-for="Excerpt" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Body">@Localizer["Body"]</label>
            <textarea asp-for="Body"
                      rows="16"
                      class="admin-ckeditor-source"></textarea>
            <span asp-validation-for="Body" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset" data-scientific-sources>
            <legend>@Localizer["ScientificSources"]</legend>
            <p class="admin-hint">@Localizer["ScientificSourcesHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-scientific-sources-list>
                    @for (var i = 0; i < Model.SourcesItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-scientific-sources-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SourcesItems[i].Title">@Localizer["SourceTitle"]</label>
                                <input asp-for="SourcesItems[i].Title"
                                       placeholder="@Localizer["SourceTitlePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="500" />
                                <span asp-validation-for="SourcesItems[i].Title" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SourcesItems[i].Url">@Localizer["SourceUrl"]</label>
                                <input asp-for="SourcesItems[i].Url"
                                       type="url"
                                       dir="ltr"
                                       placeholder="@Localizer["SourceUrlPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="1000" />
                                <span asp-validation-for="SourcesItems[i].Url" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions admin-content-guide-row-actions">
                                <button type="button" class="btn btn-ghost" data-scientific-sources-move-up title="@Localizer["SourceMoveUp"]">
                                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                                    <span class="sr-only">@Localizer["SourceMoveUp"]</span>
                                </button>
                                <button type="button" class="btn btn-ghost" data-scientific-sources-move-down title="@Localizer["SourceMoveDown"]">
                                    <i class="fas fa-arrow-down" aria-hidden="true"></i>
                                    <span class="sr-only">@Localizer["SourceMoveDown"]</span>
                                </button>
                                <button type="button" class="btn btn-text-danger" data-scientific-sources-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-scientific-sources-empty @(Model.SourcesItems.Count > 0 ? "hidden" : null)>
                    @Localizer["SourcesEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-scientific-sources-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddSourceItem"]</span>
                    </button>
                </div>
            </div>

            <template id="scientific-sources-row-template" data-scientific-sources-template>
                <div class="admin-faq-row" data-scientific-sources-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SourceTitle"]</label>
                        <input name="SourcesItems[__INDEX__].Title"
                               placeholder="@Localizer["SourceTitlePlaceholder"]"
                               autocomplete="off"
                               maxlength="500" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SourceUrl"]</label>
                        <input name="SourcesItems[__INDEX__].Url"
                               type="url"
                               dir="ltr"
                               placeholder="@Localizer["SourceUrlPlaceholder"]"
                               autocomplete="off"
                               maxlength="1000" />
                    </div>
                    <div class="admin-faq-row-actions admin-content-guide-row-actions">
                        <button type="button" class="btn btn-ghost" data-scientific-sources-move-up title="@Localizer["SourceMoveUp"]">
                            <i class="fas fa-arrow-up" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["SourceMoveUp"]</span>
                        </button>
                        <button type="button" class="btn btn-ghost" data-scientific-sources-move-down title="@Localizer["SourceMoveDown"]">
                            <i class="fas fa-arrow-down" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["SourceMoveDown"]</span>
                        </button>
                        <button type="button" class="btn btn-text-danger" data-scientific-sources-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset" data-post-faq>
            <legend>@Localizer["FaqSettings"]</legend>
            <p class="admin-hint">@Localizer["FaqSettingsHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-faq-list>
                    @for (var i = 0; i < Model.FaqItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-faq-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="FaqItems[i].Question">@Localizer["FaqQuestion"]</label>
                                <input asp-for="FaqItems[i].Question"
                                       placeholder="@Localizer["FaqQuestionPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="500" />
                                <span asp-validation-for="FaqItems[i].Question" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="FaqItems[i].Answer">@Localizer["FaqAnswer"]</label>
                                <textarea asp-for="FaqItems[i].Answer"
                                          rows="3"
                                          placeholder="@Localizer["FaqAnswerPlaceholder"]"
                                          maxlength="5000"></textarea>
                                <span asp-validation-for="FaqItems[i].Answer" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions">
                                <button type="button" class="btn btn-text-danger" data-faq-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-faq-empty @(Model.FaqItems.Count > 0 ? "hidden" : null)>
                    @Localizer["FaqEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-faq-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddFaqItem"]</span>
                    </button>
                </div>
            </div>

            <template id="post-faq-row-template">
                <div class="admin-faq-row" data-faq-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["FaqQuestion"]</label>
                        <input name="FaqItems[__INDEX__].Question"
                               placeholder="@Localizer["FaqQuestionPlaceholder"]"
                               autocomplete="off"
                               maxlength="500" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["FaqAnswer"]</label>
                        <textarea name="FaqItems[__INDEX__].Answer"
                                  rows="3"
                                  placeholder="@Localizer["FaqAnswerPlaceholder"]"
                                  maxlength="5000"></textarea>
                    </div>
                    <div class="admin-faq-row-actions">
                        <button type="button" class="btn btn-text-danger" data-faq-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["MetaSettings"]</legend>
            <div class="admin-field">
                <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
                <input asp-for="MetaTitle" />
                <p class="admin-hint">@Localizer["MetaTitleHint"]</p>
                <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
                <textarea asp-for="MetaDescription" rows="2"></textarea>
                <p class="admin-hint">@Localizer["MetaDescriptionHint"]</p>
                <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["SeoSettings"]</legend>
            <div class="admin-field">
                <label asp-for="SeoKeywords">@Localizer["SeoKeywords"]</label>
                <input asp-for="SeoKeywords" />
                <p class="admin-hint">@Localizer["SeoKeywordsHint"]</p>
                <span asp-validation-for="SeoKeywords" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CanonicalUrl">@Localizer["CanonicalUrl"]</label>
                <input asp-for="CanonicalUrl" />
                <p class="admin-hint">@Localizer["CanonicalUrlHint"]</p>
                <span asp-validation-for="CanonicalUrl" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgTitle">@Localizer["OgTitle"]</label>
                <input asp-for="OgTitle" />
                <span asp-validation-for="OgTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgDescription">@Localizer["OgDescription"]</label>
                <textarea asp-for="OgDescription" rows="2"></textarea>
                <span asp-validation-for="OgDescription" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label>@Localizer["OgImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#OgImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="OgImageUrl" id="OgImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["OgImageHint"]</p>
                <span asp-validation-for="OgImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#OgImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
                    {
                        <img src="@Model.OgImageUrl" alt="" />
                    }
                </div>
            </div>
        </fieldset>
        </div>

        @if (seoEnabled)
        {
            <div class="admin-post-editor-panel is-hidden" data-post-editor-panel="seo" hidden>
                <partial name="_SeoAnalysisPanel" for="Seo" />
            </div>
        }
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field">
            <label asp-for="CategoryId">@Localizer["Category"]</label>
            <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="AuthorUserId">@Localizer["Author"]</label>
            <select asp-for="AuthorUserId" asp-items="Model.Authors"></select>
            <p class="admin-hint">@Localizer["AuthorHint"]</p>
            <span asp-validation-for="AuthorUserId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label>@Localizer["CoverImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#CoverImageUrl" data-alt-target="#CoverImageAlt">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="CoverImageUrl" id="CoverImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="CoverImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#CoverImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" alt="@Model.CoverImageAlt" />
                }
            </div>
            <div class="admin-field">
                <label asp-for="CoverImageAlt">@Localizer["CoverImageAlt"]</label>
                <input asp-for="CoverImageAlt" id="CoverImageAlt" maxlength="300" />
                <p class="admin-hint">@Localizer["CoverImageAltHint"]</p>
                <span asp-validation-for="CoverImageAlt" class="admin-field-error"></span>
            </div>
        </div>

        <label class="admin-check">
            <input asp-for="Publish" />
            @Localizer["Publish"]
        </label>

        <div class="admin-field">
            <label asp-for="PublishedAtLocal">@Localizer["PublishDate"]</label>
            <input asp-for="PublishedAtLocal"
                   type="text"
                   data-jdp
                   class="admin-input-ltr"
                   autocomplete="off"
                   placeholder="1404/05/19 14:30"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["PublishDateHint"]</p>
            <span asp-validation-for="PublishedAtLocal" class="admin-field-error"></span>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
        <p class="admin-autosave-status" data-post-autosave-status aria-live="polite" hidden></p>
    </aside>
</div>
