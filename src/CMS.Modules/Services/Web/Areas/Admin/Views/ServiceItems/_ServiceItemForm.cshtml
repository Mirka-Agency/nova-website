@model ServiceItemFormViewModel

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        <div class="admin-field">
            <label asp-for="Title">@Localizer["Title"]</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Slug">@Localizer["Slug"]</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Excerpt">@Localizer["ShortDescription"]</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <p class="admin-hint">@Localizer["ShortDescriptionHint"]</p>
            <span asp-validation-for="Excerpt" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Body">@Localizer["Body"]</label>
            <textarea asp-for="Body"
                      rows="16"
                      class="admin-ckeditor-source"></textarea>
            <span asp-validation-for="Body" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["MetaSettings"]</legend>
            <div class="admin-field">
                <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
                <input asp-for="MetaTitle" />
                <p class="admin-hint">@Localizer["MetaTitleHint"]</p>
                <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
                <textarea asp-for="MetaDescription" rows="2"></textarea>
                <p class="admin-hint">@Localizer["MetaDescriptionHint"]</p>
                <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["SeoSettings"]</legend>
            <div class="admin-field">
                <label asp-for="SeoKeywords">@Localizer["SeoKeywords"]</label>
                <input asp-for="SeoKeywords" />
                <p class="admin-hint">@Localizer["SeoKeywordsHint"]</p>
                <span asp-validation-for="SeoKeywords" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CanonicalUrl">@Localizer["CanonicalUrl"]</label>
                <input asp-for="CanonicalUrl" />
                <p class="admin-hint">@Localizer["CanonicalUrlHint"]</p>
                <span asp-validation-for="CanonicalUrl" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgTitle">@Localizer["OgTitle"]</label>
                <input asp-for="OgTitle" />
                <span asp-validation-for="OgTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgDescription">@Localizer["OgDescription"]</label>
                <textarea asp-for="OgDescription" rows="2"></textarea>
                <span asp-validation-for="OgDescription" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label>@Localizer["OgImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#OgImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="OgImageUrl" id="OgImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["OgImageHint"]</p>
                <span asp-validation-for="OgImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#OgImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
                    {
                        <img src="@Model.OgImageUrl" alt="" />
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field">
            <label asp-for="CategoryId">@Localizer["Category"]</label>
            <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="AuthorUserId">@Localizer["Author"]</label>
            <select asp-for="AuthorUserId" asp-items="Model.Authors"></select>
            <p class="admin-hint">@Localizer["AuthorHint"]</p>
            <span asp-validation-for="AuthorUserId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label>@Localizer["CoverImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#CoverImageUrl">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="CoverImageUrl" id="CoverImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="CoverImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#CoverImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" alt="" />
                }
            </div>
        </div>

        <label class="admin-check">
            <input asp-for="Publish" />
            @Localizer["Publish"]
        </label>

        <div class="admin-field">
            <label asp-for="PublishedAtLocal">@Localizer["PublishDate"]</label>
            <input asp-for="PublishedAtLocal"
                   type="text"
                   data-jdp
                   class="admin-input-ltr"
                   autocomplete="off"
                   placeholder="1404/05/19 14:30"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["PublishDateHint"]</p>
            <span asp-validation-for="PublishedAtLocal" class="admin-field-error"></span>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
        <p class="admin-autosave-status" data-post-autosave-status aria-live="polite" hidden></p>
    </aside>
</div>
