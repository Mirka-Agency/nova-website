@model ServiceItemFormViewModel
@using CMS.Application.Common.Features
@using CMS.Modules.Seo.Web
@using Microsoft.Extensions.Localization
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager
@inject IStringLocalizer<SeoAdmin> SeoLocalizer
@{
    var seoEnabled = await FeatureManager.IsEnabledAsync(FeatureNames.Seo);
}

<div asp-validation-summary="ModelOnly" class="admin-validation"></div>

<div class="admin-post-editor">
    <div class="admin-post-editor-main">
        @if (seoEnabled)
        {
            <nav class="admin-tabs admin-post-editor-tabs" data-post-editor-tabs aria-label="@SeoLocalizer["SeoAnalysis"]">
                <button type="button" class="admin-tab is-active" data-post-editor-tab="content">@SeoLocalizer["TabContent"]</button>
                <button type="button" class="admin-tab" data-post-editor-tab="seo">@SeoLocalizer["SeoAnalysis"]</button>
            </nav>
        }

        <div class="admin-post-editor-panel" data-post-editor-panel="content">
        <div class="admin-field">
            <label asp-for="Title">@Localizer["Title"]</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Slug">@Localizer["Slug"]</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Excerpt">@Localizer["ShortDescription"]</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <p class="admin-hint">@Localizer["ShortDescriptionHint"]</p>
            <span asp-validation-for="Excerpt" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Body">@Localizer["Body"]</label>
            <textarea asp-for="Body"
                      rows="16"
                      class="admin-ckeditor-source"></textarea>
            <span asp-validation-for="Body" class="admin-field-error"></span>
        </div>

        <fieldset class="admin-fieldset" data-post-content-guide>
            <legend>@Localizer["ContentGuideSettings"]</legend>
            <p class="admin-hint">@Localizer["ContentGuideSettingsHint"]</p>

            <label class="admin-check">
                <input asp-for="ContentGuideEnabled" type="checkbox" data-content-guide-toggle />
                @Localizer["ContentGuideEnabled"]
            </label>

            <div class="admin-content-guide-fields" data-content-guide-fields @(Model.ContentGuideEnabled ? null : "hidden")>
                <div class="admin-field">
                    <label asp-for="ContentGuideTitle">@Localizer["ContentGuideTitle"]</label>
                    <input asp-for="ContentGuideTitle"
                           placeholder="@Localizer["ContentGuideTitlePlaceholder"]"
                           autocomplete="off"
                           maxlength="300" />
                    <span asp-validation-for="ContentGuideTitle" class="admin-field-error"></span>
                </div>

                <div class="admin-content-guide-list">
                    <div class="admin-content-guide-rows" data-content-guide-list>
                        @for (var i = 0; i < Model.ContentGuideItems.Count; i++)
                        {
                            <div class="admin-content-guide-row" data-content-guide-row>
                                <div class="admin-content-guide-row-main">
                                    <div class="admin-field admin-content-guide-field">
                                        <label asp-for="ContentGuideItems[i].Title">@Localizer["ContentGuideItemTitle"]</label>
                                        <input asp-for="ContentGuideItems[i].Title"
                                               placeholder="@Localizer["ContentGuideItemTitlePlaceholder"]"
                                               autocomplete="off"
                                               maxlength="300" />
                                        <span asp-validation-for="ContentGuideItems[i].Title" class="admin-field-error"></span>
                                    </div>
                                    <div class="admin-field admin-content-guide-field">
                                        <label asp-for="ContentGuideItems[i].Description">@Localizer["ContentGuideItemDescription"]</label>
                                        <input asp-for="ContentGuideItems[i].Description"
                                               placeholder="@Localizer["ContentGuideItemDescriptionPlaceholder"]"
                                               autocomplete="off"
                                               maxlength="500" />
                                        <span asp-validation-for="ContentGuideItems[i].Description" class="admin-field-error"></span>
                                    </div>
                                </div>
                                <div class="admin-content-guide-row-actions">
                                    <button type="button" class="btn btn-ghost" data-content-guide-move-up title="@Localizer["ContentGuideMoveUp"]">
                                        <i class="fas fa-arrow-up" aria-hidden="true"></i>
                                        <span class="sr-only">@Localizer["ContentGuideMoveUp"]</span>
                                    </button>
                                    <button type="button" class="btn btn-ghost" data-content-guide-move-down title="@Localizer["ContentGuideMoveDown"]">
                                        <i class="fas fa-arrow-down" aria-hidden="true"></i>
                                        <span class="sr-only">@Localizer["ContentGuideMoveDown"]</span>
                                    </button>
                                    <button type="button" class="btn btn-text-danger" data-content-guide-remove>
                                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                        <span>@Localizer["Delete"]</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <p class="admin-hint" data-content-guide-empty @(Model.ContentGuideItems.Count > 0 ? "hidden" : null)>
                        @Localizer["ContentGuideEmpty"]
                    </p>

                    <div class="admin-content-guide-add-row">
                        <button type="button" class="btn btn-secondary" data-content-guide-add>
                            <i class="fas fa-plus" aria-hidden="true"></i>
                            <span>@Localizer["AddContentGuideItem"]</span>
                        </button>
                    </div>
                </div>
            </div>

            <template id="post-content-guide-row-template">
                <div class="admin-content-guide-row" data-content-guide-row>
                    <div class="admin-content-guide-row-main">
                        <div class="admin-field admin-content-guide-field">
                            <label>@Localizer["ContentGuideItemTitle"]</label>
                            <input name="ContentGuideItems[__INDEX__].Title"
                                   placeholder="@Localizer["ContentGuideItemTitlePlaceholder"]"
                                   autocomplete="off"
                                   maxlength="300" />
                        </div>
                        <div class="admin-field admin-content-guide-field">
                            <label>@Localizer["ContentGuideItemDescription"]</label>
                            <input name="ContentGuideItems[__INDEX__].Description"
                                   placeholder="@Localizer["ContentGuideItemDescriptionPlaceholder"]"
                                   autocomplete="off"
                                   maxlength="500" />
                        </div>
                    </div>
                    <div class="admin-content-guide-row-actions">
                        <button type="button" class="btn btn-ghost" data-content-guide-move-up title="@Localizer["ContentGuideMoveUp"]">
                            <i class="fas fa-arrow-up" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["ContentGuideMoveUp"]</span>
                        </button>
                        <button type="button" class="btn btn-ghost" data-content-guide-move-down title="@Localizer["ContentGuideMoveDown"]">
                            <i class="fas fa-arrow-down" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["ContentGuideMoveDown"]</span>
                        </button>
                        <button type="button" class="btn btn-text-danger" data-content-guide-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset" data-scientific-sources>
            <legend>@Localizer["ScientificSources"]</legend>
            <p class="admin-hint">@Localizer["ScientificSourcesHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-scientific-sources-list>
                    @for (var i = 0; i < Model.SourcesItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-scientific-sources-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SourcesItems[i].Title">@Localizer["SourceTitle"]</label>
                                <input asp-for="SourcesItems[i].Title"
                                       placeholder="@Localizer["SourceTitlePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="500" />
                                <span asp-validation-for="SourcesItems[i].Title" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="SourcesItems[i].Url">@Localizer["SourceUrl"]</label>
                                <input asp-for="SourcesItems[i].Url"
                                       type="url"
                                       dir="ltr"
                                       placeholder="@Localizer["SourceUrlPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="1000" />
                                <span asp-validation-for="SourcesItems[i].Url" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions admin-content-guide-row-actions">
                                <button type="button" class="btn btn-ghost" data-scientific-sources-move-up title="@Localizer["SourceMoveUp"]">
                                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                                    <span class="sr-only">@Localizer["SourceMoveUp"]</span>
                                </button>
                                <button type="button" class="btn btn-ghost" data-scientific-sources-move-down title="@Localizer["SourceMoveDown"]">
                                    <i class="fas fa-arrow-down" aria-hidden="true"></i>
                                    <span class="sr-only">@Localizer["SourceMoveDown"]</span>
                                </button>
                                <button type="button" class="btn btn-text-danger" data-scientific-sources-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-scientific-sources-empty @(Model.SourcesItems.Count > 0 ? "hidden" : null)>
                    @Localizer["SourcesEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-scientific-sources-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddSourceItem"]</span>
                    </button>
                </div>
            </div>

            <template id="scientific-sources-row-template" data-scientific-sources-template>
                <div class="admin-faq-row" data-scientific-sources-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SourceTitle"]</label>
                        <input name="SourcesItems[__INDEX__].Title"
                               placeholder="@Localizer["SourceTitlePlaceholder"]"
                               autocomplete="off"
                               maxlength="500" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["SourceUrl"]</label>
                        <input name="SourcesItems[__INDEX__].Url"
                               type="url"
                               dir="ltr"
                               placeholder="@Localizer["SourceUrlPlaceholder"]"
                               autocomplete="off"
                               maxlength="1000" />
                    </div>
                    <div class="admin-faq-row-actions admin-content-guide-row-actions">
                        <button type="button" class="btn btn-ghost" data-scientific-sources-move-up title="@Localizer["SourceMoveUp"]">
                            <i class="fas fa-arrow-up" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["SourceMoveUp"]</span>
                        </button>
                        <button type="button" class="btn btn-ghost" data-scientific-sources-move-down title="@Localizer["SourceMoveDown"]">
                            <i class="fas fa-arrow-down" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["SourceMoveDown"]</span>
                        </button>
                        <button type="button" class="btn btn-text-danger" data-scientific-sources-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset" data-post-faq>
            <legend>@Localizer["FaqSettings"]</legend>
            <p class="admin-hint">@Localizer["FaqSettingsHint"]</p>

            <div class="admin-faq-list">
                <div class="admin-faq-rows" data-faq-list>
                    @for (var i = 0; i < Model.FaqItems.Count; i++)
                    {
                        <div class="admin-faq-row" data-faq-row>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="FaqItems[i].Question">@Localizer["FaqQuestion"]</label>
                                <input asp-for="FaqItems[i].Question"
                                       placeholder="@Localizer["FaqQuestionPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="500" />
                                <span asp-validation-for="FaqItems[i].Question" class="admin-field-error"></span>
                            </div>
                            <div class="admin-field admin-faq-field">
                                <label asp-for="FaqItems[i].Answer">@Localizer["FaqAnswer"]</label>
                                <textarea asp-for="FaqItems[i].Answer"
                                          rows="3"
                                          placeholder="@Localizer["FaqAnswerPlaceholder"]"
                                          maxlength="5000"></textarea>
                                <span asp-validation-for="FaqItems[i].Answer" class="admin-field-error"></span>
                            </div>
                            <div class="admin-faq-row-actions">
                                <button type="button" class="btn btn-text-danger" data-faq-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["Delete"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <p class="admin-hint" data-faq-empty @(Model.FaqItems.Count > 0 ? "hidden" : null)>
                    @Localizer["FaqEmpty"]
                </p>

                <div class="admin-faq-add-row">
                    <button type="button" class="btn btn-secondary" data-faq-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddFaqItem"]</span>
                    </button>
                </div>
            </div>

            <template id="post-faq-row-template">
                <div class="admin-faq-row" data-faq-row>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["FaqQuestion"]</label>
                        <input name="FaqItems[__INDEX__].Question"
                               placeholder="@Localizer["FaqQuestionPlaceholder"]"
                               autocomplete="off"
                               maxlength="500" />
                    </div>
                    <div class="admin-field admin-faq-field">
                        <label>@Localizer["FaqAnswer"]</label>
                        <textarea name="FaqItems[__INDEX__].Answer"
                                  rows="3"
                                  placeholder="@Localizer["FaqAnswerPlaceholder"]"
                                  maxlength="5000"></textarea>
                    </div>
                    <div class="admin-faq-row-actions">
                        <button type="button" class="btn btn-text-danger" data-faq-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </div>
                </div>
            </template>
        </fieldset>



        <fieldset class="admin-fieldset admin-video-schema" data-post-video-schema>
            <legend>@Localizer["VideoSchemaSettings"]</legend>
            <p class="admin-hint admin-video-schema-intro">@Localizer["VideoSchemaSettingsHint"]</p>

            <div class="admin-video-schema-list">
                <div class="admin-video-schema-rows" data-video-schema-list>
                    @for (var i = 0; i < Model.VideoSchemaItems.Count; i++)
                    {
                        var thumbId = $"VideoSchemaThumbnailUrl_{i}";
                        var hasThumb = !string.IsNullOrWhiteSpace(Model.VideoSchemaItems[i].ThumbnailUrl);
                        <article class="admin-video-schema-row" data-video-schema-row>
                            <header class="admin-video-schema-row-header">
                                <div class="admin-video-schema-row-heading">
                                    <span class="admin-video-schema-badge" aria-hidden="true" data-video-schema-index>@(i + 1)</span>
                                    <h3 class="admin-video-schema-row-title">@Localizer["VideoSchemaItemLabel"] <span data-video-schema-index-label>@(i + 1)</span></h3>
                                </div>
                                <button type="button" class="btn btn-ghost admin-video-schema-remove" data-video-schema-remove>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    <span>@Localizer["VideoSchemaRemove"]</span>
                                </button>
                            </header>

                            <div class="admin-video-schema-body">
                                <aside class="admin-video-schema-media">
                                    <span class="admin-video-schema-media-label">@Localizer["VideoSchemaThumbnail"]</span>
                                    <div class="admin-video-schema-thumb @(hasThumb ? null : "is-empty")" data-video-schema-thumb>
                                        <div class="admin-video-schema-thumb-frame"
                                             data-media-preview-for="#@thumbId"
                                             data-video-schema-thumb-preview>
                                            @if (hasThumb)
                                            {
                                                <img src="@Model.VideoSchemaItems[i].ThumbnailUrl" alt="" />
                                            }
                                        </div>
                                        <div class="admin-video-schema-thumb-placeholder" aria-hidden="true">
                                            <i class="fas fa-film" aria-hidden="true"></i>
                                            <span>@Localizer["VideoSchemaThumbnail"]</span>
                                        </div>
                                    </div>
                                    <div class="admin-row-actions admin-video-schema-media-actions">
                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-media-picker
                                                data-video-schema-thumb-picker
                                                data-target="#@thumbId">
                                            <i class="fas fa-images" aria-hidden="true"></i>
                                            <span>@Localizer["SelectImage"]</span>
                                        </button>
                                    </div>
                                    <p class="admin-hint">@Localizer["VideoSchemaThumbnailHint"]</p>
                                    <input asp-for="VideoSchemaItems[i].ThumbnailUrl"
                                           id="@thumbId"
                                           type="hidden"
                                           data-video-schema-thumb-input />
                                    <span asp-validation-for="VideoSchemaItems[i].ThumbnailUrl" class="admin-field-error"></span>
                                </aside>

                                <div class="admin-video-schema-fields">
                                    <div class="admin-field">
                                        <label asp-for="VideoSchemaItems[i].Title">@Localizer["VideoSchemaTitle"]</label>
                                        <input asp-for="VideoSchemaItems[i].Title"
                                               placeholder="@Localizer["VideoSchemaTitlePlaceholder"]"
                                               autocomplete="off"
                                               maxlength="300" />
                                        <span asp-validation-for="VideoSchemaItems[i].Title" class="admin-field-error"></span>
                                    </div>

                                    <div class="admin-field">
                                        <label asp-for="VideoSchemaItems[i].ContentUrl">@Localizer["VideoSchemaContentUrl"]</label>
                                        <input asp-for="VideoSchemaItems[i].ContentUrl"
                                               class="admin-input-ltr"
                                               dir="ltr"
                                               placeholder="@Localizer["VideoSchemaContentUrlPlaceholder"]"
                                               autocomplete="off"
                                               maxlength="1000" />
                                        <p class="admin-hint">@Localizer["VideoSchemaContentUrlHint"]</p>
                                        <span asp-validation-for="VideoSchemaItems[i].ContentUrl" class="admin-field-error"></span>
                                    </div>

                                    <div class="admin-video-schema-meta">
                                        <div class="admin-field">
                                            <label asp-for="VideoSchemaItems[i].UploadDate">@Localizer["VideoSchemaUploadDate"]</label>
                                            <input asp-for="VideoSchemaItems[i].UploadDate"
                                                   type="date"
                                                   class="admin-input-ltr"
                                                   dir="ltr"
                                                   autocomplete="off" />
                                            <span asp-validation-for="VideoSchemaItems[i].UploadDate" class="admin-field-error"></span>
                                        </div>
                                        <div class="admin-field">
                                            <span class="admin-label">@Localizer["VideoSchemaDuration"]</span>
                                            <div class="admin-video-schema-duration" role="group" aria-label="@Localizer["VideoSchemaDuration"]">
                                                <div class="admin-video-schema-duration-field">
                                                    <input asp-for="VideoSchemaItems[i].DurationMinutes"
                                                           type="number"
                                                           min="0"
                                                           max="1440"
                                                           class="admin-input-ltr"
                                                           dir="ltr"
                                                           inputmode="numeric"
                                                           aria-label="@Localizer["VideoSchemaMinutes"]" />
                                                    <span>@Localizer["VideoSchemaMinutes"]</span>
                                                </div>
                                                <span class="admin-video-schema-duration-sep" aria-hidden="true">:</span>
                                                <div class="admin-video-schema-duration-field">
                                                    <input asp-for="VideoSchemaItems[i].DurationSeconds"
                                                           type="number"
                                                           min="0"
                                                           max="59"
                                                           class="admin-input-ltr"
                                                           dir="ltr"
                                                           inputmode="numeric"
                                                           aria-label="@Localizer["VideoSchemaSeconds"]" />
                                                    <span>@Localizer["VideoSchemaSeconds"]</span>
                                                </div>
                                            </div>
                                            <span asp-validation-for="VideoSchemaItems[i].DurationMinutes" class="admin-field-error"></span>
                                            <span asp-validation-for="VideoSchemaItems[i].DurationSeconds" class="admin-field-error"></span>
                                        </div>
                                    </div>

                                    <div class="admin-field">
                                        <label asp-for="VideoSchemaItems[i].Description">@Localizer["VideoSchemaDescription"]</label>
                                        <textarea asp-for="VideoSchemaItems[i].Description"
                                                  rows="3"
                                                  placeholder="@Localizer["VideoSchemaDescriptionPlaceholder"]"
                                                  maxlength="5000"></textarea>
                                        <span asp-validation-for="VideoSchemaItems[i].Description" class="admin-field-error"></span>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="admin-video-schema-empty" data-video-schema-empty @(Model.VideoSchemaItems.Count > 0 ? "hidden" : null)>
                    <div class="admin-video-schema-empty-icon" aria-hidden="true">
                        <i class="fas fa-video"></i>
                    </div>
                    <p>@Localizer["VideoSchemaEmpty"]</p>
                </div>

                <div class="admin-video-schema-add-row">
                    <button type="button" class="btn btn-secondary" data-video-schema-add>
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>@Localizer["AddVideoSchemaItem"]</span>
                    </button>
                </div>
            </div>

            <template id="post-video-schema-row-template">
                <article class="admin-video-schema-row" data-video-schema-row>
                    <header class="admin-video-schema-row-header">
                        <div class="admin-video-schema-row-heading">
                            <span class="admin-video-schema-badge" aria-hidden="true" data-video-schema-index>1</span>
                            <h3 class="admin-video-schema-row-title">@Localizer["VideoSchemaItemLabel"] <span data-video-schema-index-label>1</span></h3>
                        </div>
                        <button type="button" class="btn btn-ghost admin-video-schema-remove" data-video-schema-remove>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            <span>@Localizer["VideoSchemaRemove"]</span>
                        </button>
                    </header>

                    <div class="admin-video-schema-body">
                        <aside class="admin-video-schema-media">
                            <span class="admin-video-schema-media-label">@Localizer["VideoSchemaThumbnail"]</span>
                            <div class="admin-video-schema-thumb is-empty" data-video-schema-thumb>
                                <div class="admin-video-schema-thumb-frame"
                                     data-media-preview-for="#VideoSchemaThumbnailUrl___INDEX__"
                                     data-video-schema-thumb-preview></div>
                                <div class="admin-video-schema-thumb-placeholder" aria-hidden="true">
                                    <i class="fas fa-film" aria-hidden="true"></i>
                                    <span>@Localizer["VideoSchemaThumbnail"]</span>
                                </div>
                            </div>
                            <div class="admin-row-actions admin-video-schema-media-actions">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-media-picker
                                        data-video-schema-thumb-picker
                                        data-target="#VideoSchemaThumbnailUrl___INDEX__">
                                    <i class="fas fa-images" aria-hidden="true"></i>
                                    <span>@Localizer["SelectImage"]</span>
                                </button>
                            </div>
                            <p class="admin-hint">@Localizer["VideoSchemaThumbnailHint"]</p>
                            <input name="VideoSchemaItems[__INDEX__].ThumbnailUrl"
                                   id="VideoSchemaThumbnailUrl___INDEX__"
                                   type="hidden"
                                   data-video-schema-thumb-input />
                        </aside>

                        <div class="admin-video-schema-fields">
                            <div class="admin-field">
                                <label>@Localizer["VideoSchemaTitle"]</label>
                                <input name="VideoSchemaItems[__INDEX__].Title"
                                       placeholder="@Localizer["VideoSchemaTitlePlaceholder"]"
                                       autocomplete="off"
                                       maxlength="300" />
                            </div>

                            <div class="admin-field">
                                <label>@Localizer["VideoSchemaContentUrl"]</label>
                                <input name="VideoSchemaItems[__INDEX__].ContentUrl"
                                       class="admin-input-ltr"
                                       dir="ltr"
                                       placeholder="@Localizer["VideoSchemaContentUrlPlaceholder"]"
                                       autocomplete="off"
                                       maxlength="1000" />
                                <p class="admin-hint">@Localizer["VideoSchemaContentUrlHint"]</p>
                            </div>

                            <div class="admin-video-schema-meta">
                                <div class="admin-field">
                                    <label>@Localizer["VideoSchemaUploadDate"]</label>
                                    <input name="VideoSchemaItems[__INDEX__].UploadDate"
                                           type="date"
                                           class="admin-input-ltr"
                                           dir="ltr"
                                           autocomplete="off" />
                                </div>
                                <div class="admin-field">
                                    <span class="admin-label">@Localizer["VideoSchemaDuration"]</span>
                                    <div class="admin-video-schema-duration" role="group" aria-label="@Localizer["VideoSchemaDuration"]">
                                        <div class="admin-video-schema-duration-field">
                                            <input name="VideoSchemaItems[__INDEX__].DurationMinutes"
                                                   type="number"
                                                   min="0"
                                                   max="1440"
                                                   value="0"
                                                   class="admin-input-ltr"
                                                   dir="ltr"
                                                   inputmode="numeric"
                                                   aria-label="@Localizer["VideoSchemaMinutes"]" />
                                            <span>@Localizer["VideoSchemaMinutes"]</span>
                                        </div>
                                        <span class="admin-video-schema-duration-sep" aria-hidden="true">:</span>
                                        <div class="admin-video-schema-duration-field">
                                            <input name="VideoSchemaItems[__INDEX__].DurationSeconds"
                                                   type="number"
                                                   min="0"
                                                   max="59"
                                                   value="0"
                                                   class="admin-input-ltr"
                                                   dir="ltr"
                                                   inputmode="numeric"
                                                   aria-label="@Localizer["VideoSchemaSeconds"]" />
                                            <span>@Localizer["VideoSchemaSeconds"]</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="admin-field">
                                <label>@Localizer["VideoSchemaDescription"]</label>
                                <textarea name="VideoSchemaItems[__INDEX__].Description"
                                          rows="3"
                                          placeholder="@Localizer["VideoSchemaDescriptionPlaceholder"]"
                                          maxlength="5000"></textarea>
                            </div>
                        </div>
                    </div>
                </article>
            </template>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["MetaSettings"]</legend>
            <div class="admin-field">
                <label asp-for="MetaTitle">@Localizer["MetaTitle"]</label>
                <input asp-for="MetaTitle" />
                <p class="admin-hint">@Localizer["MetaTitleHint"]</p>
                <span asp-validation-for="MetaTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="MetaDescription">@Localizer["MetaDescription"]</label>
                <textarea asp-for="MetaDescription" rows="2"></textarea>
                <p class="admin-hint">@Localizer["MetaDescriptionHint"]</p>
                <span asp-validation-for="MetaDescription" class="admin-field-error"></span>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>@Localizer["SeoSettings"]</legend>
            <div class="admin-field">
                <label asp-for="SeoKeywords">@Localizer["SeoKeywords"]</label>
                <input asp-for="SeoKeywords" />
                <p class="admin-hint">@Localizer["SeoKeywordsHint"]</p>
                <span asp-validation-for="SeoKeywords" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CanonicalUrl">@Localizer["CanonicalUrl"]</label>
                <input asp-for="CanonicalUrl" />
                <p class="admin-hint">@Localizer["CanonicalUrlHint"]</p>
                <span asp-validation-for="CanonicalUrl" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgTitle">@Localizer["OgTitle"]</label>
                <input asp-for="OgTitle" />
                <span asp-validation-for="OgTitle" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="OgDescription">@Localizer["OgDescription"]</label>
                <textarea asp-for="OgDescription" rows="2"></textarea>
                <span asp-validation-for="OgDescription" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label>@Localizer["OgImage"]</label>
                <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                    <button type="button" class="btn btn-secondary" data-media-picker data-target="#OgImageUrl">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>@Localizer["SelectImage"]</span>
                    </button>
                </div>
                <input asp-for="OgImageUrl" id="OgImageUrl" type="hidden" />
                <p class="admin-hint">@Localizer["OgImageHint"]</p>
                <span asp-validation-for="OgImageUrl" class="admin-field-error"></span>
                <div class="admin-upload-preview" data-media-preview-for="#OgImageUrl">
                    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
                    {
                        <img src="@Model.OgImageUrl" alt="" />
                    }
                </div>
            </div>
        </fieldset>
        </div>

        @if (seoEnabled)
        {
            <div class="admin-post-editor-panel is-hidden" data-post-editor-panel="seo" hidden>
                <partial name="_SeoAnalysisPanel" for="Seo" />
            </div>
        }
    </div>

    <aside class="admin-post-editor-side">
        <div class="admin-field">
            <label asp-for="CategoryId">@Localizer["Category"]</label>
            <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="AuthorUserId">@Localizer["Author"]</label>
            <select asp-for="AuthorUserId" asp-items="Model.Authors"></select>
            <p class="admin-hint">@Localizer["AuthorHint"]</p>
            <span asp-validation-for="AuthorUserId" class="admin-field-error"></span>
        </div>

        <div class="admin-field">
            <label>@Localizer["CoverImage"]</label>
            <div class="admin-row-actions" style="justify-content: flex-start; margin-block-end: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-media-picker data-target="#CoverImageUrl" data-alt-target="#CoverImageAlt">
                    <i class="fas fa-images" aria-hidden="true"></i>
                    <span>@Localizer["SelectImage"]</span>
                </button>
            </div>
            <input asp-for="CoverImageUrl" id="CoverImageUrl" type="hidden" />
            <p class="admin-hint">@Localizer["SelectImageHint"]</p>
            <span asp-validation-for="CoverImageUrl" class="admin-field-error"></span>
            <div class="admin-upload-preview" data-media-preview-for="#CoverImageUrl">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" alt="@Model.CoverImageAlt" />
                }
            </div>
            <div class="admin-field">
                <label asp-for="CoverImageAlt">@Localizer["CoverImageAlt"]</label>
                <input asp-for="CoverImageAlt" id="CoverImageAlt" maxlength="300" />
                <p class="admin-hint">@Localizer["CoverImageAltHint"]</p>
                <span asp-validation-for="CoverImageAlt" class="admin-field-error"></span>
            </div>
        </div>

        <label class="admin-check">
            <input asp-for="Publish" />
            @Localizer["Publish"]
        </label>

        <div class="admin-field">
            <label asp-for="PublishedAtLocal">@Localizer["PublishDate"]</label>
            <input asp-for="PublishedAtLocal"
                   type="text"
                   data-jdp
                   class="admin-input-ltr"
                   autocomplete="off"
                   placeholder="1404/05/19 14:30"
                   inputmode="numeric" />
            <p class="admin-hint">@Localizer["PublishDateHint"]</p>
            <span asp-validation-for="PublishedAtLocal" class="admin-field-error"></span>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i><span>@Localizer["Save"]</span></button>
            <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-times" aria-hidden="true"></i><span>@Localizer["Cancel"]</span></a>
        </div>
        <p class="admin-autosave-status" data-post-autosave-status aria-live="polite" hidden></p>
    </aside>
</div>
