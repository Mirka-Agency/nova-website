@model CommentIndexViewModel
@{
    var filter = Model.Filter;
    ViewData["Title"] = Localizer["Comments"];
    ViewData["SearchPlaceholder"] = Localizer["Search"].Value;
    ViewData["FilterFieldsPartial"] = "_CommentFilters";
    ViewBag.Filter = filter;
    ViewBag.Search = filter.Search;
    ViewBag.Page = Model.Page;
    ViewBag.PageSize = Model.PageSize;
    ViewBag.TotalPages = Model.TotalPages;
    ViewBag.TotalCount = Model.TotalCount;
    ViewBag.HasActiveFilters = filter.HasActiveFilters;
    ViewBag.FilterClearRouteValues = filter.Status.HasValue
        ? (object)new { area = "Admin", status = (int)filter.Status.Value }
        : new { area = "Admin" };
    var hasFilters = filter.HasActiveFilters || filter.Status.HasValue;

    var statusTabs = new (CommentStatus? Status, string Label)[]
    {
        (null, Localizer["AllStatuses"].Value),
        (CommentStatus.Pending, Localizer["StatusPending"].Value),
        (CommentStatus.Approved, Localizer["StatusApproved"].Value),
        (CommentStatus.Rejected, Localizer["StatusRejected"].Value),
    };

    string StatusBadgeClass(CommentStatus status) => status switch
    {
        CommentStatus.Pending => "admin-badge admin-badge-emphasis",
        CommentStatus.Approved => "admin-badge admin-badge-success",
        CommentStatus.Rejected => "admin-badge admin-badge-danger",
        _ => "admin-badge admin-badge-muted"
    };

    var filterTargetType = filter.TargetType.HasValue ? ((int)filter.TargetType.Value).ToString() : "";
    var filterStatus = filter.Status.HasValue ? ((int)filter.Status.Value).ToString() : "";
}

<div class="admin-toolbar">
    <a class="btn btn-secondary" asp-controller="CommentImport" asp-action="Index">
        <i class="fas fa-file-import" aria-hidden="true"></i>
        <span>@Localizer["ImportComments"]</span>
    </a>
    <form asp-action="ApproveAll" method="post" class="admin-inline-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-secondary">
            <i class="fas fa-check-double" aria-hidden="true"></i>
            <span>@Localizer["ApproveAllComments"]</span>
        </button>
    </form>
    <a class="btn btn-primary" asp-controller="CommentSettings" asp-action="Index">
        <i class="fas fa-cog" aria-hidden="true"></i>
        <span>@Localizer["CommentSettings"]</span>
    </a>
    <partial name="_FilterPanel" />
</div>

<nav class="admin-submission-status-nav" aria-label="@Localizer["Status"]">
    @foreach (var tab in statusTabs)
    {
        var isActive = tab.Status == filter.Status
            || (!tab.Status.HasValue && !filter.Status.HasValue);
        <a class="admin-submission-status-tab@(isActive ? " is-active" : "")"
           asp-action="Index"
           asp-route-targetType="@filter.TargetType"
           asp-route-status="@tab.Status"
           asp-route-q="@filter.Search"
           asp-route-from="@filter.FromLocal"
           asp-route-to="@filter.ToLocal"
           asp-route-sort="@filter.Sort"
           aria-current="@(isActive ? "page" : null)">@tab.Label</a>
    }
</nav>

@if (Model.TotalCount == 0)
{
    <div class="admin-empty-state" role="status">
        <p class="admin-empty-message">@(hasFilters ? Localizer["NoSearchResults"] : Localizer["NoComments"])</p>
    </div>
}
else
{
    <form method="post" id="comments-bulk-form" asp-action="BulkDelete" class="admin-comments-inbox">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetType" value="@filterTargetType" />
        <input type="hidden" name="status" value="@filterStatus" />
        <input type="hidden" name="q" value="@filter.Search" />
        <input type="hidden" name="from" value="@filter.FromLocal" />
        <input type="hidden" name="to" value="@filter.ToLocal" />
        <input type="hidden" name="sort" value="@filter.Sort" />

        <div id="bulk-actions"
             class="admin-bulk-bar"
             hidden
             role="region"
             aria-label="@Localizer["BulkActionsTitle"]">
            <div class="admin-bulk-bar-main">
                <div class="admin-bulk-bar-info">
                    <i class="fas fa-check-square" aria-hidden="true"></i>
                    <div>
                        <strong class="admin-bulk-bar-title">@Localizer["BulkActionsTitle"]</strong>
                        <span class="admin-bulk-bar-count" id="bulk-selected-count"></span>
                    </div>
                </div>
                <div class="admin-bulk-bar-actions">
                    <button type="button" class="btn btn-ghost" id="bulk-clear-selection">
                        @Localizer["ClearSelection"]
                    </button>
                    <button type="submit"
                            class="btn btn-text-danger"
                            onclick="return confirm('@Localizer["ConfirmBulkDelete"]');">
                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        <span>@Localizer["BulkDelete"]</span>
                    </button>
                </div>
            </div>
        </div>

        <p class="admin-bulk-hint" id="bulk-hint" data-admin-bulk-hint>
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            <span>@Localizer["BulkActionsHint"]</span>
        </p>

        <div class="admin-table-wrap">
        <table class="admin-table admin-comments-table">
            <thead>
                <tr>
                    <th class="admin-comments-check-col">
                        <label class="admin-comments-select-all">
                            <input type="checkbox" id="select-all" />
                            <span class="visually-hidden">@Localizer["SelectAll"]</span>
                        </label>
                    </th>
                    <th>@Localizer["Target"]</th>
                    <th>@Localizer["AuthorName"]</th>
                    <th>@Localizer["Body"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["PublishedAt"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var showApprove = item.Status != CommentStatus.Approved;
                var showReject = item.Status != CommentStatus.Rejected;
                <tr class="admin-comment-row@(item.Status == CommentStatus.Pending ? " is-pending" : null)" data-comment-id="@item.Id">
                    <td class="admin-comments-check-col">
                        <label class="admin-comments-row-check">
                            <input type="checkbox" name="ids" value="@item.Id" class="row-select" />
                            <span class="visually-hidden">@item.AuthorName</span>
                        </label>
                    </td>
                    <td>
                        <div class="admin-comment-target">
                            <span class="admin-comment-target-type">@TargetTypeLabel(item.TargetType)</span>
                            <span class="admin-comment-target-title">@item.TargetTitle</span>
                        </div>
                    </td>
                    <td>
                        <div class="admin-comment-author">
                            <strong>@item.AuthorName</strong>
                            @if (!string.IsNullOrWhiteSpace(item.AuthorEmail))
                            {
                                <small class="admin-mono" dir="ltr">@item.AuthorEmail</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.AuthorPhone))
                            {
                                <small class="admin-mono" dir="ltr">@item.AuthorPhone</small>
                            }
                        </div>
                    </td>
                    <td>
                        <p class="admin-comment-body" title="@item.Body">
                            @(item.Body.Length > 140 ? item.Body[..140] + "…" : item.Body)
                        </p>
                    </td>
                    <td>
                        <span class="@StatusBadgeClass(item.Status)">@StatusLabel(item.Status)</span>
                    </td>
                    <td><span class="admin-mono" dir="ltr">@item.PublishedAtLocal</span></td>
                    <td class="admin-row-actions">
                        @if (showApprove || showReject)
                        {
                            <div class="admin-comment-moderation" role="group" aria-label="@Localizer["ModerationActions"]">
                                @if (showApprove)
                                {
                                    <button type="submit"
                                            formaction="@Url.Action("Approve")"
                                            name="id"
                                            value="@item.Id"
                                            class="btn btn-approve">
                                        <i class="fas fa-check" aria-hidden="true"></i>
                                        <span>@Localizer["Approve"]</span>
                                    </button>
                                }
                                @if (showReject)
                                {
                                    <button type="submit"
                                            formaction="@Url.Action("Reject")"
                                            name="id"
                                            value="@item.Id"
                                            class="btn btn-reject">
                                        <i class="fas fa-times" aria-hidden="true"></i>
                                        <span>@Localizer["Reject"]</span>
                                    </button>
                                }
                            </div>
                        }
                        <a class="btn btn-ghost btn-table" asp-action="Edit" asp-route-id="@item.Id">
                            <i class="fas fa-pen" aria-hidden="true"></i>
                            <span>@Localizer["Edit"]</span>
                        </a>
                        <button type="submit"
                                formaction="@Url.Action("Delete")"
                                name="id"
                                value="@item.Id"
                                class="btn btn-ghost btn-table btn-text-danger"
                                onclick="return confirm('@Localizer["ConfirmDelete"]');">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                            <span>@Localizer["Delete"]</span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </form>
    <partial name="_Pager" />
}

@section Scripts {
    <partial name="_JalaliDatePickerScripts" />
    @if (Model.TotalCount > 0)
    {
        <script>
            (() => {
                const selectAll = document.getElementById('select-all');
                const bulk = document.getElementById('bulk-actions');
                const hint = document.getElementById('bulk-hint');
                const countEl = document.getElementById('bulk-selected-count');
                const clearBtn = document.getElementById('bulk-clear-selection');
                const label = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SelectedCount"].Value));
                const sync = () => {
                    const rows = document.querySelectorAll('.row-select');
                    const selected = document.querySelectorAll('.row-select:checked');
                    const n = selected.length;
                    const hasSelection = n > 0;
                    if (bulk) bulk.hidden = !hasSelection;
                    if (hint) hint.hidden = hasSelection;
                    if (countEl) countEl.textContent = hasSelection ? label.replace('{0}', String(n)) : '';
                    if (selectAll) {
                        selectAll.checked = rows.length > 0 && n === rows.length;
                        selectAll.indeterminate = n > 0 && n < rows.length;
                    }
                    rows.forEach((cb) => {
                        cb.closest('.admin-comment-row')?.classList.toggle('is-selected', cb.checked);
                    });
                };
                selectAll?.addEventListener('change', (e) => {
                    document.querySelectorAll('.row-select').forEach((cb) => { cb.checked = e.target.checked; });
                    sync();
                });
                document.querySelectorAll('.row-select').forEach((cb) => cb.addEventListener('change', sync));
                clearBtn?.addEventListener('click', () => {
                    document.querySelectorAll('.row-select').forEach((cb) => { cb.checked = false; });
                    if (selectAll) {
                        selectAll.checked = false;
                        selectAll.indeterminate = false;
                    }
                    sync();
                });
                sync();
            })();
        </script>
    }
}

@functions {
    string TargetTypeLabel(CommentTargetType type) => type switch
    {
        CommentTargetType.BlogPost => Localizer["BlogComments"].Value,
        CommentTargetType.Event => Localizer["EventComments"].Value,
        CommentTargetType.Product => Localizer["ProductComments"].Value,
        CommentTargetType.ProductCategory => Localizer["ProductCategoryComments"].Value,
        _ => type.ToString()
    };

    string StatusLabel(CommentStatus status) => status switch
    {
        CommentStatus.Pending => Localizer["StatusPending"].Value,
        CommentStatus.Approved => Localizer["StatusApproved"].Value,
        CommentStatus.Rejected => Localizer["StatusRejected"].Value,
        _ => status.ToString()
    };
}
