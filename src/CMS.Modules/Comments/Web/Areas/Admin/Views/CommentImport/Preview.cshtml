@model CommentImportPreviewViewModel
@{
    ViewData["Title"] = Localizer["ImportCommentsPreview"];
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<div class="admin-toolbar">
    <a class="btn btn-secondary" asp-action="Index">
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
        <span>@Localizer["ImportUploadAgain"]</span>
    </a>
</div>

<ul class="admin-stats" style="list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:16px;margin-bottom:24px">
    <li>@string.Format(Localizer["ImportStatTotal"].Value, Model.TotalCount.ToString("N0", fa))</li>
    <li>@string.Format(Localizer["ImportStatReady"].Value, Model.ReadyCount.ToString("N0", fa))</li>
    <li>@string.Format(Localizer["ImportStatDuplicate"].Value, Model.DuplicateCount.ToString("N0", fa))</li>
    <li>@string.Format(Localizer["ImportStatUnmatched"].Value, Model.UnmatchedCount.ToString("N0", fa))</li>
    <li>@string.Format(Localizer["ImportStatAmbiguous"].Value, Model.AmbiguousCount.ToString("N0", fa))</li>
    <li>@string.Format(Localizer["ImportStatInvalid"].Value, Model.InvalidCount.ToString("N0", fa))</li>
</ul>

<form asp-action="Confirm" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PreviewId" value="@Model.PreviewId" />

    <div class="admin-field" style="margin-bottom:16px">
        <label>
            <input type="hidden" name="OnlyNew" value="false" />
            <input type="checkbox" name="OnlyNew" value="true" checked="@(Model.OnlyNew ? "checked" : null)" />
            @Localizer["ImportOnlyNew"]
        </label>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Localizer["ImportColStatus"]</th>
                    <th>@Localizer["ImportColApproval"]</th>
                    <th>@Localizer["AuthorName"]</th>
                    <th>@Localizer["Body"]</th>
                    <th>@Localizer["ImportColPageUrl"]</th>
                    <th>@Localizer["ImportColTarget"]</th>
                    <th>@Localizer["ImportColManualTarget"]</th>
                </tr>
            </thead>
            <tbody>
            @{
                var overrideIndex = 0;
            }
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                var needsManual = row.Disposition is CommentImportRowDisposition.Unmatched or CommentImportRowDisposition.Ambiguous;
                <tr>
                    <td>
                        @DispositionLabel(row.Disposition)
                        @if (!string.IsNullOrWhiteSpace(row.ErrorMessage))
                        {
                            <div class="admin-hint">@row.ErrorMessage</div>
                        }
                    </td>
                    <td>
                        <span class="@ApprovalBadgeClass(row.Status)">@ApprovalLabel(row.Status)</span>
                    </td>
                    <td>@row.AuthorName</td>
                    <td>@row.BodyPreview</td>
                    <td dir="ltr" style="text-align:start">
                        <div>@row.PageUrl</div>
                        @if (!string.IsNullOrWhiteSpace(row.NormalizedPath))
                        {
                            <div class="admin-hint">@row.NormalizedPath</div>
                        }
                    </td>
                    <td>@(row.MatchedTargetTitle ?? "—")</td>
                    <td>
                        @if (needsManual)
                        {
                            <input type="hidden" name="Overrides[@overrideIndex].ExternalId" value="@row.ExternalId" />
                            <select name="Overrides[@overrideIndex].ManualTargetKey" class="admin-select">
                                @foreach (var opt in Model.TargetOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                            overrideIndex++;
                        }
                        else
                        {
                            <span class="admin-hint">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pager" aria-label="@Localizer["ImportPreviewPager"]" style="margin-top:16px">
            <span class="admin-pager-meta">
                @string.Format(
                    Localizer["ImportPreviewPagerMeta"].Value,
                    Model.Page.ToString("N0", fa),
                    Model.TotalPages.ToString("N0", fa),
                    CommentImportPreviewViewModel.PageSize.ToString("N0", fa))
            </span>
            <div class="admin-pager-links">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-secondary" asp-action="Preview" asp-route-id="@Model.PreviewId" asp-route-page="@(Model.Page - 1)">@Localizer["ImportPrevPage"]</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-secondary" asp-action="Preview" asp-route-id="@Model.PreviewId" asp-route-page="@(Model.Page + 1)">@Localizer["ImportNextPage"]</a>
                }
            </div>
        </nav>
    }

    <p class="admin-hint" style="margin-top:16px">@Localizer["ImportConfirmHint"]</p>

    <div class="admin-form-actions" style="margin-top:24px">
        <button type="submit" class="btn btn-primary" @(Model.ReadyCount + Model.UnmatchedCount + Model.AmbiguousCount == 0 ? "disabled" : null)>
            <i class="fas fa-file-import" aria-hidden="true"></i>
            <span>@Localizer["ImportConfirmAction"]</span>
        </button>
        <a class="btn btn-secondary" asp-action="Index">@Localizer["Cancel"]</a>
    </div>
</form>

@functions {
    string DispositionLabel(CommentImportRowDisposition d) => d switch
    {
        CommentImportRowDisposition.Ready => Localizer["ImportDispositionReady"].Value,
        CommentImportRowDisposition.Duplicate => Localizer["ImportDispositionDuplicate"].Value,
        CommentImportRowDisposition.Unmatched => Localizer["ImportDispositionUnmatched"].Value,
        CommentImportRowDisposition.Ambiguous => Localizer["ImportDispositionAmbiguous"].Value,
        CommentImportRowDisposition.Invalid => Localizer["ImportDispositionInvalid"].Value,
        _ => d.ToString()
    };

    string ApprovalLabel(CommentStatus status) => status switch
    {
        CommentStatus.Pending => Localizer["StatusPending"].Value,
        CommentStatus.Approved => Localizer["StatusApproved"].Value,
        CommentStatus.Rejected => Localizer["StatusRejected"].Value,
        _ => status.ToString()
    };

    string ApprovalBadgeClass(CommentStatus status) => status switch
    {
        CommentStatus.Pending => "admin-badge admin-badge-emphasis",
        CommentStatus.Approved => "admin-badge admin-badge-success",
        CommentStatus.Rejected => "admin-badge admin-badge-danger",
        _ => "admin-badge admin-badge-muted"
    };
}
