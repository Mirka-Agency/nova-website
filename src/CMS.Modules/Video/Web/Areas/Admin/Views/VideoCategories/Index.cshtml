@model IReadOnlyList<CategoryListItemViewModel>
@{
    ViewData["Title"] = Localizer["Categories"];
}

<div class="admin-toolbar">
    <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus" aria-hidden="true"></i><span>@Localizer["CreateCategory"]</span></a>
</div>

@if (Model.Count == 0)
{
    <p class="admin-lead">@Localizer["NoCategories"]</p>
}
else
{
    <table class="admin-table">
        <thead>
        <tr>
            <th>@Localizer["Image"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Slug"]</th>
            <th>@Localizer["VideoItemCount"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img class="admin-table-thumb" src="@item.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span>�</span>
                    }
                </td>
                <td>@item.Name</td>
                <td>@item.Slug</td>
                <td>@item.VideoItemCount</td>
                <td class="admin-row-actions">
                    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@item.Id"><i class="fas fa-edit" aria-hidden="true"></i><span>@Localizer["Edit"]</span></a>
                    <form asp-action="Delete" method="post" class="admin-inline-form" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-ghost"><i class="fas fa-trash-alt" aria-hidden="true"></i><span>@Localizer["Delete"]</span></button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" />
}
