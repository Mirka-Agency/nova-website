# Copy to `.env` and fill in real values. Do not commit `.env`.
# ASP.NET Core maps nested config with double underscores (__).
# CMS.Web loads this file at startup when present (does not override host env vars).
#
# Production: prefer host / secret store variables (not a committed file).

# --- PostgreSQL (single shared DB) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mirka_cms;Username=postgres;Password=1234

# --- S3 object storage (all uploads: Blog, Shop, Forms, Media) ---
# Works with AWS S3 and S3-compatible providers (MinIO, Arvan, Liara, etc.).
Storage__S3__AccessKey=YOUR_ACCESS_KEY
Storage__S3__SecretKey=YOUR_SECRET_KEY
Storage__S3__BucketName=mirka-cms
Storage__S3__Region=us-east-1
# Custom endpoint for S3-compatible APIs (leave empty for AWS):
# Storage__S3__ServiceUrl=https://s3.ir-thr-at1.arvanstorage.ir
# Required for Arvan / MinIO / most compatible providers:
# Storage__S3__ForcePathStyle=true
# Public/CDN base used when building object URLs (recommended):
# Storage__S3__PublicBaseUrl=https://your-bucket.s3.ir-thr-at1.arvanstorage.ir
# Object ACL public-read — disable if the bucket rejects ACLs:
# Storage__S3__UsePublicReadAcl=false
Storage__S3__UsePublicReadAcl=true

# --- Initial Admin seed (only creates user if missing; leave Password empty to skip) ---
Seed__Admin__Email=admin@yourdomain.com
# Must meet Identity rules: length >= 8, digit, upper + lower case
Seed__Admin__Password=Admin123!
Seed__Admin__FullName=مدیر سیستم

# --- Optional feature flags (override appsettings) ---
# FeatureManagement__Blog=true
# FeatureManagement__Shop=false
# FeatureManagement__Forms=true
# FeatureManagement__Voices=true

# --- Optional Redis (multi-instance cache + Data Protection keys) ---
# Required in Production / docker-compose. Local Development may leave empty (in-memory).
# Cache__RedisConnectionString=localhost:6379
# Cache__PublicContentSeconds=90

# --- Host hardening (required in Production; must not be *) ---
# AllowedHosts=www.example.com;example.com

# --- OpenTelemetry (optional OTLP collector) ---
# OpenTelemetry__ServiceName=CMS.Web
# OpenTelemetry__OtlpEndpoint=http://localhost:4317

# --- Database migrate on boot (required on CapRover; disable only for migrate-as-job deploys) ---
Database__MigrateOnStartup=true

# --- Security ---
# Pepper for OTP hashing (set a long random secret in Production)
Security__OtpPepper=
# Optional shared secret for GET /health/ready (header X-Health-Token). Empty = anonymous (dev).
HealthChecks__ReadyToken=

# --- SMS (IPE.SmsIr NuGet: ApiKey + LineNumber) ---
# Provider values: SmsIr (leave empty to disable sending)
Sms__Provider=SmsIr
Sms__SmsIr__ApiKey=YOUR_SMS_IR_API_KEY
# Sender line number from sms.ir panel (digits only)
Sms__SmsIr__LineNumber=30000000000000
# CSV of admin mobiles for order/form SMS alerts
Sms__AdminNotifyPhones=09120000000,09350000000

# --- Email (SMTP) — used for admin alerts, reminders, shop, forms, etc. ---
# Prefer 587 + STARTTLS. If connect fails from the server, try Port=465 and SecureSocketOptions=SslOnConnect.
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__Username=noreply@example.com
Email__Smtp__Password=YOUR_SMTP_PASSWORD
Email__Smtp__From=noreply@example.com
Email__Smtp__FromDisplayName=میرکا CMS
Email__Smtp__EnableSsl=true
# Optional override: None | Auto | SslOnConnect | StartTls | StartTlsWhenAvailable (empty = auto from Port)
# Email__Smtp__SecureSocketOptions=StartTls
# CSV of admin emails for order/form alerts
Email__AdminNotifyEmails=admin@yourdomain.com,ops@yourdomain.com

# --- Shared captcha keys (admin login, forms, comments) ---
# Choose the provider per feature:
#   Admin login: Admin__LoginCaptcha__Provider = none | turnstile | recaptcha | hcaptcha
#   Forms: per form in Admin → Security
#   Comments: Admin → Comments → Settings
# Keys below are shared by every feature. Google reCAPTCHA must be v3 (score), not the v2 checkbox.
# Create a v3 key pair at https://www.google.com/recaptcha/admin
# Captcha__Recaptcha__MinScore is optional (default 0.5, range 0–1).
# If Captcha__* is empty, older Forms__AntiSpam__* / Comments__AntiSpam__* / Admin__LoginCaptcha__* keys are still used.
# Captcha__Turnstile__SiteKey=
# Captcha__Turnstile__SecretKey=
# Local Development may use Google's public test keys; Production must use real v3 keys.
Captcha__Recaptcha__SiteKey=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKnv
Captcha__Recaptcha__SecretKey=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
Captcha__Recaptcha__MinScore=0.5
# Captcha__Hcaptcha__SiteKey=
# Captcha__Hcaptcha__SecretKey=

# --- Admin login captcha provider (keys are the shared Captcha__* values above) ---
# Local Development: prefer "none" (Google reCAPTCHA scripts are often unreachable).
# Production: recaptcha | turnstile | hcaptcha with real Captcha__* keys.
Admin__LoginCaptcha__Provider=none

# --- WhatsApp (internal Node microservice + CMS gateway) ---
# Shared secret between CMS.Web and services/whatsapp-service (X-Api-Key).
# Generate a long random value; never commit the real key.
WHATSAPP_API_KEY=change-me-whatsapp-api-key
# Local (CMS running on host, WhatsApp container exposing 3100):
WhatsApp__ServiceBaseUrl=http://localhost:3100
# Docker Compose sets WhatsApp__ServiceBaseUrl=http://whatsapp:3100 automatically.
WhatsApp__ApiKey=change-me-whatsapp-api-key
WhatsApp__TimeoutSeconds=45
# Optional WhatsApp service overrides:
# WHATSAPP_CLIENT_ID=cms-whatsapp
# WHATSAPP_AUTH_PATH=/data/wwebjs_auth

# --- Timezone (Iran) ---
# Process local time for container logs / DateTime.Local. Database timestamps stay UTC (timestamptz).
# CapRover: baked into the Docker image (ENV TZ); you can also set TZ=Asia/Tehran in App Configs.
TZ=Asia/Tehran

# --- ASP.NET Core ---
# ASPNETCORE_ENVIRONMENT=Production

# Note: CMS.Web loads this file automatically at startup when present (does not override
# variables already set by the host / Docker / shell).
# Health probes: GET /health/live  and  GET /health/ready (protect ready with HealthChecks__ReadyToken)