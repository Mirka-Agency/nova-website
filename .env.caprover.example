# Copy to `.env.caprover` and fill in real values. Do not commit `.env.caprover`.
# Used only by scripts/deploy-caprover.ps1 (not loaded by CMS.Web).
#
# Dashboard: Apps → your app → Deployment → Enable App Token.
# Prefer CAPROVER_APP_TOKEN over CAPROVER_PASSWORD.
#
# App Configs (CapRover dashboard → App Configs → Environmental Variables):
#   TZ=Asia/Tehran
#   (also baked into the Docker image via Dockerfile ENV TZ)

CAPROVER_URL=https://captain.example.com
CAPROVER_APP=mirka-cms
CAPROVER_APP_TOKEN=

# Alternative to app token (dashboard password). Leave empty when using a token.
# CAPROVER_PASSWORD=

# Optional saved CapRover machine name (caprover login).
# CAPROVER_NAME=
