{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mirka_cms;Username=postgres;Password=CHANGE_ME"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/cms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "CMS.Web"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Database": {
    "MigrateOnStartup": true
  },
  "OpenTelemetry": {
    "ServiceName": "CMS.Web",
    "OtlpEndpoint": ""
  },
  "FeatureManagement": {
    "Blog": true,
    "News": true,
    "Services": true,
    "Video": true,
    "Team": true,
    "Honors": true,
    "Shop": false,
    "Forms": true,
    "Comments": true,
    "Popup": true,
    "Seo": true
  },
  "Admin": {
    "LoginCaptcha": {
      "Provider": "recaptcha",
      "Turnstile": { "SiteKey": "", "SecretKey": "" },
      "Recaptcha": { "SiteKey": "", "SecretKey": "" },
      "Hcaptcha": { "SiteKey": "", "SecretKey": "" }
    }
  },
  "Comments": {
    "AntiSpam": {
      "Turnstile": { "SiteKey": "", "SecretKey": "" },
      "Recaptcha": { "SiteKey": "", "SecretKey": "" },
      "Hcaptcha": { "SiteKey": "", "SecretKey": "" }
    }
  },
  "Captcha": {
    "Turnstile": { "SiteKey": "", "SecretKey": "" },
    "Recaptcha": { "SiteKey": "", "SecretKey": "", "MinScore": 0.5 },
    "Hcaptcha": { "SiteKey": "", "SecretKey": "" }
  },
  "Cache": {
    "RedisConnectionString": ""
  },
  "Storage": {
    "S3": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "",
      "Region": "us-east-1",
      "ServiceUrl": "",
      "PublicBaseUrl": "",
      "ForcePathStyle": false,
      "UsePublicReadAcl": true
    }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "From": "",
      "FromDisplayName": "میرکا CMS",
      "EnableSsl": true
    }
  },
  "Sms": {
    "Provider": "",
    "SmsIr": {
      "ApiKey": "",
      "LineNumber": 0
    }
  }
}
